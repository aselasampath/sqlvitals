<Page x:Class="SqlPulse.Desktop.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}" Title="Overview">
    <Page.Resources>
        <!-- Progress bar template using Foreground for the fill colour -->
        <Style x:Key="UtilBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="20" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#1A1A2E" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <!-- ── Title + health badge ──────────────────────────────── -->
            <DockPanel Margin="0,0,0,18">
                <TextBlock Text="Server Overview" Style="{StaticResource SectionHeader}"
                           FontSize="20" VerticalAlignment="Center" />
                <Border x:Name="BadgeBorder" CornerRadius="4" Padding="12,4"
                        Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHealthBadge" FontSize="11" FontWeight="Bold"
                               Foreground="White" />
                </Border>
            </DockPanel>

            <!-- ── KPI card grid ──────────────────────────────────────── -->
            <WrapPanel x:Name="KpiGrid" Margin="0,0,0,20" />

            <!-- ── CPU + Memory utilization panels ───────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── CPU Panel ───────────────────────────────────── -->
                <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="CPU" Foreground="#F1F5F9" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,0,0,14" />
                        <!-- Avg CPU -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Avg CPU" Foreground="#94A3B8"
                                       FontSize="12" VerticalAlignment="Center" />
                            <ProgressBar x:Name="PbAvgCpu" Grid.Column="1" Style="{StaticResource UtilBar}"
                                         Foreground="#22C55E" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtAvgCpu" Grid.Column="2" Text="--"
                                       Foreground="#F1F5F9" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <!-- P95 CPU -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P95 CPU" Foreground="#94A3B8"
                                       FontSize="12" VerticalAlignment="Center" />
                            <ProgressBar x:Name="PbP95Cpu" Grid.Column="1" Style="{StaticResource UtilBar}"
                                         Foreground="#22C55E" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtP95Cpu" Grid.Column="2" Text="--"
                                       Foreground="#F1F5F9" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <!-- Max CPU -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max CPU" Foreground="#94A3B8"
                                       FontSize="12" VerticalAlignment="Center" />
                            <ProgressBar x:Name="PbMaxCpu" Grid.Column="1" Style="{StaticResource UtilBar}"
                                         Foreground="#22C55E" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtMaxCpu" Grid.Column="2" Text="--"
                                       Foreground="#F1F5F9" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TxtCpuInfo" Foreground="#475569" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- ── Memory Panel ─────────────────────────────────── -->
                <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Memory" Foreground="#F1F5F9" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,0,0,14" />
                        <!-- Stolen Mem % -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stolen Mem %" Foreground="#94A3B8"
                                       FontSize="12" VerticalAlignment="Center" />
                            <ProgressBar x:Name="PbStolen" Grid.Column="1" Style="{StaticResource UtilBar}"
                                         Foreground="#22C55E" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtStolen" Grid.Column="2" Text="--"
                                       Foreground="#F1F5F9" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <!-- Buffer Pool % -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Buffer Pool %" Foreground="#94A3B8"
                                       FontSize="12" VerticalAlignment="Center" />
                            <ProgressBar x:Name="PbBuffer" Grid.Column="1" Style="{StaticResource UtilBar}"
                                         Foreground="#22C55E" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtBuffer" Grid.Column="2" Text="--"
                                       Foreground="#F1F5F9" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <!-- Memory KPI row -->
                        <WrapPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Physical" Foreground="#475569" FontSize="10" />
                                <TextBlock x:Name="TxtMemPhysical" Foreground="#CBD5E1"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Target" Foreground="#475569" FontSize="10" />
                                <TextBlock x:Name="TxtMemTarget" Foreground="#CBD5E1"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Total" Foreground="#475569" FontSize="10" />
                                <TextBlock x:Name="TxtMemTotal" Foreground="#38BDF8"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Buffer Pool" Foreground="#475569" FontSize="10" />
                                <TextBlock x:Name="TxtMemBuffer" Foreground="#34D399"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

