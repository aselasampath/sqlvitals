<Page x:Class="SqlPulse.Desktop.Pages.MemoryGrantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="{StaticResource BgDeep}" Title="Memory"
      Unloaded="Page_Unloaded">
    <Page.Resources>
        <!-- Tab-button RadioButton style -->
        <Style x:Key="MemTab" TargetType="RadioButton">
            <Setter Property="Background"   Value="{StaticResource BgSidebar}" />
            <Setter Property="Foreground"   Value="{StaticResource TextMuted}" />
            <Setter Property="BorderBrush"  Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"      Value="14,5" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Margin"       Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#337C3AED" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLight}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Row 0: KPI strip -->
            <RowDefinition Height="Auto" />   <!-- Row 1: Tab strip + toolbar -->
            <RowDefinition Height="*" />      <!-- Row 2: Content panels -->
        </Grid.RowDefinitions>

        <!-- ─── Row 0: KPI Strip ──────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" Padding="18,10"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Physical Memory" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiPhysical" Text="--" Foreground="{StaticResource TextPrimary}"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="SQL Server Memory" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiTotal" Text="--" Foreground="#38BDF8"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Target Memory" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiTarget" Text="--" Foreground="#60A5FA"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Buffer Pool" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiBuffer" Text="--" Foreground="#34D399"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Plan Cache" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiPlanCache" Text="--" Foreground="#A78BFA"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Available Physical" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiAvailPhys" Text="--" Foreground="{StaticResource TextPrimary}"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Total Page File" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiPageFile" Text="--" Foreground="{StaticResource TextPrimary}"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Available Page File" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiAvailPage" Text="--" Foreground="{StaticResource TextPrimary}"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="System Memory State" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiMemState" Text="--" Foreground="#34D399"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Memory Model" Foreground="{StaticResource TextMuted}" FontSize="10" />
                    <TextBlock x:Name="KpiMemModel" Text="--" Foreground="{StaticResource TextPrimary}"
                               FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ─── Row 1: Tab strip + (Overview) toolbar ─────────────── -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" Padding="12,7"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">

                <!-- Sub-tabs on the left -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="TabOverview" GroupName="MemTabs" IsChecked="True"
                                 Content="Overview" Style="{StaticResource MemTab}"
                                 Checked="Tab_Checked" Tag="Overview" />
                    <RadioButton x:Name="TabClerks"   GroupName="MemTabs"
                                 Content="Memory Clerks" Style="{StaticResource MemTab}"
                                 Checked="Tab_Checked" Tag="Clerks" />
                    <RadioButton x:Name="TabGrants"   GroupName="MemTabs"
                                 Content="Memory Grants" Style="{StaticResource MemTab}"
                                 Checked="Tab_Checked" Tag="Grants" />
                </StackPanel>

                <!-- Toolbar on right — visible for Overview tab only -->
                <StackPanel x:Name="OverviewToolbar" DockPanel.Dock="Right"
                            Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="Interval:" Foreground="{StaticResource TextMuted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbInterval" Width="75" Height="26" FontSize="11"
                              Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                              BorderBrush="{StaticResource Border}" VerticalContentAlignment="Center"
                              Margin="0,0,10,0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="5s" />
                        <ComboBoxItem Content="10s" IsSelected="True" />
                        <ComboBoxItem Content="30s" />
                        <ComboBoxItem Content="60s" />
                    </ComboBox>

                    <ToggleButton x:Name="BtnAutoRefresh"
                                  Content="▶  Start" Width="78" Height="26" FontSize="11"
                                  Background="#1A93C5FD" Foreground="#93C5FD"
                                  BorderBrush="#93C5FD" BorderThickness="1"
                                  Checked="BtnAutoRefresh_Checked"
                                  Unchecked="BtnAutoRefresh_Unchecked"
                                  Margin="0,0,8,0" />

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="4" Padding="10,3" Height="26">
                        <TextBlock x:Name="TxtCountdown" Text="--"
                                   Foreground="{StaticResource Accent}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ─── Row 2: Content panels ─────────────────────────────── -->
        <Grid Grid.Row="2">

            <!-- ── Overview: rolling trend chart ── -->
            <Grid x:Name="PanelOverview">
                <lvc:CartesianChart x:Name="MemChart"
                                    Background="Transparent"
                                    TooltipPosition="Top"
                                    LegendPosition="Bottom" />
                <TextBlock x:Name="TxtNoData"
                           Text="Press ▶ Start to begin memory trending"
                           Foreground="{StaticResource TextMuted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Visible" />
            </Grid>

            <!-- ── Memory Clerks ── -->
            <Grid x:Name="PanelClerks" Visibility="Collapsed" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource KpiCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Top Memory Clerks (MB)" Style="{StaticResource SectionHeader}" />
                        <lvc:CartesianChart x:Name="ClerksChart" Height="140"
                                            TooltipPosition="Top" LegendPosition="Hidden" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource KpiCard}">
                    <DataGrid x:Name="ClerksGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Clerk Type"   Binding="{Binding ClerkType}"                              Width="160" />
                            <DataGridTextColumn Header="Clerk Name"   Binding="{Binding ClerkName}"                              Width="200" />
                            <DataGridTextColumn Header="Total (MB)"   Binding="{Binding TotalPagesMB, StringFormat=N0}"          Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total (KB)"   Binding="{Binding TotalPagesKB, StringFormat=N0}"          Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="% of Total"   Binding="{Binding PctOfTotalMemory, StringFormat=N1}"      Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Memory Grants ── -->
            <Border x:Name="PanelGrants" Visibility="Collapsed" Margin="16">
                <Border Style="{StaticResource KpiCard}">
                    <DataGrid x:Name="GrantsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Session ID"   Binding="{Binding SessionId}"                               Width="80" />
                            <DataGridTextColumn Header="Login"        Binding="{Binding LoginName}"                               Width="120" />
                            <DataGridTextColumn Header="Database"     Binding="{Binding DatabaseName}"                            Width="100" />
                            <DataGridTextColumn Header="Requested KB" Binding="{Binding RequestedMemoryKB, StringFormat=N0}"      Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Granted KB"   Binding="{Binding GrantedMemoryKB, StringFormat=N0}"        Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Used KB"      Binding="{Binding UsedMemoryKB, StringFormat=N0}"           Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Used %"       Binding="{Binding MemGrantUsedPct, StringFormat=N1}"        Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Wait ms"      Binding="{Binding WaitForGrantMs, StringFormat=N0}"         Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Pending"      Binding="{Binding IsPending}"                               Width="65" />
                            <DataGridTextColumn Header="Severity"     Binding="{Binding Severity}"                                Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Page>
