<Page x:Class="SqlPulse.Desktop.Pages.ResourceQueriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}" Title="Resource-Intensive Queries">
    <Page.Resources>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TypeBadge" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="Resource-Intensive Queries" Style="{StaticResource SectionHeader}"
                       FontSize="20" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Row Limit:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="Segoe UI" FontSize="13" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbTopN" Width="80" Height="30"
                          Background="{StaticResource BgCard}"
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}"
                          SelectionChanged="CmbTopN_SelectionChanged">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20" IsSelected="True"/>
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                    <ComboBoxItem Content="200"/>
                </ComboBox>
            </StackPanel>

            <TabControl Background="{StaticResource BgDeep}"
                        BorderBrush="{StaticResource Border}"
                        Foreground="{StaticResource TextPrimary}">

                <!-- Tab 1: By Logical Reads -->
                <TabItem Header="By Logical Reads">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="&#x2398; Copy All" DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshButton}" Padding="10,5"
                                        Click="CopyReads_Click"/>
                                <TextBlock Text="Queries sorted by total logical reads (most I/O-intensive)"
                                           Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="ReadsGrid" MaxHeight="520" CanUserAddRows="False"
                                      RowHeight="35"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"  Width="100" ElementStyle="{StaticResource SingleLineText}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Database the query was compiled against (DB_NAME from sql_handle)."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Object"      Binding="{Binding ObjectName}"    Width="140" ElementStyle="{StaticResource SingleLineText}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Stored procedure or object name, if the query belongs to one. Blank = ad-hoc query."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Type"        Binding="{Binding ObjectType}"    Width="90"  ElementStyle="{StaticResource TypeBadge}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Object type: Stored Proc, Scalar Func, Table Func, Inline Func, View, Trigger, or Ad-Hoc."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions"  Binding="{Binding ExecutionCount, StringFormat=N0}"          Width="90">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of times this plan was executed since it entered cache."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}"        Width="110">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Total logical reads (buffer pool page hits) across all executions."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg Reads"   Binding="{Binding AvgLogicalReads, StringFormat=N0}"          Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average logical reads per execution."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total CPU µs" Binding="{Binding TotalCPUTime, StringFormat=N0}"            Width="110">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Total CPU time in microseconds across all executions."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg CPU µs"  Binding="{Binding AvgCPUTime, StringFormat=N0}"              Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average CPU time per execution in microseconds."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg Elapsed µs" Binding="{Binding AvgElapsedTime, StringFormat=N0}"       Width="120">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average wall-clock time per execution in microseconds."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Last Exec"   Binding="{Binding LastExecutionTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="When this query last ran."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Plan" Width="90" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View Plan" Tag="{Binding}"
                                                        Click="ViewPlan_Click"
                                                        Style="{StaticResource RefreshButton}"
                                                        Padding="6,3" FontSize="11" Margin="2,1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Query Text"  Binding="{Binding QueryText}"    Width="*" ElementStyle="{StaticResource SingleLineText}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Extracted statement text using statement offset."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Tab 2: By CPU -->
                <TabItem Header="By CPU">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="&#x2398; Copy All" DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshButton}" Padding="10,5"
                                        Click="CopyCpu_Click"/>
                                <TextBlock Text="Queries sorted by total CPU time (most processor-intensive)"
                                           Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="CpuGrid" MaxHeight="520" CanUserAddRows="False"
                                      RowHeight="35"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"  Width="100" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Object"      Binding="{Binding ObjectName}"    Width="140" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Type"        Binding="{Binding ObjectType}"    Width="90"  ElementStyle="{StaticResource TypeBadge}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Object type: Stored Proc, Scalar Func, Table Func, Inline Func, View, Trigger, or Ad-Hoc."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions"  Binding="{Binding ExecutionCount, StringFormat=N0}"          Width="90"/>
                                    <DataGridTextColumn Header="Total CPU µs" Binding="{Binding TotalCPUTime, StringFormat=N0}"            Width="110">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Total CPU microseconds across all executions."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg CPU µs"  Binding="{Binding AvgCPUTime, StringFormat=N0}"              Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average CPU per execution."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}"        Width="110"/>
                                    <DataGridTextColumn Header="Avg Reads"   Binding="{Binding AvgLogicalReads, StringFormat=N0}"          Width="100"/>
                                    <DataGridTextColumn Header="Avg Elapsed µs" Binding="{Binding AvgElapsedTime, StringFormat=N0}"        Width="120"/>
                                    <DataGridTextColumn Header="Last Exec"   Binding="{Binding LastExecutionTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                    <DataGridTemplateColumn Header="Plan" Width="90" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View Plan" Tag="{Binding}"
                                                        Click="ViewPlan_Click"
                                                        Style="{StaticResource RefreshButton}"
                                                        Padding="6,3" FontSize="11" Margin="2,1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Query Text"  Binding="{Binding QueryText}"    Width="*" ElementStyle="{StaticResource SingleLineText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Tab 3: Highest Logical Reads -->
                <TabItem Header="Highest Logical Reads">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="&#x2398; Copy All" DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshButton}" Padding="10,5"
                                        Click="CopyHighestReads_Click"/>
                                <TextBlock Text="Queries sorted by total logical reads"
                                           Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="HighestReadsGrid" MaxHeight="520" CanUserAddRows="False"
                                      RowHeight="35"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"  Width="100" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Object"      Binding="{Binding ObjectName}"    Width="140" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Type"        Binding="{Binding ObjectType}"    Width="90"  ElementStyle="{StaticResource TypeBadge}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Object type: Stored Proc, Scalar Func, Table Func, Inline Func, View, Trigger, or Ad-Hoc."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions"  Binding="{Binding ExecutionCount, StringFormat=N0}"          Width="90"/>
                                    <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}"        Width="110"/>
                                    <DataGridTextColumn Header="Last Reads"  Binding="{Binding LastLogicalReads, StringFormat=N0}"         Width="100"/>
                                    <DataGridTextColumn Header="Avg Reads"   Binding="{Binding AvgLogicalReads, StringFormat=N0}"          Width="100"/>
                                    <DataGridTextColumn Header="Total CPU µs" Binding="{Binding TotalCPUTime, StringFormat=N0}"            Width="110"/>
                                    <DataGridTextColumn Header="Avg CPU µs"  Binding="{Binding AvgCPUTime, StringFormat=N0}"              Width="100"/>
                                    <DataGridTextColumn Header="Last Exec"   Binding="{Binding LastExecutionTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                    <DataGridTemplateColumn Header="Plan" Width="90" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View Plan" Tag="{Binding}"
                                                        Click="ViewPlan_Click"
                                                        Style="{StaticResource RefreshButton}"
                                                        Padding="6,3" FontSize="11" Margin="2,1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Query Text"  Binding="{Binding QueryText}"    Width="*" ElementStyle="{StaticResource SingleLineText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
