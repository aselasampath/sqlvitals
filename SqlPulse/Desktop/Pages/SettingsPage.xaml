<Page x:Class="SqlPulse.Desktop.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}"
      FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Connection Settings"
                       Style="{StaticResource SectionHeader}"
                       FontSize="20" Margin="0,0,0,4" />
            <TextBlock Text="Configure the SQL Server connection used by all dashboard pages. The connection string is stored encrypted on this machine."
                       Foreground="{StaticResource TextMuted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- Connection String card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="SQL Server Connection String"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <TextBox x:Name="TxtConnectionString"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Padding="10,8"
                             Background="{StaticResource BgDeep}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource TextPrimary}" />

                    <TextBlock Text="Example: Server=myserver.database.windows.net;Database=mydb;User Id=user;Password=pass;"
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Timeout card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Command Timeout (seconds)"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <TextBox x:Name="TxtTimeout"
                             Width="120" HorizontalAlignment="Left"
                             FontFamily="Consolas" FontSize="13"
                             Padding="10,6"
                             Background="{StaticResource BgDeep}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource TextPrimary}" />

                    <TextBlock Text="Default: 30 seconds. Increase for long-running diagnostic queries."
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Appearance card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" VerticalAlignment="Center" Width="80" />
                        <Button x:Name="BtnThemeToggle"
                                Style="{StaticResource RefreshButton}"
                                Padding="16,7"
                                Click="BtnThemeToggle_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="BtnTestConnection"
                        Style="{StaticResource RefreshButton}"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        Padding="18,9"
                        Margin="0,0,12,0"
                        Click="BtnTestConnection_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50C;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSave"
                        Style="{StaticResource RefreshButton}"
                        Padding="18,9"
                        Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Save Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status message -->
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
