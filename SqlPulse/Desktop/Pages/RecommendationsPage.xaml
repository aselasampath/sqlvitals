<Page x:Class="SqlPulse.Desktop.Pages.RecommendationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}" Title="Recommendations">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Recommendations" Style="{StaticResource SectionHeader}" FontSize="20" Margin="0,0,0,14" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RecList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                        Background="#337C3AED" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding SeverityIcon}" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding Description}" FontFamily="Segoe UI"
                                               FontSize="11" Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,3,0,4" />
                                    <TextBlock Text="{Binding Action}" FontFamily="Segoe UI"
                                               FontSize="11" Foreground="{StaticResource AccentLight}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Severity badge -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4"
                                        Margin="12,0,0,0" VerticalAlignment="Top"
                                        Background="#22FFFFFF">
                                    <TextBlock Text="{Binding Severity}" FontFamily="Segoe UI"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentLight}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
