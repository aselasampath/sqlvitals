<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon: the notification-area icon and its Windows notifications. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SqlVitals.Desktop</AssemblyName>
    <RootNamespace>SqlVitals.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Release number: the single source for the app, SqlVitals Setup and CI artifacts. -->
    <Version>0.79.5</Version>
    <!-- The name Windows shows on notifications and in Task Manager. -->
    <AssemblyTitle>SqlVitals</AssemblyTitle>
    <Product>SqlVitals</Product>
    <!-- Exe, taskbar and window icon. Regenerate with Branding/Build-Icon.ps1. -->
    <ApplicationIcon>..\Branding\SqlVitals.ico</ApplicationIcon>
    <!-- NU1701: LiveCharts' SkiaSharp.Views.WPF, OpenTK and OpenTK.GLWpfControl only ship .NET Framework
         builds. They run fine on .NET 10 (the chart render tests draw with them). NoWarn on the package
         reference doesn't reach its dependencies, so it is set for the project. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- WPF code here; keep WinForms types out of every file's scope (Application, MessageBox…). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The notification-area icon, loaded at the small-icon size. -->
  <ItemGroup>
    <Resource Include="..\Branding\SqlVitals.ico" Link="SqlVitals.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlVitals.Desktop.Tests" />
  </ItemGroup>

  <!-- Models, repositories and the rest of the logic -->
  <ItemGroup>
    <ProjectReference Include="..\Engine\SqlVitals.Engine.csproj" />
  </ItemGroup>

  <!-- LiveCharts2 for WPF charts -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <!-- appsettings.json under the saved connection (RepositoryFactory), the service container, and ILogger<T> over the log file. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <!-- The collector service's state, start and stop (#172). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <!-- Defaults the repositories read (RepositoryFactory); copied beside the exe. -->
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
