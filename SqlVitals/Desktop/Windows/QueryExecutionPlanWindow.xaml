<Window x:Class="SqlVitals.Desktop.Windows.QueryExecutionPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
        Title="{Binding Title}"
        Width="1280" Height="820"
        MinWidth="700" MinHeight="450"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="0,10,0,0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="14,7" Margin="0,0,4,0" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Query Execution Plan"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,10"/>

        <!-- Query text preview -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Query" Foreground="{DynamicResource TextMuted}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding QueryText}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="12" TextWrapping="Wrap"
                           MaxHeight="80" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">

            <!-- Graphical plan -->
            <TabItem Header="Graphical">
                <controls:ExecutionPlanView x:Name="PlanView" />
            </TabItem>

            <!-- Plan XML -->
            <TabItem Header="XML">
                <Border Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#22808080" CornerRadius="6,6,0,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Execution Plan XML" Foreground="{DynamicResource TextMuted}"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text=" — plan not available in cache"
                                           Foreground="{DynamicResource Warning}" FontSize="11"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPlanXml}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding XmlText, Mode=OneWay}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimary}"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     Padding="12"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Export diagram as PNG"
                    Style="{StaticResource SecondaryButton}" Padding="14,7"
                    Margin="0,0,8,0" Command="{Binding ExportDiagramCommand}"/>
            <Button Content="Copy XML"
                    Style="{StaticResource RefreshButton}" Padding="14,7"
                    Margin="0,0,8,0" Command="{Binding CopyCommand}"/>
            <Button Content="Save as .sqlplan"
                    Style="{StaticResource SecondaryButton}" Padding="14,7"
                    Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Close" Command="{Binding CloseCommand}"
                    Style="{StaticResource SecondaryButton}" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
