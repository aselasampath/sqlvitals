<Window x:Class="SqlVitals.Desktop.Windows.QueryExecutionPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Query Execution Plan"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400"
        Background="{StaticResource BgDeep}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Query Execution Plan"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,10"/>

        <!-- Query text preview -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Query" Foreground="{StaticResource TextMuted}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="QueryTextPreview"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="12" TextWrapping="Wrap"
                           MaxHeight="80" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Plan XML -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="6,6,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Execution Plan XML" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NoPlanHint" Text=" — plan not available in cache"
                                   Foreground="{StaticResource Warning}" FontSize="11"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="PlanXmlBox"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimary}"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             Padding="12"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="BtnCopy" Content="Copy XML"
                    Style="{StaticResource RefreshButton}" Padding="14,7"
                    Margin="0,0,8,0" Click="BtnCopy_Click"/>
            <Button x:Name="BtnSave" Content="Save as .sqlplan"
                    Style="{StaticResource SecondaryButton}" Padding="14,7"
                    Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Close" Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
