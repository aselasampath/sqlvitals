<Window x:Class="SqlVitals.Desktop.Windows.SqlScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Script"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400"
        Background="{StaticResource BgDeep}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="TxtHeading"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,10"/>

        <!-- Warning banner -->
        <Border Grid.Row="1" Background="#1AFBBF24" BorderBrush="{StaticResource Warning}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="TxtNotice" TextWrapping="Wrap"
                       Foreground="{StaticResource Warning}" FontSize="11" FontWeight="SemiBold"/>
        </Border>

        <!-- Script -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="6">
            <TextBox x:Name="ScriptBox"
                     Background="Transparent"
                     Foreground="{StaticResource TextPrimary}"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="12"
                     BorderThickness="0"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     Padding="12"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Copy Script"
                    Style="{StaticResource RefreshButton}" Padding="14,7"
                    Margin="0,0,8,0" Click="BtnCopy_Click"/>
            <Button Content="Save as .sql"
                    Style="{StaticResource SecondaryButton}" Padding="14,7"
                    Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Close" Click="BtnClose_Click" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
