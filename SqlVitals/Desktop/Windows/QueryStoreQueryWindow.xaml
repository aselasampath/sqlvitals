<Window x:Class="SqlVitals.Desktop.Windows.QueryStoreQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Query details"
        Width="1180" Height="820"
        MinWidth="700" MinHeight="500"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ForcedRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForced}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- Query ID, object and period -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtHeading" Text="Query details" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="TxtSubheading" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- The full statement -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="⧉ Copy" Style="{DynamicResource SecondaryButton}" Padding="10,2"
                            Click="BtnCopyText_Click" ToolTip="Copy the whole statement."/>
                    <TextBlock Text="Query text" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="TxtQueryText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Metric -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="Chart:" Style="{StaticResource Label}"/>
            <ComboBox x:Name="CmbMetric" Width="150" Height="26" FontSize="11" Margin="0,0,16,0"
                      Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource Border}" VerticalContentAlignment="Center"
                      SelectionChanged="CmbMetric_SelectionChanged"
                      ToolTip="Average per execution in each Query Store interval, one line per plan.">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <TextBlock x:Name="TxtStatus" Style="{StaticResource Label}"/>
        </WrapPanel>

        <!-- One line per plan, one point per interval -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="8">
            <Grid>
                <lvc:CartesianChart x:Name="Chart" Background="Transparent" TooltipPosition="Top" LegendPosition="Bottom"/>
                <TextBlock x:Name="TxtNoData" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"
                           Foreground="{DynamicResource TextMuted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="Plans used in the period, and any forced plan" Foreground="{DynamicResource TextMuted}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <DataGrid Grid.Row="5" x:Name="PlansGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" MaxHeight="220" RowStyle="{StaticResource ForcedRow}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Plan ID" Binding="{Binding PlanId}" Width="70" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="First used" Binding="{Binding FirstUsedLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="115"/>
                <DataGridTextColumn Header="Last used" Binding="{Binding LastUsedLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="115"/>
                <DataGridTextColumn Header="Executions" Binding="{Binding Executions, StringFormat=N0}" Width="85" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="Avg duration ms" Binding="{Binding AvgDurationMs, StringFormat=N1}" Width="105" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="Avg CPU ms" Binding="{Binding AvgCpuMs, StringFormat=N1}" Width="85" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="Avg reads" Binding="{Binding AvgReads, StringFormat=N0}" Width="85" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="Failed" Binding="{Binding Failed, StringFormat=N0}" Width="60" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="Forced" Binding="{Binding ForcedText}" Width="60"/>
                <DataGridTextColumn Header="Force failures" Binding="{Binding ForceFailures, StringFormat=N0}" Width="90" ElementStyle="{StaticResource Number}"/>
                <DataGridTextColumn Header="Last force failure" Binding="{Binding LastForceFailureReason}" Width="*" MinWidth="120"/>
                <DataGridTemplateColumn Header="" Width="85" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="View Plan" Tag="{Binding}" Click="ViewPlan_Click" Style="{DynamicResource RefreshButton}"
                                    Padding="8,2" FontSize="11" Margin="2,1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
