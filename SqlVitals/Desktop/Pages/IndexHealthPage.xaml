<Page x:Class="SqlVitals.Desktop.Pages.IndexHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Index Health">
    <Page.Resources>
        <!-- The fragmentation's status: red when it couldn't be read, or the criteria can't be used. -->
        <Style x:Key="FragmentationStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FragmentationFailed}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnlineRebuild" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanRebuildOnline}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <!-- The page template (#150): the verdict on the missing and unused indexes first, then the four
         lists on tabs the Navigator keeps. A missing index's CREATE statement is in the drawer. Bound to
         IndexHealthViewModel (#187). -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="Index Health" PageKey="IndexHealth">
        <TabControl x:Name="Tabs" Background="{StaticResource BgDeep}" SelectedIndex="{Binding TabIndex}"
                    BorderBrush="{StaticResource Border}"
                    Foreground="{StaticResource TextPrimary}">

            <!-- Missing Indexes tab -->
            <TabItem x:Name="TabMissing" Header="Missing Indexes">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <Button x:Name="BtnCreateScript" DockPanel.Dock="Right" Content="{Binding MissingScope.ButtonText}"
                                    Style="{DynamicResource RefreshButton}" Padding="12,4" VerticalAlignment="Center"
                                    IsEnabled="{Binding MissingScope.HasRows}" Command="{Binding CreateScriptCommand}"
                                    CommandParameter="{Binding Items, ElementName=MissingGrid}"
                                    ToolTip="Generate a T-SQL script that creates the selected missing indexes (or every row shown if none are selected). The script is shown for review — nothing is executed." />
                            <controls:GridFilterBox x:Name="MissingFilter" DockPanel.Dock="Right" Margin="0,0,10,0"
                                                    Target="{Binding ElementName=MissingGrid}" />
                            <TextBlock Text="Recommended Missing Indexes" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="MissingGrid" ItemsSource="{Binding Missing}" SelectedItem="{Binding SelectedMissing}"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  ClipboardCopyMode="IncludeHeader" SelectionMode="Extended" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database"       Binding="{Binding DatabaseName}"                  Width="100" />
                                <DataGridTextColumn Header="Schema"         Binding="{Binding SchemaName}"                    Width="80" />
                                <DataGridTextColumn Header="Table"          Binding="{Binding TableName}"                     Width="140" />
                                <DataGridTextColumn Header="Impact Score"   Binding="{Binding ImpactScore, StringFormat=N1}"  Width="100">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="SQL Server's estimated performance improvement if this index were created: avg_total_user_cost × avg_user_impact × (user_seeks + user_scans). Higher = more beneficial. Treat as relative ranking, not an absolute guarantee."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Seeks"          Binding="{Binding UserSeeks, StringFormat=N0}"    Width="80">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of times the optimizer would have used this index for a seek operation since the last server restart. High seeks = the workload is actively calling for this index."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Scans"          Binding="{Binding UserScans, StringFormat=N0}"    Width="80">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of times the optimizer would have used this index for a scan. High scans with low seeks may indicate the suggested index would only partially satisfy predicates."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Equality Cols"  Binding="{Binding EqualityColumns}"               Width="150">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Columns that appear in equality predicates (WHERE col = value). These become the leading key columns in the suggested index."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Include Cols"   Binding="{Binding IncludedColumns}"               Width="150">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Columns suggested as INCLUDE columns to make the index covering — i.e., all columns needed by the SELECT are in the index, eliminating key lookups."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Severity"       Binding="{Binding Severity}"                      Width="80">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Derived priority: Critical = Impact Score > 100,000; Warning = > 10,000; Info = lower impact. Focus on Critical first."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="CREATE Statement" Binding="{Binding CreateIndexStatement}"        Width="*">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Ready-to-run CREATE INDEX statement generated from the DMV data. Review before executing: validate column order, consider existing indexes, and test on a non-production environment first."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Unused Indexes tab -->
            <TabItem x:Name="TabUnused" Header="Unused Indexes">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <Button x:Name="BtnDropScript" DockPanel.Dock="Right" Content="{Binding UnusedScope.ButtonText}"
                                    Style="{DynamicResource RefreshButton}" Padding="12,4" VerticalAlignment="Center"
                                    IsEnabled="{Binding UnusedScope.HasRows}" Command="{Binding DropScriptCommand}"
                                    CommandParameter="{Binding Items, ElementName=UnusedGrid}"
                                    ToolTip="Generate a T-SQL script that drops the selected unused indexes (or every row shown if none are selected). The script is shown for review — nothing is executed." />
                            <controls:GridFilterBox x:Name="UnusedFilter" DockPanel.Dock="Right" Margin="0,0,10,0"
                                                    Target="{Binding ElementName=UnusedGrid}" />
                            <TextBlock Text="Unused Indexes (zero reads since last restart)" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="UnusedGrid" ItemsSource="{Binding Unused}" SelectedItem="{Binding SelectedUnused}"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  ClipboardCopyMode="IncludeHeader" SelectionMode="Extended" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database"       Binding="{Binding DatabaseName}"                  Width="100" />
                                <DataGridTextColumn Header="Schema"         Binding="{Binding SchemaName}"                    Width="80" />
                                <DataGridTextColumn Header="Table"          Binding="{Binding TableName}"                     Width="140" />
                                <DataGridTextColumn Header="Index Name"     Binding="{Binding IndexName}"                     Width="200" />
                                <DataGridTextColumn Header="Index Type"     Binding="{Binding IndexType}"                     Width="100" />
                                <DataGridTextColumn Header="User Seeks"     Binding="{Binding UserSeeks, StringFormat=N0}"    Width="90">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of seek operations on this index since the last SQL Server restart. Zero seeks + zero scans = the index has never been used for reads — pure maintenance overhead."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="User Scans"     Binding="{Binding UserScans, StringFormat=N0}"    Width="90">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of full or range scan operations on this index since the last restart. Combined with User Seeks, represents total read usage. Zero scans = index is not contributing to any queries."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="User Lookups"   Binding="{Binding UserLookups, StringFormat=N0}"  Width="100">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Key lookups back to the clustered index triggered by this nonclustered index. High lookups mean the index is used but not covering — consider adding INCLUDE columns to eliminate lookups."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="User Updates"   Binding="{Binding UserUpdates, StringFormat=N0}"  Width="100">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of INSERT/UPDATE/DELETE operations that had to maintain this index. High updates with zero reads = pure write overhead with no read benefit. Strong DROP candidate after confirming no off-hours usage."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Index Usage tab -->
            <TabItem x:Name="TabUsage" Header="Index Usage">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <controls:GridFilterBox DockPanel.Dock="Right"
                                                    Target="{Binding ElementName=UsageGrid}" />
                            <TextBlock Text="Index reads, writes and health assessment since last SQL Server restart"
                                       Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="UsageGrid" ItemsSource="{Binding Usage}" SelectedItem="{Binding SelectedUsage}" CanUserAddRows="False"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  RowBackground="{StaticResource BgDeep}"
                                  AlternatingRowBackground="{StaticResource BgSidebar}"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource Border}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database"   Binding="{Binding DatabaseName}"                Width="100">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Database the index belongs to."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Table"      Binding="{Binding TableName}"                   Width="160">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Table the index is on."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Index Name" Binding="{Binding IndexName}"                   Width="200">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Name of the index. NULL = heap or unknown."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type"       Binding="{Binding IndexType}"                   Width="130">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Index type: CLUSTERED, NONCLUSTERED, XML, etc."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Seeks"      Binding="{Binding UserSeeks, StringFormat=N0}"  Width="90">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Seek operations — efficient point or range lookups using the index key. High seeks = index is well-used for selective queries."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Scans"      Binding="{Binding UserScans, StringFormat=N0}"  Width="90">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Full or range scans. High scans relative to seeks may indicate missing predicates or poorly selective key columns."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Lookups"    Binding="{Binding UserLookups, StringFormat=N0}" Width="90">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Key lookups back to the clustered index. High lookups = the nonclustered index is not covering — add INCLUDE columns to eliminate them."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Updates"    Binding="{Binding UserUpdates, StringFormat=N0}" Width="90">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Write operations (INSERT/UPDATE/DELETE) that maintained this index. High updates with zero reads = pure overhead — strong DROP candidate."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Health"     Binding="{Binding IndexHealth}"                  Width="170">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Health: Healthy = seeks dominate; Mostly Scanned - Review = scans exceed seeks, may not be selective enough; Unused = zero reads, drop candidate."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Last Seek"  Binding="{Binding LastUserSeek, StringFormat='yyyy-MM-dd'}" Width="100"/>
                                <DataGridTextColumn Header="Last Scan"  Binding="{Binding LastUserScan, StringFormat='yyyy-MM-dd'}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Fragmentation tab -->
            <TabItem x:Name="TabFrag" Header="Fragmentation">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Fragmentation Criteria" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <TextBlock Text="Min Page Count:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                            <TextBox x:Name="TxtMinPageCount" Text="{Binding MinPagesText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,15,0" Padding="2" VerticalAlignment="Center" Background="{StaticResource BgDeep}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Border}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding RefreshFragmentationCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Min Frag %:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                            <TextBox x:Name="TxtMinFragPct" Text="{Binding MinFragText, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,15,0" Padding="2" VerticalAlignment="Center" Background="{StaticResource BgDeep}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Border}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding RefreshFragmentationCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button x:Name="BtnRefreshFrag" Content="↻  Refresh" Style="{DynamicResource RefreshButton}"
                                    Padding="12,4" VerticalAlignment="Center" Command="{Binding RefreshFragmentationCommand}"
                                    ToolTip="Apply the criteria above and reload the fragmentation grid (Enter in either box does the same)." />
                        </WrapPanel>

                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Maintenance Script" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <TextBlock Text="Reorganize from:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                            <TextBox x:Name="TxtReorganizePct" Text="{Binding ReorganizeText, UpdateSourceTrigger=PropertyChanged}" Width="40" Padding="2" VerticalAlignment="Center" Background="{StaticResource BgDeep}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Border}"
                                     ToolTip="Indexes at or above this fragmentation are REORGANIZE'd. Anything below it is skipped." />
                            <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="3,0,15,0"/>
                            <TextBlock Text="Rebuild from:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                            <TextBox x:Name="TxtRebuildPct" Text="{Binding RebuildText, UpdateSourceTrigger=PropertyChanged}" Width="40" Padding="2" VerticalAlignment="Center" Background="{StaticResource BgDeep}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Border}"
                                     ToolTip="Indexes at or above this fragmentation are REBUILD'd instead of REORGANIZE'd." />
                            <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="3,0,15,0"/>
                            <CheckBox x:Name="ChkOnlineRebuild" Content="ONLINE = ON" VerticalAlignment="Center" Margin="0,0,15,0"
                                      Style="{StaticResource OnlineRebuild}" IsEnabled="{Binding CanRebuildOnline}" IsChecked="{Binding OnlineRebuild}"
                                      ToolTip="{Binding OnlineRebuildToolTip}" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="BtnMaintenanceScript" Content="{Binding FragmentationScope.ButtonText}"
                                    Style="{DynamicResource RefreshButton}" Padding="12,4" VerticalAlignment="Center"
                                    IsEnabled="{Binding FragmentationScope.HasRows}" Command="{Binding MaintenanceScriptCommand}"
                                    CommandParameter="{Binding Items, ElementName=FragGrid}"
                                    ToolTip="Generate a T-SQL ALTER INDEX script for the selected rows (or every row shown if none are selected). The script is shown for review — nothing is executed." />
                        </WrapPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <controls:GridFilterBox x:Name="FragFilter" DockPanel.Dock="Right" Margin="10,0,0,0"
                                                    Target="{Binding ElementName=FragGrid}" />
                            <TextBlock x:Name="TxtFragStatus" Style="{StaticResource FragmentationStatus}" FontSize="11" Text="{Binding FragmentationStatus}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>

                        <DataGrid x:Name="FragGrid" ItemsSource="{Binding Fragmentation}" SelectedItem="{Binding SelectedFragmentation}" CanUserAddRows="False"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  RowBackground="{StaticResource BgDeep}"
                                  AlternatingRowBackground="{StaticResource BgSidebar}"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource Border}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database"      Binding="{Binding DatabaseName}"                                      Width="110">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Database containing the fragmented index."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Schema"        Binding="{Binding SchemaName}"                                        Width="80">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Schema the table belongs to. The maintenance script qualifies every ALTER INDEX with it."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Table"         Binding="{Binding TableName}"                                         Width="160">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Table the fragmented index belongs to."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Index Name"    Binding="{Binding IndexName}"                                         Width="200">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Name of the fragmented index."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type"          Binding="{Binding IndexType}"                                         Width="130">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Index structure type from dm_db_index_physical_stats."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fragmentation %" Binding="{Binding FragmentationPercent, StringFormat=F1}"           Width="130">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="avg_fragmentation_in_percent: logical fragmentation of leaf pages. &lt;10% = OK; 10-30% = Reorganize; &gt;30% = Rebuild. Less critical on SSD than spinning disk."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Pages"         Binding="{Binding PageCount, StringFormat=N0}"                        Width="90">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of 8 KB pages in the index. Indexes below Min Page Count are filtered out — fragmentation is negligible on small indexes."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Page Density %" Binding="{Binding AvgPageSpaceUsed, StringFormat=F1}"                Width="120">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average page fill percentage. Low density means many half-empty pages, increasing storage and I/O. Rebuild with FILLFACTOR to reclaim density."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Records"       Binding="{Binding RecordCount, StringFormat=N0}"                      Width="100">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Approximate row count in the index. Combine with Pages to estimate average row size."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Action"        Binding="{Binding RecommendedAction}"                                 Width="160">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="No Action Needed (&lt;10%); Reorganize (10-30%): online, low-impact; Rebuild (&gt;30%): more thorough but locks table (unless ONLINE=ON)."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

        </TabControl>
    </controls:PageShell>
</Page>
