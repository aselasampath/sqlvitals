<Page x:Class="SqlVitals.Desktop.Pages.ExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}" Title="Export for AI Analysis">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Title -->
            <RowDefinition Height="Auto" />  <!-- Description banner -->
            <RowDefinition Height="*"    />  <!-- Main content (checklist + options) -->
            <RowDefinition Height="Auto" />  <!-- Progress bar -->
            <RowDefinition Height="Auto" />  <!-- Status text -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="📤  Export for AI Analysis"
                       Style="{StaticResource SectionHeader}"
                       FontSize="20" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Description -->
        <Border Grid.Row="1" Background="#1A7C3AED" BorderBrush="#7C3AED" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="#A78BFA" FontFamily="Segoe UI" FontSize="11">
                Select the counter groups you want to include, choose a save path, then click Export.
                The output is a plain UTF-8 text file with labelled sections and tabular data — ready to
                paste into ChatGPT, Copilot, or Claude for instant performance analysis.
            </TextBlock>
        </Border>

        <!-- Two-column layout: checklist left, options right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ── Counter group checklist ─────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Padding="0">
                <DockPanel>
                    <!-- Select all / none toolbar -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Counter Groups" Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnSelectAll" Content="Select All"
                                    Margin="20,0,0,0" Padding="10,4"
                                    Background="#227C3AED" Foreground="{StaticResource AccentLight}"
                                    BorderThickness="1" BorderBrush="#447C3AED"
                                    FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                                    Click="BtnSelectAll_Click" />
                            <Button x:Name="BtnSelectNone" Content="Select None"
                                    Margin="6,0,0,0" Padding="10,4"
                                    Background="Transparent" Foreground="{StaticResource TextMuted}"
                                    BorderThickness="1" BorderBrush="{StaticResource Border}"
                                    FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                                    Click="BtnSelectNone_Click" />
                            <TextBlock x:Name="TxtCheckedCount"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Scrollable list of checkboxes -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6">
                        <ItemsControl x:Name="GroupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="8,5" Padding="8,0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Foreground="{StaticResource TextPrimary}"
                                              FontFamily="Segoe UI" FontSize="12"
                                              Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"
                                              Cursor="Hand">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="Segoe UI" FontSize="12" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Segoe UI" FontSize="10"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Right panel: file path + export ────────────────── -->
            <StackPanel Grid.Column="2">

                <!-- Save path -->
                <Border Style="{StaticResource KpiCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Output File" Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="File Path" Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFilePath"
                                     Grid.Column="0"
                                     Background="#22FFFFFF" Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource Border}" BorderThickness="1"
                                     FontFamily="Segoe UI" FontSize="11" Padding="8,6"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="…" Width="32"
                                    Margin="4,0,0,0" Padding="0"
                                    Background="#227C3AED" Foreground="{StaticResource AccentLight}"
                                    BorderThickness="1" BorderBrush="#447C3AED"
                                    FontFamily="Segoe UI" FontSize="14" Cursor="Hand"
                                    Click="BtnBrowse_Click" />
                        </Grid>

                        <TextBlock Text="Filename" Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,10,0,4" />
                        <TextBox x:Name="TxtFileName"
                                 Background="#22FFFFFF" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource Border}" BorderThickness="1"
                                 FontFamily="Segoe UI" FontSize="11" Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 Text="SqlVitals_Report.txt" />

                        <TextBlock Text="Full path preview:" Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="10" Margin="0,10,0,2" />
                        <TextBlock x:Name="TxtFullPath"
                                   Foreground="{StaticResource AccentLight}"
                                   FontFamily="Segoe UI" FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Export button -->
                <Button x:Name="BtnExport" Content="📤  Export Now"
                        Height="46" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                        Background="{StaticResource Accent}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnExport_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="46" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#9F67F5" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="#443C3AED" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Open file after export -->
                <CheckBox x:Name="ChkOpenAfter" Content="Open file after export"
                          IsChecked="True" Margin="0,10,0,0" Padding="6,0"
                          Foreground="{StaticResource TextMuted}"
                          FontFamily="Segoe UI" FontSize="11" Cursor="Hand" />

                <!-- Last export info -->
                <Border x:Name="PanelLastExport" Visibility="Collapsed"
                        Background="#1A22C55E" BorderBrush="#22C55E" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="✓  Last Export" Foreground="#22C55E"
                                   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock x:Name="TxtLastExport" Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Progress bar -->
        <ProgressBar x:Name="ExportProgress" Grid.Row="3"
                     Height="4" Minimum="0" Maximum="100" Value="0"
                     Foreground="{StaticResource Accent}"
                     Background="{StaticResource Border}"
                     BorderThickness="0" Margin="0,12,0,4"
                     Visibility="Collapsed" />

        <!-- Status text -->
        <TextBlock x:Name="TxtExportStatus" Grid.Row="4"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="Segoe UI" FontSize="11"
                   HorizontalAlignment="Center" />
    </Grid>
</Page>
