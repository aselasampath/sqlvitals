<Page x:Class="SqlVitals.Desktop.Pages.ConfigChecksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Config Checks">
    <Page.Resources>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxHeight" Value="18"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <!-- Warn in amber, Pass in green, Not checked muted. -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warn">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotChecked">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CheckName" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CurrentValue" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warn">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="CheckRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warn">
                    <Setter Property="Background" Value="#1FF59E0B"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#337C3AED"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ToolbarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="150"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Config Checks — server and database settings against best practice" Style="{StaticResource SectionHeader}"
                   FontSize="20" Margin="0,0,0,14"/>

        <!-- Filter, counts, and anything that left checks out -->
        <Border Grid.Row="1" Style="{StaticResource KpiCard}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Show:" Style="{StaticResource ToolbarLabel}"/>
                    <ComboBox x:Name="CmbFilter" Width="200" Style="{StaticResource ToolbarCombo}"
                              SelectionChanged="CmbFilter_SelectionChanged"/>
                    <Button x:Name="BtnReload" Content="↻ Check again" Style="{StaticResource RefreshButton}" Padding="12,4"
                            ToolTip="Read the settings from the server again and check them."
                            Click="BtnReload_Click"/>
                    <Button x:Name="BtnScript" Content="📝 Script the warnings" Style="{StaticResource SecondaryButton}" Padding="12,4"
                            Margin="8,0,0,0" IsEnabled="False"
                            ToolTip="One T-SQL script with the change for every warning, to review and run yourself. SqlVitals never runs it."
                            Click="BtnScript_Click"/>
                </WrapPanel>

                <TextBlock x:Name="TxtSummary" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="TxtProblem" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Every check, warnings first ───────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource KpiCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=ChecksGrid}"/>
                    <TextBlock x:Name="TxtCount" Text="Checks" Style="{StaticResource SectionHeader}"
                               Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="ChecksGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single" RowStyle="{StaticResource CheckRow}"
                              SelectionChanged="ChecksGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="96" SortMemberPath="Status" ElementStyle="{StaticResource StatusText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Warn: not what best practice recommends. Pass: it is. Not checked: a permission is missing, or Azure manages the setting. Sorted with warnings first."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="200" SortMemberPath="Kind" ElementStyle="{StaticResource CheckName}"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="150" ElementStyle="{StaticResource SingleLineText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Server: a setting of the whole server. Otherwise the database it's about; databases that pass are listed together."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="210" ElementStyle="{StaticResource CurrentValue}"/>
                            <DataGridTextColumn Header="Recommended" Binding="{Binding Recommended}" Width="210" ElementStyle="{StaticResource SingleLineText}"/>
                            <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*" MinWidth="220" ElementStyle="{StaticResource Muted}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtNoData" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"
                               Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,40,0,0"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource Border}" Margin="0,4"/>

        <!-- ── The selected check: why, and the fix ───────────────────── -->
        <Border Grid.Row="4" Style="{StaticResource KpiCard}">
            <Grid x:Name="DetailPanel" IsEnabled="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtDetailHeader" Text="Select a check above to see why it matters and how to fix it."
                           Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" x:Name="TxtDetailExplanation" Foreground="{StaticResource TextMuted}" FontSize="12"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                <DockPanel Grid.Row="2" x:Name="FixPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button x:Name="BtnCopyFix" DockPanel.Dock="Right" Content="⧉ Copy" Style="{StaticResource SecondaryButton}"
                                Padding="10,2" ToolTip="Copy this script to the clipboard." Click="BtnCopyFix_Click"/>
                        <TextBlock Text="To fix it: review, then run it yourself. SqlVitals never runs it."
                                   Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="TxtFix" IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource BgDeep}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}" BorderThickness="1"
                             FontFamily="Consolas" FontSize="11" Padding="6"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
