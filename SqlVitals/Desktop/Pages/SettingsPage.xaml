<Page x:Class="SqlVitals.Desktop.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BgDeep}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BgDeep}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Connection Settings"
                       Style="{StaticResource SectionHeader}"
                       FontSize="20" Margin="0,0,0,4" />
            <TextBlock Text="Save connections to each SQL Server environment you monitor, then switch between them from the selector in the sidebar. Connection details are stored encrypted on this machine."
                       Foreground="{StaticResource TextMuted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- Saved connections card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnNewConnection" Style="{StaticResource SecondaryButton}"
                                    Padding="12,5" Margin="0,0,8,0" Click="BtnNewConnection_Click"
                                    Content="+  New connection" />
                            <Button x:Name="BtnRemoveConnection" Style="{StaticResource SecondaryButton}"
                                    Padding="12,5" Click="BtnRemoveConnection_Click"
                                    Content="🗑  Remove" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Saved Connections"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock x:Name="TxtNoConnections"
                               Text="No saved connections yet. Fill in the form below and click Save &amp; Connect to add your first one."
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />

                    <ListBox x:Name="LstConnections"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstConnections_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    Padding="12,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLight}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#337C3AED" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                            Background="{StaticResource Success}" CornerRadius="4" Padding="7,2"
                                            Visibility="{Binding ActiveVisibility}">
                                        <TextBlock Text="● ACTIVE" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Settings.DisplayName}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Settings.Summary}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Connect to Server card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TxtFormTitle" Text="New Connection"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 0 Server -->
                            <RowDefinition Height="Auto" />  <!-- 1 Authentication -->
                            <RowDefinition Height="Auto" />  <!-- 2 User name -->
                            <RowDefinition Height="Auto" />  <!-- 3 Password -->
                            <RowDefinition Height="Auto" />  <!-- 4 Remember password -->
                            <RowDefinition Height="Auto" />  <!-- 5 Database -->
                            <RowDefinition Height="Auto" />  <!-- 6 Encrypt -->
                            <RowDefinition Height="Auto" />  <!-- 7 Trust server cert -->
                            <RowDefinition Height="Auto" />  <!-- 8 Connection name -->
                            <RowDefinition Height="Auto" />  <!-- 9 Monitor in background -->
                            <RowDefinition Height="Auto" />  <!-- 10 Custom health thresholds -->
                            <RowDefinition Height="Auto" />  <!-- 11 This connection's thresholds -->
                        </Grid.RowDefinitions>

                        <!-- Custom health thresholds -->
                        <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,12,0,0">
                            <CheckBox x:Name="ChkCustomThresholds" Content="Use its own health thresholds"
                                      Checked="ChkCustomThresholds_Changed" Unchecked="ChkCustomThresholds_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Grade this connection's health dot on its own thresholds instead of the ones under Health Thresholds below, e.g. for a server that always runs hot." />
                        </StackPanel>
                        <controls:HealthThresholdsEditor x:Name="ConnectionThresholds"
                                                         Grid.Row="11" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                                         Visibility="Collapsed" />

                        <!-- Monitor in background -->
                        <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,12,0,0">
                            <CheckBox x:Name="ChkMonitorInBackground" Content="Monitor in background" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="With Start monitoring automatically on (Monitoring, below), keep collecting live metrics, history and alerts for this connection while another one is active, so switching back shows continuous history and the sidebar can flag problems. Off for a new connection. You can also start it any time with ▶ in the sidebar selector." />
                        </StackPanel>

                        <!-- Connection name -->
                        <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,19,12,0"
                                   Text="Connection name" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,12,0,0">
                            <TextBox x:Name="TxtConnectionName" Style="{StaticResource FieldTextBox}" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Shown in the sidebar connection selector, e.g. Production or UAT. Leave blank to use server / database." />
                        </StackPanel>

                        <!-- Server name -->
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0">
                            <Run Text="Server name" /><Run Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBox x:Name="TxtServer" Style="{StaticResource FieldTextBox}" TextChanged="ConnectionField_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="e.g. myserver.database.windows.net, localhost\SQLEXPRESS, or host,1433 for a custom port" />
                        </StackPanel>

                        <!-- Authentication -->
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,0,12,10">
                            <Run Text="Authentication" /><Run Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <ComboBox x:Name="CmbAuthentication" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                  SelectionChanged="CmbAuthentication_SelectionChanged">
                            <ComboBoxItem Content="SQL Server Authentication" Tag="SqlServer" />
                            <ComboBoxItem Content="Microsoft Entra MFA" Tag="EntraMfa" />
                            <ComboBoxItem Content="Windows Authentication" Tag="Windows" />
                        </ComboBox>

                        <!-- User name -->
                        <TextBlock x:Name="LblUserName" Grid.Row="2" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0">
                            <Run x:Name="RunUserNameText" Text="Login" /><Run x:Name="RunUserNameRequired" Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <StackPanel x:Name="PanelUserName" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <TextBox x:Name="TxtUserName" Style="{StaticResource FieldTextBox}" TextChanged="ConnectionField_Changed" />
                            <TextBlock x:Name="TxtUserNameHint" Style="{StaticResource FieldHint}"
                                       Text="Optional: your Entra account (user@domain.com) to pre-fill the sign-in prompt." />
                        </StackPanel>

                        <!-- Password -->
                        <TextBlock x:Name="LblPassword" Grid.Row="3" Style="{StaticResource FieldLabel}" Margin="0,0,12,10">
                            <Run Text="Password" /><Run Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <PasswordBox x:Name="TxtPassword" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                     PasswordChanged="ConnectionField_Changed" />

                        <!-- Remember password -->
                        <CheckBox x:Name="ChkSavePassword" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12"
                                  Content="Remember password" />

                        <!-- Database -->
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                   Text="Database name" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbDatabase" IsEditable="True"
                                      DropDownOpened="CmbDatabase_DropDownOpened" />
                            <TextBlock x:Name="TxtDatabaseHint" Style="{StaticResource FieldHint}"
                                       Text="Leave blank for the login's default database. Open the list to browse the server." />
                        </StackPanel>

                        <!-- Encrypt -->
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Margin="0,0,12,10" Text="Encrypt" />
                        <ComboBox x:Name="CmbEncrypt" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"
                                  SelectionChanged="ConnectionField_Changed">
                            <ComboBoxItem Content="Mandatory" Tag="Mandatory" />
                            <ComboBoxItem Content="Optional" Tag="Optional" />
                            <ComboBoxItem Content="Strict (SQL Server 2022 and Azure SQL)" Tag="Strict" />
                        </ComboBox>

                        <!-- Trust server certificate -->
                        <CheckBox x:Name="ChkTrustServerCertificate" Grid.Row="7" Grid.Column="1"
                                  Content="Trust server certificate"
                                  Checked="ConnectionField_Changed" Unchecked="ConnectionField_Changed" />
                    </Grid>

                    <!-- Advanced -->
                    <Expander Header="Advanced" Foreground="{StaticResource TextMuted}"
                              FontSize="12" Margin="0,16,0,0">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Margin="0,0,12,10"
                                       Text="Connection timeout (s)" />
                            <TextBox x:Name="TxtConnectTimeout" Style="{StaticResource FieldTextBox}" Grid.Row="0" Grid.Column="1" Width="120"
                                     HorizontalAlignment="Left" Margin="0,0,0,10"
                                     TextChanged="ConnectionField_Changed" />

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                       Text="Additional parameters" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBox x:Name="TxtAdditionalParameters" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                         TextChanged="ConnectionField_Changed" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Extra connection string keywords, e.g. MultipleActiveResultSets=True;HostNameInCertificate=*.contoso.com" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Timeout card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Command Timeout (seconds)"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <TextBox x:Name="TxtTimeout"
                             Width="120" HorizontalAlignment="Left"
                             FontFamily="Consolas" FontSize="13"
                             Padding="10,6"
                             Background="{StaticResource BgDeep}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource TextPrimary}" />

                    <TextBlock Text="Default: 30 seconds. Increase for long-running diagnostic queries."
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Monitoring card (#115) -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Monitoring"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <CheckBox x:Name="ChkStartMonitoringAutomatically"
                              Content="Start monitoring automatically"
                              Click="ChkStartMonitoringAutomatically_Click" />
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Collect live metrics, history and alerts as soon as SqlVitals starts or connects. Off: nothing is collected until you press Start." />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="On, the active connection and those with Monitor in background are monitored from the start. Either way you can start and stop any connection with ▶ / ■ in the sidebar selector, on Live Metrics, or from the SqlVitals icon's menu in the notification area; that lasts until SqlVitals exits. Alerts are only raised for connections being monitored." />
                    <TextBlock x:Name="TxtMonitoringStatus"
                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Monitoring history card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Monitoring History"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                   Text="Snapshot every" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbHistoryInterval" Width="160" HorizontalAlignment="Left"
                                      SelectionChanged="HistorySetting_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="How often waits by type, file I/O, memory and the top queries are read from each monitored server and saved. Shorter intervals show more detail but add load and use more disk. Live Metrics figures are saved at every sample regardless." />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                   Text="Keep history for" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbHistoryRetention" Width="160" HorizontalAlignment="Left"
                                      SelectionChanged="HistorySetting_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Older history is deleted automatically, and the file shrinks as it goes. Changes apply straight away." />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="BtnClearHistory" DockPanel.Dock="Right" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButton}" Padding="12,5"
                                Click="BtnClearHistory_Click"
                                Content="🗑  Clear history" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHistorySize"
                                       Foreground="{StaticResource TextPrimary}" FontSize="12" />
                            <TextBlock x:Name="TxtHistoryPath"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,3,12,0" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="TxtHistoryStatus"
                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Health thresholds card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Health Thresholds"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="When the health dot beside each connection in the sidebar turns amber or red. Leave a box blank to turn that level off. A connection can use its own thresholds instead (Use its own health thresholds, above)."
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,14" />

                    <controls:HealthThresholdsEditor x:Name="GlobalThresholds" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BtnSaveThresholds" Style="{StaticResource SecondaryButton}"
                                Padding="12,5" Margin="0,0,8,0" Click="BtnSaveThresholds_Click"
                                Content="💾  Save thresholds" />
                        <Button x:Name="BtnDefaultThresholds" Style="{StaticResource SecondaryButton}"
                                Padding="12,5" Click="BtnDefaultThresholds_Click"
                                ToolTip="Put the default thresholds back in the boxes. Click Save thresholds to use them."
                                Content="↺  Defaults" />
                    </StackPanel>

                    <TextBlock x:Name="TxtThresholdsStatus"
                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Alerts card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Alerts"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Every sample of a monitored connection is checked against its health thresholds. An indicator that stays past one raises an alert, listed on the Alerts page with when it started and ended and its worst value."
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                   Text="Raise an alert after" />
                        <StackPanel Grid.Column="1" Margin="0,0,0,4">
                            <ComboBox x:Name="CmbAlertSamples" Width="160" HorizontalAlignment="Left"
                                      AutomationProperties.Name="Samples in a row before an alert starts"
                                      SelectionChanged="AlertSetting_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Samples in a row past a threshold before an alert starts. It ends after the same number back to normal, so a value hovering around a threshold raises one alert, not many. Samples follow each connection's Live Metrics interval: at the default 10 seconds, 3 samples is 30 seconds. Changes apply from the next sample." />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,14,12,0"
                                   Text="Windows notifications" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,4">
                            <ItemsControl x:Name="LstNotifyConnections"
                                          AutomationProperties.Name="Connections that raise Windows notifications">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Notifies, Mode=OneWay}"
                                                  ToolTip="{Binding Summary, Mode=OneWay}" Margin="0,0,0,4"
                                                  AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                                                  Click="ChkNotify_Click">
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtNoNotifyConnections" Style="{StaticResource FieldHint}" Margin="0,7,0,0"
                                       Text="No saved connections yet." Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Untick a connection to mute it. A ticked connection raises a Windows notification when one of its alerts starts or turns critical; clicking it opens the Alerts page for that connection. Also in the SqlVitals icon's menu in the notification area (Notifications). Windows' own Do Not Disturb and notification settings still apply." />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtAlertsStatus"
                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="Collapsed" />

                    <!-- Chat channels (#120) -->
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnAddChatChannel" Style="{StaticResource SecondaryButton}"
                                            Padding="12,5" Margin="0,0,8,0" Click="BtnAddChatChannel_Click"
                                            Content="+  Add channel" />
                                    <Button x:Name="BtnSendChatTest" Style="{StaticResource SecondaryButton}"
                                            Padding="12,5" Margin="0,0,8,0" Click="BtnSendChatTest_Click" IsEnabled="False"
                                            ToolTip="Post a test message to the selected channel, as it's saved"
                                            Content="📨  Send test message" />
                                    <Button x:Name="BtnRemoveChatChannel" Style="{StaticResource SecondaryButton}"
                                            Padding="12,5" Click="BtnRemoveChatChannel_Click" IsEnabled="False"
                                            Content="🗑  Remove" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" FontWeight="SemiBold"
                                           Text="Chat channels (Slack and Teams)" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,10"
                                       Text="Post alerts to a Slack or Microsoft Teams channel through its webhook, so the whole team sees them when they start or turn critical. Messages are sent only while SqlVitals is running on this PC, for the connections it's monitoring at the time. Webhook URLs are stored encrypted, like passwords, and never written to the log. Setup steps for Slack and Teams are on the Chat Notifications page of the wiki." />

                            <TextBlock x:Name="TxtChatChannelsDropped" Visibility="Collapsed"
                                       Foreground="{StaticResource Warning}" FontSize="11" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="⚠  SqlVitals couldn't read the chat channels saved in its settings on this PC or Windows account, so they were removed. Add them again." />
                            <TextBlock x:Name="TxtNoChatChannels" Style="{StaticResource FieldHint}" Visibility="Collapsed"
                                       Text="No chat channels yet. Click Add channel to set one up." />

                            <ListBox x:Name="LstChatChannels"
                                     Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="Chat channels"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="LstChatChannels_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                            Padding="12,8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLight}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#337C3AED" />
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       MaxWidth="280" TextWrapping="Wrap" TextAlignment="Right"
                                                       Text="{Binding StatusText}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <!-- #122: a channel alerts aren't reaching stands out without opening it. -->
                                                            <DataTrigger Binding="{Binding Failing}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Add or edit a channel -->
                            <Border x:Name="ChatChannelForm" Visibility="Collapsed" Margin="0,8,0,0"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />  <!-- 0 Title -->
                                        <RowDefinition Height="Auto" />  <!-- 1 Name -->
                                        <RowDefinition Height="Auto" />  <!-- 2 Webhook URL -->
                                        <RowDefinition Height="Auto" />  <!-- 3 Service -->
                                        <RowDefinition Height="Auto" />  <!-- 4 Connections -->
                                        <RowDefinition Height="Auto" />  <!-- 5 Post -->
                                        <RowDefinition Height="Auto" />  <!-- 6 On -->
                                        <RowDefinition Height="Auto" />  <!-- 7 Message -->
                                        <RowDefinition Height="Auto" />  <!-- 8 Buttons -->
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="TxtChatFormTitle" Grid.ColumnSpan="2" Text="New Channel"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                               Text="Name" />
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBox x:Name="TxtChatName" Style="{StaticResource FieldTextBox}"
                                                 AutomationProperties.Name="Channel name" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="What you call it, e.g. DBA team (Teams). Shown here, in the activity log and in the app log." />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,19,12,0"
                                               Text="Webhook URL" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                        <!-- A saved URL stays out of every control until Show is pressed. -->
                                        <DockPanel x:Name="PnlChatUrlMasked" Visibility="Collapsed">
                                            <Button x:Name="BtnShowChatUrl" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                                    Padding="12,5" Margin="8,0,0,0" Click="BtnShowChatUrl_Click"
                                                    ToolTip="Show the whole URL, to check or change it"
                                                    Content="Show" />
                                            <TextBlock x:Name="TxtChatUrlMasked" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBox x:Name="TxtChatUrl" Style="{StaticResource FieldTextBox}"
                                                 AutomationProperties.Name="Webhook URL"
                                                 TextChanged="TxtChatUrl_TextChanged" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="Slack: an Incoming Webhook URL, starting https://hooks.slack.com/services/. Teams: the URL of a workflow made from the template &quot;Post to a channel when a webhook request is received&quot;. Anyone who has the URL can post to the channel, so treat it like a password." />
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,19,12,0"
                                               Text="Service" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                                        <ComboBox x:Name="CmbChatService" Width="200" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Chat service">
                                            <ComboBoxItem Content="Slack" Tag="Slack" />
                                            <ComboBoxItem Content="Microsoft Teams" Tag="Teams" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="Picked from the URL when SqlVitals recognises it." />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,14,12,0"
                                               Text="Connections" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                                        <RadioButton x:Name="RadChatAllConnections" GroupName="ChatConnections" IsChecked="True"
                                                     Foreground="{StaticResource TextPrimary}" FontSize="12"
                                                     Content="All monitored connections" Checked="ChatConnectionsChoice_Changed" />
                                        <RadioButton x:Name="RadChatChosenConnections" GroupName="ChatConnections" Margin="0,4,0,0"
                                                     Foreground="{StaticResource TextPrimary}" FontSize="12"
                                                     Content="Only these:" Checked="ChatConnectionsChoice_Changed" />
                                        <ItemsControl x:Name="LstChatConnections" Margin="20,4,0,0" IsEnabled="False"
                                                      AutomationProperties.Name="Connections this channel posts for">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}" Margin="0,0,0,4"
                                                              AutomationProperties.Name="{Binding Name, Mode=OneWay}">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="All means every connection SqlVitals is monitoring at the time, including ones you add later. Muting a connection's Windows notifications doesn't affect its channels." />
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,19,12,0"
                                               Text="Post" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,12,0,0">
                                        <ComboBox x:Name="CmbChatPost" Width="200" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Which alerts to post">
                                            <ComboBoxItem Content="Warnings and critical" />
                                            <ComboBoxItem Content="Critical only" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="A message is posted when an alert starts or turns critical. On Critical only, a warning that turns critical is posted as a new critical alert." />
                                        <CheckBox x:Name="ChkChatPostEnds" Content="Also post when an alert ends" IsChecked="True" Margin="0,10,0,0" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="Back to normal, for the alerts this channel was told about. When SqlVitals stops monitoring a connection with alerts still active, the channel is told either way, because no more updates will come." />
                                    </StackPanel>

                                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,12,0,0">
                                        <CheckBox x:Name="ChkChatEnabled" Content="On" IsChecked="True" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="Turn off to pause the channel without removing it. A test message can still be sent." />
                                    </StackPanel>

                                    <TextBlock x:Name="TxtChatFormMessage" Grid.Row="7" Grid.ColumnSpan="2"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="BtnSaveChatChannel" Style="{StaticResource RefreshButton}"
                                                Padding="14,6" Margin="0,0,8,0" Click="BtnSaveChatChannel_Click"
                                                Content="💾  Save channel" />
                                        <Button x:Name="BtnCancelChatChannel" Style="{StaticResource SecondaryButton}"
                                                Padding="14,6" Click="BtnCancelChatChannel_Click"
                                                Content="Cancel" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtChatStatus"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Notification area card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Notification Area"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <CheckBox x:Name="ChkKeepRunningInTray"
                              Content="Keep SqlVitals running in the notification area when the window is minimized or closed"
                              Click="ChkKeepRunningInTray_Click" />
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Monitoring, history and alerts carry on while the window is hidden. Click the SqlVitals icon in the notification area (beside the clock; it may be under ^) to bring the window back, or right-click it and choose Exit to quit. When this is off, minimizing goes to the taskbar and closing the window exits SqlVitals." />
                    <TextBlock x:Name="TxtTrayStatus"
                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Appearance card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" VerticalAlignment="Center" Width="80" />
                        <Button x:Name="BtnThemeToggle"
                                Style="{StaticResource RefreshButton}"
                                Padding="16,7"
                                Click="BtnThemeToggle_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Activity log card (#115) -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Activity Log"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="When monitoring was started and stopped, and by whom or what; when SqlVitals started and exited; every settings and connection change, with the value before and after; and when history was cleared. It explains a gap in the history or an alert that never came. Saved in the history file with the Windows user and PC name. Passwords, connection strings and other secrets are never logged: a secret setting only says it changed."
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <controls:ActivityLogView x:Name="ActivityLogView" />
                </StackPanel>
            </Border>

            <!-- Diagnostics card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Diagnostics"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <TextBlock FontSize="13">
                        <Hyperlink x:Name="LnkOpenLogFolder"
                                   Foreground="{StaticResource Accent}"
                                   Click="LnkOpenLogFolder_Click">Open log folder</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="TxtLogInfo"
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="BtnTestConnection"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,9"
                        Margin="0,0,12,0"
                        Click="BtnTestConnection_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50C;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSave"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,9"
                        Margin="0,0,12,0"
                        ToolTip="Validate and save this connection without switching to it"
                        Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSaveAndConnect"
                        Style="{StaticResource RefreshButton}"
                        Padding="18,9"
                        ToolTip="Validate and save this connection, then make it the active connection"
                        Click="BtnSaveAndConnect_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Save &amp; Connect" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status message -->
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
