<Page x:Class="SqlVitals.Desktop.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BgDeep}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BgDeep}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Connection Settings"
                       Style="{StaticResource SectionHeader}"
                       FontSize="20" Margin="0,0,0,4" />
            <TextBlock Text="Save connections to each SQL Server environment you monitor, then switch between them from the selector in the sidebar. Connection details are stored encrypted on this machine."
                       Foreground="{StaticResource TextMuted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- Saved connections card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnNewConnection" Style="{StaticResource SecondaryButton}"
                                    Padding="12,5" Margin="0,0,8,0" Click="BtnNewConnection_Click"
                                    Content="+  New connection" />
                            <Button x:Name="BtnRemoveConnection" Style="{StaticResource SecondaryButton}"
                                    Padding="12,5" Click="BtnRemoveConnection_Click"
                                    Content="🗑  Remove" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Saved Connections"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock x:Name="TxtNoConnections"
                               Text="No saved connections yet. Fill in the form below and click Save &amp; Connect to add your first one."
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />

                    <ListBox x:Name="LstConnections"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstConnections_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    Padding="12,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLight}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#337C3AED" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                            Background="{StaticResource Success}" CornerRadius="4" Padding="7,2"
                                            Visibility="{Binding ActiveVisibility}">
                                        <TextBlock Text="● ACTIVE" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Settings.DisplayName}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Settings.Summary}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Connect to Server card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TxtFormTitle" Text="New Connection"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 0 Server -->
                            <RowDefinition Height="Auto" />  <!-- 1 Authentication -->
                            <RowDefinition Height="Auto" />  <!-- 2 User name -->
                            <RowDefinition Height="Auto" />  <!-- 3 Password -->
                            <RowDefinition Height="Auto" />  <!-- 4 Remember password -->
                            <RowDefinition Height="Auto" />  <!-- 5 Database -->
                            <RowDefinition Height="Auto" />  <!-- 6 Encrypt -->
                            <RowDefinition Height="Auto" />  <!-- 7 Trust server cert -->
                            <RowDefinition Height="Auto" />  <!-- 8 Connection name -->
                            <RowDefinition Height="Auto" />  <!-- 9 Monitor in background -->
                        </Grid.RowDefinitions>

                        <!-- Monitor in background -->
                        <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,12,0,0">
                            <CheckBox x:Name="ChkMonitorInBackground" Content="Monitor in background" IsChecked="True" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Keep collecting live metrics (every 10 s by default) while another connection is active, so switching back shows continuous history and the sidebar can flag problems." />
                        </StackPanel>

                        <!-- Connection name -->
                        <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,19,12,0"
                                   Text="Connection name" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,12,0,0">
                            <TextBox x:Name="TxtConnectionName" Style="{StaticResource FieldTextBox}" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Shown in the sidebar connection selector, e.g. Production or UAT. Leave blank to use server / database." />
                        </StackPanel>

                        <!-- Server name -->
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0">
                            <Run Text="Server name" /><Run Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBox x:Name="TxtServer" Style="{StaticResource FieldTextBox}" TextChanged="ConnectionField_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="e.g. myserver.database.windows.net, localhost\SQLEXPRESS, or host,1433 for a custom port" />
                        </StackPanel>

                        <!-- Authentication -->
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,0,12,10">
                            <Run Text="Authentication" /><Run Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <ComboBox x:Name="CmbAuthentication" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                  SelectionChanged="CmbAuthentication_SelectionChanged">
                            <ComboBoxItem Content="SQL Server Authentication" Tag="SqlServer" />
                            <ComboBoxItem Content="Microsoft Entra MFA" Tag="EntraMfa" />
                            <ComboBoxItem Content="Windows Authentication" Tag="Windows" />
                        </ComboBox>

                        <!-- User name -->
                        <TextBlock x:Name="LblUserName" Grid.Row="2" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0">
                            <Run x:Name="RunUserNameText" Text="Login" /><Run x:Name="RunUserNameRequired" Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <StackPanel x:Name="PanelUserName" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <TextBox x:Name="TxtUserName" Style="{StaticResource FieldTextBox}" TextChanged="ConnectionField_Changed" />
                            <TextBlock x:Name="TxtUserNameHint" Style="{StaticResource FieldHint}"
                                       Text="Optional: your Entra account (user@domain.com) to pre-fill the sign-in prompt." />
                        </StackPanel>

                        <!-- Password -->
                        <TextBlock x:Name="LblPassword" Grid.Row="3" Style="{StaticResource FieldLabel}" Margin="0,0,12,10">
                            <Run Text="Password" /><Run Text=" *" Foreground="{StaticResource Danger}" />
                        </TextBlock>
                        <PasswordBox x:Name="TxtPassword" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                     PasswordChanged="ConnectionField_Changed" />

                        <!-- Remember password -->
                        <CheckBox x:Name="ChkSavePassword" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12"
                                  Content="Remember password" />

                        <!-- Database -->
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                   Text="Database name" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbDatabase" IsEditable="True"
                                      DropDownOpened="CmbDatabase_DropDownOpened" />
                            <TextBlock x:Name="TxtDatabaseHint" Style="{StaticResource FieldHint}"
                                       Text="Leave blank for the login's default database. Open the list to browse the server." />
                        </StackPanel>

                        <!-- Encrypt -->
                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Margin="0,0,12,10" Text="Encrypt" />
                        <ComboBox x:Name="CmbEncrypt" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"
                                  SelectionChanged="ConnectionField_Changed">
                            <ComboBoxItem Content="Mandatory" Tag="Mandatory" />
                            <ComboBoxItem Content="Optional" Tag="Optional" />
                            <ComboBoxItem Content="Strict (SQL Server 2022 and Azure SQL)" Tag="Strict" />
                        </ComboBox>

                        <!-- Trust server certificate -->
                        <CheckBox x:Name="ChkTrustServerCertificate" Grid.Row="7" Grid.Column="1"
                                  Content="Trust server certificate"
                                  Checked="ConnectionField_Changed" Unchecked="ConnectionField_Changed" />
                    </Grid>

                    <!-- Advanced -->
                    <Expander Header="Advanced" Foreground="{StaticResource TextMuted}"
                              FontSize="12" Margin="0,16,0,0">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Margin="0,0,12,10"
                                       Text="Connection timeout (s)" />
                            <TextBox x:Name="TxtConnectTimeout" Style="{StaticResource FieldTextBox}" Grid.Row="0" Grid.Column="1" Width="120"
                                     HorizontalAlignment="Left" Margin="0,0,0,10"
                                     TextChanged="ConnectionField_Changed" />

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                       Text="Additional parameters" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBox x:Name="TxtAdditionalParameters" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                         TextChanged="ConnectionField_Changed" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Extra connection string keywords, e.g. MultipleActiveResultSets=True;HostNameInCertificate=*.contoso.com" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Timeout card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Command Timeout (seconds)"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <TextBox x:Name="TxtTimeout"
                             Width="120" HorizontalAlignment="Left"
                             FontFamily="Consolas" FontSize="13"
                             Padding="10,6"
                             Background="{StaticResource BgDeep}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource TextPrimary}" />

                    <TextBlock Text="Default: 30 seconds. Increase for long-running diagnostic queries."
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Monitoring history card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Monitoring History"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                   Text="Snapshot every" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbHistoryInterval" Width="160" HorizontalAlignment="Left"
                                      SelectionChanged="HistorySetting_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="How often waits by type, file I/O, memory and the top queries are read from each monitored server and saved. Shorter intervals show more detail but add load and use more disk. Live Metrics figures are saved at every sample regardless." />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,12,0"
                                   Text="Keep history for" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbHistoryRetention" Width="160" HorizontalAlignment="Left"
                                      SelectionChanged="HistorySetting_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Older history is deleted automatically, and the file shrinks as it goes. Changes apply straight away." />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="BtnClearHistory" DockPanel.Dock="Right" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButton}" Padding="12,5"
                                Click="BtnClearHistory_Click"
                                Content="🗑  Clear history" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHistorySize"
                                       Foreground="{StaticResource TextPrimary}" FontSize="12" />
                            <TextBlock x:Name="TxtHistoryPath"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,3,12,0" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="TxtHistoryStatus"
                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Appearance card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" VerticalAlignment="Center" Width="80" />
                        <Button x:Name="BtnThemeToggle"
                                Style="{StaticResource RefreshButton}"
                                Padding="16,7"
                                Click="BtnThemeToggle_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Diagnostics card -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Diagnostics"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <TextBlock FontSize="13">
                        <Hyperlink x:Name="LnkOpenLogFolder"
                                   Foreground="{StaticResource Accent}"
                                   Click="LnkOpenLogFolder_Click">Open log folder</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="TxtLogInfo"
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="BtnTestConnection"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,9"
                        Margin="0,0,12,0"
                        Click="BtnTestConnection_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50C;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSave"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,9"
                        Margin="0,0,12,0"
                        ToolTip="Validate and save this connection without switching to it"
                        Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSaveAndConnect"
                        Style="{StaticResource RefreshButton}"
                        Padding="18,9"
                        ToolTip="Validate and save this connection, then make it the active connection"
                        Click="BtnSaveAndConnect_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Save &amp; Connect" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status message -->
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
