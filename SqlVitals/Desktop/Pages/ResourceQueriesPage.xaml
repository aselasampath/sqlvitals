<Page x:Class="SqlVitals.Desktop.Pages.ResourceQueriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      xmlns:helpers="clr-namespace:SqlVitals.Desktop.Helpers"
      Background="{StaticResource BgDeep}" Title="Resource-Intensive Queries">
    <Page.Resources>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TypeBadge" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- Query text (#232): one line without its comments, so a procedure's whole batch keeps
             its row one line high; hover for the text with its line breaks, View for all of it. -->
        <helpers:Shown x:Key="ShownIfText"/>
        <Style x:Key="QueryTextCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="ToolTip" Value="{Binding QueryTextTip}"/>
        </Style>
        <DataTemplate x:Key="ViewTextCell">
            <Button Content="View" CommandParameter="{Binding QueryText}" Command="{x:Static helpers:QueryTextWindow.Show}"
                    Visibility="{Binding QueryText, Converter={StaticResource ShownIfText}}"
                    Style="{StaticResource RefreshButton}" Padding="6,3" FontSize="11" Margin="2,1"
                    ToolTip="Open the whole query text in its own window, line breaks kept, to read, copy or save"/>
        </DataTemplate>
        <!-- Group by object (#232): a header per procedure, function or trigger, closed at first. -->
        <Style x:Key="ObjectGroup" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}" Cursor="Hand"
                                          AutomationProperties.Name="{Binding Name.Name}"
                                          ToolTip="Show or hide this object's queries. The totals are of its queries in this list.">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="▾" Width="16" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name.Name}" Margin="0,6,10,6"
                                                           VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name.Type}" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11"
                                                           Foreground="{DynamicResource AccentLight}"/>
                                                <TextBlock Text="{Binding Name.Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="Text" Value="▸"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ItemsPresenter x:Name="Items"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Name.IsExpanded}" Value="False">
                                <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <!-- The page template (#149): the verdict on the costliest queries first, then the tabs; a row
         selected shows its figures, its text and its plan in the details drawer. Bound to
         ResourceQueriesViewModel (#186). -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="Resource-Intensive Queries" PageKey="ResourceQueries">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Group by object" IsChecked="{Binding GroupByObject}" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}" Cursor="Hand" FontFamily="Segoe UI" FontSize="13" Margin="0,0,10,0"
                          ToolTip="One group per stored procedure, function or trigger, and one for the ad hoc queries, the costliest first. Groups start closed."/>
                <Button Content="Expand all" Command="{Binding ExpandAllCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="8,3" Margin="0,0,6,0" ToolTip="Open every group"/>
                <Button Content="Collapse all" Command="{Binding CollapseAllCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="8,3" Margin="0,0,16,0" ToolTip="Close every group"/>
                <TextBlock Text="Row Limit:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="Segoe UI" FontSize="13" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbTopN" Width="80" Height="30"
                          Background="{StaticResource BgCard}"
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}"
                          ItemsSource="{Binding TopNChoices}" SelectedItem="{Binding TopN}"/>
            </StackPanel>
        </controls:PageShell.Actions>

            <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}" Background="{StaticResource BgDeep}"
                        BorderBrush="{StaticResource Border}"
                        Foreground="{StaticResource TextPrimary}">

                <!-- Tab 1: By Logical Reads -->
                <TabItem x:Name="TabReads" Header="By Logical Reads">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="&#x2398; Copy All" DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshButton}" Padding="10,5"
                                        ToolTip="Copy every row shown, in the grid's current order, with headers."
                                        Command="{x:Static helpers:DataGridExport.CopyAll}" CommandParameter="{Binding ElementName=ReadsGrid}"/>
                                <controls:GridFilterBox DockPanel.Dock="Right" Margin="0,0,10,0"
                                                        Target="{Binding ElementName=ReadsGrid}"/>
                                <TextBlock Text="Queries sorted by total logical reads (most I/O-intensive)"
                                           Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="ReadsGrid" ItemsSource="{Binding ByReads}" SelectedItem="{Binding SelectedByReads}" CanUserAddRows="False"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                <DataGrid.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource ObjectGroup}">
                                        <GroupStyle.Panel><ItemsPanelTemplate><DataGridRowsPresenter/></ItemsPanelTemplate></GroupStyle.Panel>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"  Width="100" ElementStyle="{StaticResource SingleLineText}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Database the query was compiled against (DB_NAME from sql_handle)."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Object"      Binding="{Binding ObjectName}"    Width="140" ElementStyle="{StaticResource SingleLineText}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Stored procedure or object name, if the query belongs to one. Blank = ad-hoc query."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Type"        Binding="{Binding ObjectType}"    Width="90"  ElementStyle="{StaticResource TypeBadge}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Object type: Stored Proc, Scalar Func, Table Func, Inline Func, View, Trigger, or Ad-Hoc."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions"  Binding="{Binding ExecutionCount, StringFormat=N0}"          Width="90">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of times this plan was executed since it entered cache."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}"        Width="110">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Total logical reads (buffer pool page hits) across all executions."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg Reads"   Binding="{Binding AvgLogicalReads, StringFormat=N0}"          Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average logical reads per execution."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total CPU µs" Binding="{Binding TotalCPUTime, StringFormat=N0}"            Width="110">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Total CPU time in microseconds across all executions."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg CPU µs"  Binding="{Binding AvgCPUTime, StringFormat=N0}"              Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average CPU time per execution in microseconds."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg Elapsed µs" Binding="{Binding AvgElapsedTime, StringFormat=N0}"       Width="120">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average wall-clock time per execution in microseconds."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Last Exec"   Binding="{Binding LastExecutionTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="When this query last ran."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Plan" Width="90" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View Plan" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ViewPlanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Style="{StaticResource RefreshButton}"
                                                        Padding="6,3" FontSize="11" Margin="2,1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Text" Width="60" CanUserSort="False" CellTemplate="{StaticResource ViewTextCell}"/>
                                    <DataGridTextColumn Header="Query Text"  Binding="{Binding QueryTextLine}" ClipboardContentBinding="{Binding QueryText}" Width="*" ElementStyle="{StaticResource QueryTextCell}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The statement, cut from its batch by its offsets, on one line without its comments. Hover for more, View or select the row for all of it. The filter, Copy All and Export use the whole text."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- Tab 2: By CPU -->
                <TabItem x:Name="TabCpu" Header="By CPU">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="&#x2398; Copy All" DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshButton}" Padding="10,5"
                                        ToolTip="Copy every row shown, in the grid's current order, with headers."
                                        Command="{x:Static helpers:DataGridExport.CopyAll}" CommandParameter="{Binding ElementName=CpuGrid}"/>
                                <controls:GridFilterBox DockPanel.Dock="Right" Margin="0,0,10,0"
                                                        Target="{Binding ElementName=CpuGrid}"/>
                                <TextBlock Text="Queries sorted by total CPU time (most processor-intensive)"
                                           Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="CpuGrid" ItemsSource="{Binding ByCpu}" SelectedItem="{Binding SelectedByCpu}" CanUserAddRows="False"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                <DataGrid.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource ObjectGroup}">
                                        <GroupStyle.Panel><ItemsPanelTemplate><DataGridRowsPresenter/></ItemsPanelTemplate></GroupStyle.Panel>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"  Width="100" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Object"      Binding="{Binding ObjectName}"    Width="140" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Type"        Binding="{Binding ObjectType}"    Width="90"  ElementStyle="{StaticResource TypeBadge}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Object type: Stored Proc, Scalar Func, Table Func, Inline Func, View, Trigger, or Ad-Hoc."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions"  Binding="{Binding ExecutionCount, StringFormat=N0}"          Width="90"/>
                                    <DataGridTextColumn Header="Total CPU µs" Binding="{Binding TotalCPUTime, StringFormat=N0}"            Width="110">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Total CPU microseconds across all executions."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg CPU µs"  Binding="{Binding AvgCPUTime, StringFormat=N0}"              Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average CPU per execution."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}"        Width="110"/>
                                    <DataGridTextColumn Header="Avg Reads"   Binding="{Binding AvgLogicalReads, StringFormat=N0}"          Width="100"/>
                                    <DataGridTextColumn Header="Avg Elapsed µs" Binding="{Binding AvgElapsedTime, StringFormat=N0}"        Width="120"/>
                                    <DataGridTextColumn Header="Last Exec"   Binding="{Binding LastExecutionTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                    <DataGridTemplateColumn Header="Plan" Width="90" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View Plan" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ViewPlanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Style="{StaticResource RefreshButton}"
                                                        Padding="6,3" FontSize="11" Margin="2,1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Text" Width="60" CanUserSort="False" CellTemplate="{StaticResource ViewTextCell}"/>
                                    <DataGridTextColumn Header="Query Text"  Binding="{Binding QueryTextLine}" ClipboardContentBinding="{Binding QueryText}" Width="*" ElementStyle="{StaticResource QueryTextCell}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The statement, cut from its batch by its offsets, on one line without its comments. Hover for more, View or select the row for all of it. The filter, Copy All and Export use the whole text."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- Tab 3: Highest Logical Reads -->
                <TabItem Header="Highest Logical Reads">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="&#x2398; Copy All" DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshButton}" Padding="10,5"
                                        ToolTip="Copy every row shown, in the grid's current order, with headers."
                                        Command="{x:Static helpers:DataGridExport.CopyAll}" CommandParameter="{Binding ElementName=HighestReadsGrid}"/>
                                <controls:GridFilterBox DockPanel.Dock="Right" Margin="0,0,10,0"
                                                        Target="{Binding ElementName=HighestReadsGrid}"/>
                                <TextBlock Text="Queries sorted by total logical reads"
                                           Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="HighestReadsGrid" ItemsSource="{Binding ByHighestReads}" SelectedItem="{Binding SelectedByHighestReads}" CanUserAddRows="False"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                <DataGrid.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource ObjectGroup}">
                                        <GroupStyle.Panel><ItemsPanelTemplate><DataGridRowsPresenter/></ItemsPanelTemplate></GroupStyle.Panel>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"  Width="100" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Object"      Binding="{Binding ObjectName}"    Width="140" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Type"        Binding="{Binding ObjectType}"    Width="90"  ElementStyle="{StaticResource TypeBadge}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Object type: Stored Proc, Scalar Func, Table Func, Inline Func, View, Trigger, or Ad-Hoc."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions"  Binding="{Binding ExecutionCount, StringFormat=N0}"          Width="90"/>
                                    <DataGridTextColumn Header="Total Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}"        Width="110"/>
                                    <DataGridTextColumn Header="Last Reads"  Binding="{Binding LastLogicalReads, StringFormat=N0}"         Width="100"/>
                                    <DataGridTextColumn Header="Avg Reads"   Binding="{Binding AvgLogicalReads, StringFormat=N0}"          Width="100"/>
                                    <DataGridTextColumn Header="Total CPU µs" Binding="{Binding TotalCPUTime, StringFormat=N0}"            Width="110"/>
                                    <DataGridTextColumn Header="Avg CPU µs"  Binding="{Binding AvgCPUTime, StringFormat=N0}"              Width="100"/>
                                    <DataGridTextColumn Header="Last Exec"   Binding="{Binding LastExecutionTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                    <DataGridTemplateColumn Header="Plan" Width="90" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View Plan" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ViewPlanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Style="{StaticResource RefreshButton}"
                                                        Padding="6,3" FontSize="11" Margin="2,1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Text" Width="60" CanUserSort="False" CellTemplate="{StaticResource ViewTextCell}"/>
                                    <DataGridTextColumn Header="Query Text"  Binding="{Binding QueryTextLine}" ClipboardContentBinding="{Binding QueryText}" Width="*" ElementStyle="{StaticResource QueryTextCell}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The whole batch the statement is in: for a procedure, its CREATE PROCEDURE. Shown on one line without its comments; hover for more, View or select the row for all of it. The filter, Copy All and Export use the whole text."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

            </TabControl>
    </controls:PageShell>
</Page>
