<Page x:Class="SqlVitals.Desktop.Pages.PerfmonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Perfmon Counters"
     >

    <Page.Resources>
        <!-- Flat button for Select All / Clear All -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Height"           Value="24"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="Background"       Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
        </Style>

        <!-- Checkbox style to match dark theme -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="0,1"/>
            <Setter Property="Padding"     Value="4,0,0,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
    </Page.Resources>

    <!-- The page template (#150): the verdict on counters past a known limit first, then the
         counters and the chart. Start and Stop are the top bar's Resume and Pause (#140). -->
    <controls:PageShell x:Name="Shell" Margin="16,12,16,12" Title="Perfmon Counters" PageKey="Perfmon">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Live, or a past range from the monitoring history; and the baseline. In the top bar (#140). -->
                <controls:TimeRangePicker x:Name="RangePicker" Margin="0,0,16,0"
                                          RangeChanged="RangePicker_RangeChanged"
                                          BaselineChanged="RangePicker_BaselineChanged"/>
                <TextBlock Text="Read every:" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           FontFamily="Segoe UI" FontSize="12"/>
                <ComboBox x:Name="CmbInterval" Width="80" Height="26"
                          Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}"
                          FontFamily="Segoe UI" FontSize="12"
                          ToolTip="How often the counters are read while live. Resume (▶) in the top bar starts reading, Pause stops it."
                          SelectionChanged="CmbInterval_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Border Margin="8,0,0,0" Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="3" Padding="6,0" Height="26" VerticalAlignment="Center"
                        ToolTip="Seconds to the next read; -- while paused">
                    <TextBlock x:Name="TxtCountdown" Text="--"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Mono" FontSize="11"
                               MinWidth="28" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </controls:PageShell.Actions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <!-- splitter -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Counter Selector ─────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14,12,14">

                    <!-- Title -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Select Counters"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <!-- Group preset dropdown -->
                    <ComboBox x:Name="CmbGroup" DockPanel.Dock="Top"
                              Height="28" Margin="0,0,0,8"
                              Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                              BorderBrush="{StaticResource Border}"
                              FontFamily="Segoe UI" FontSize="12"
                              SelectionChanged="CmbGroup_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!-- Select All / Clear All -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Select All" Style="{StaticResource FlatBtn}" Click="SelectAll_Click"/>
                        <Button Grid.Column="2" Content="Clear All"  Style="{StaticResource FlatBtn}" Click="ClearAll_Click"/>
                    </Grid>

                    <!-- Search box -->
                    <TextBox x:Name="TxtSearch" DockPanel.Dock="Top"
                             Height="26" Margin="0,0,0,8"
                             Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource Border}" BorderThickness="1"
                             Padding="6,2" FontFamily="Segoe UI" FontSize="11"
                             TextChanged="TxtSearch_TextChanged"/>

                    <!-- Checkboxes list (scrollable) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CounterList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DarkCheck}"
                                              Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Checked="Counter_CheckChanged"
                                              Unchecked="Counter_CheckChanged"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- ── Splitter ───────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"/>

            <!-- ── Right: Chart + toolbar ─────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chart -->
                <Border Grid.Row="0" Margin="12,0,0,6"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <lvc:CartesianChart x:Name="PerfmonChart"
                                            Margin="4"
                                            TooltipPosition="Top"
                                            LegendPosition="Bottom"/>
                        <TextBlock x:Name="TxtNoData"
                                   Text="Select counters from the left panel to begin charting."
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Status bar -->
                <Border Grid.Row="1" Margin="12,0,0,0"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="3" Padding="10,4">
                    <DockPanel>
                        <TextBlock x:Name="TxtMaxNote"
                                   Text="Max 12 counters shown simultaneously."
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="10"
                                   DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus"
                                   Text="Not reading: Resume (▶) in the top bar starts it, Refresh reads once."
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="10"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </controls:PageShell>
</Page>
