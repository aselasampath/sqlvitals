<Page x:Class="SqlVitals.Desktop.Pages.AlertsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Alerts">
    <Page.Resources>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- Critical in red, warning in amber. -->
        <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- An active alert stands out; an ended one is muted. -->
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ToolbarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Alerts — when health thresholds were breached" Style="{StaticResource SectionHeader}"
                   FontSize="20" Margin="0,0,0,14" />

        <!-- Which alerts to list -->
        <Border Grid.Row="1" Style="{StaticResource KpiCard}" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Connection:" Style="{StaticResource ToolbarLabel}"/>
                    <ComboBox x:Name="CmbConnection" Width="200" Style="{StaticResource ToolbarCombo}"
                              AutomationProperties.Name="Connection"
                              SelectionChanged="Filter_SelectionChanged"
                              ToolTip="Show every connection's alerts, or one connection's. Alerts of a deleted connection show under All connections."/>

                    <TextBlock Text="Show:" Style="{StaticResource ToolbarLabel}"/>
                    <ComboBox x:Name="CmbStatus" Width="140" Style="{StaticResource ToolbarCombo}"
                              AutomationProperties.Name="Show"
                              SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="Active and past" IsSelected="True"/>
                        <ComboBoxItem Content="Active only"/>
                        <ComboBoxItem Content="Past only"/>
                    </ComboBox>

                    <TextBlock Text="Period:" Style="{StaticResource ToolbarLabel}"/>
                    <ComboBox x:Name="CmbPeriod" Width="140" Style="{StaticResource ToolbarCombo}"
                              AutomationProperties.Name="Period"
                              SelectionChanged="Filter_SelectionChanged"
                              ToolTip="Alerts active at any time in the period. Active alerts are always listed. History older than the retention in Settings is deleted, alerts with it."/>
                </WrapPanel>

                <TextBlock x:Name="TxtSummary" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Alerts, newest first -->
        <Border Grid.Row="2" Style="{StaticResource KpiCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
                    <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=AlertsGrid}" />
                    <TextBlock x:Name="TxtCount" Text="Alerts" Style="{StaticResource SectionHeader}"
                               Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="AlertsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="70" ElementStyle="{StaticResource StatusText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Active: still past its threshold. Ended: back to normal, or monitoring stopped (see Ended because)."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="75" ElementStyle="{StaticResource SeverityText}" SortMemberPath="SeverityRank">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The worst level the indicator held for long enough to alert. A warning alert becomes critical once the indicator stays past its critical threshold as long."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionName}" Width="140" ElementStyle="{StaticResource SingleLineText}" />
                            <DataGridTextColumn Header="Indicator" Binding="{Binding IndicatorName}" Width="150" ElementStyle="{StaticResource SingleLineText}" />
                            <DataGridTextColumn Header="Started" Binding="{Binding Started, StringFormat='{}{0:d MMM HH:mm:ss}'}" Width="120" ElementStyle="{StaticResource SingleLineText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The first sample past the threshold, on this PC's clock. The alert is raised a few samples later (Settings → Alerts)."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ended" Binding="{Binding Ended, StringFormat='{}{0:d MMM HH:mm:ss}'}" Width="120" ElementStyle="{StaticResource SingleLineText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The first sample back to normal, on this PC's clock; or the last sample taken, when monitoring stopped. Blank while active."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="95" ElementStyle="{StaticResource Number}" SortMemberPath="DurationSeconds">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="How long it lasted, or has lasted so far."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Worst value" Binding="{Binding ValueText}" Width="90" ElementStyle="{StaticResource Number}" SortMemberPath="Value">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The worst figure seen while the alert was active: the highest, or the lowest for page life expectancy."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdText}" Width="85" ElementStyle="{StaticResource Number}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The threshold of its severity when it was crossed (Settings → Health Thresholds, or the connection's own)."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ended because" Binding="{Binding EndReasonText}" Width="125" ElementStyle="{StaticResource SingleLineText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Back to normal: the indicator stayed within its thresholds for the set number of samples. Monitoring stopped: paused, the connection edited or removed, or SqlVitals closed."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" MinWidth="180" ElementStyle="{StaticResource SingleLineText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="What the health dot said at the worst value, e.g. the database whose log was fullest."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtNoData" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"
                               Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,60,0,0"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Page>
