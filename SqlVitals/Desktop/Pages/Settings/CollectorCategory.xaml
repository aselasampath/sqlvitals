<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.CollectorCategory"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="Collector service" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="TxtSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

            <!-- The service on this PC: its state, start and stop. -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="BtnStart" Content="Start" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Start the collector service"
                                    Command="{Binding StartService, ElementName=Root}" />
                            <Button x:Name="BtnStop" Content="Stop" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Stop the collector service"
                                    Command="{Binding StopService, ElementName=Root}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="The service on this PC" Style="{StaticResource RowLabel}" />
                            <TextBlock x:Name="TxtState" Style="{StaticResource RowHelp}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="TxtServiceStatus" Style="{StaticResource Status}" />
                </StackPanel>
            </Border>

            <!-- What Start does. -->
            <Border Style="{StaticResource SettingsCard}">
                <DockPanel>
                    <ComboBox x:Name="CmbChoice" DockPanel.Dock="Right" MinWidth="240" VerticalAlignment="Top"
                              AutomationProperties.Name="When monitoring starts"
                              SelectionChanged="CmbChoice_SelectionChanged" />
                    <StackPanel>
                        <TextBlock Text="When monitoring starts" Style="{StaticResource RowLabel}" />
                        <TextBlock Style="{StaticResource RowHelp}"
                                   Text="What ▶ Start does for a server while the service is installed: ask where to watch it, watch it in SqlVitals as before, or hand it to the service, which keeps watching when SqlVitals is closed." />
                        <TextBlock x:Name="TxtChoiceStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Each server: who watches it, and the button that moves it. -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Your servers" Style="{StaticResource RowLabel}" />
                    <TextBlock Style="{StaticResource RowHelp}" Margin="0,0,0,8"
                               Text="A server handed to the service keeps its history, alerts and chat channels: the service records under the same server, and its chat channels are given to the service. Taking it back hands it to SqlVitals again." />
                    <ItemsControl x:Name="ServersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" MinWidth="110" Content="{Binding ActionText}" Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Center"
                                            Command="{Binding Act}" IsEnabled="{Binding CanAct}" ToolTip="{Binding ActionToolTip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding ActionName}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{Binding Where}" Style="{StaticResource RowHelp}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtServersStatus" Style="{StaticResource Status}" />
                </StackPanel>
            </Border>

            <!-- A collector on another PC, read from its share copy. -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="A collector on another PC" Style="{StaticResource RowLabel}" />
                    <TextBlock Style="{StaticResource RowHelp}"
                               Text="The folder (or file) of its share copy, history-share.db, written with SqlVitals.Collector.exe set --share-copy-minutes 5. It is read only; its servers that match yours, by server and database, show its history here and aren't collected by this PC." />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                AutomationProperties.Name="Save the collector history path"
                                Command="{Binding SaveRemote, ElementName=Root}" />
                        <TextBox x:Name="TxtRemotePath" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Collector history from another PC" />
                    </DockPanel>
                    <TextBlock x:Name="TxtRemoteStatus" Style="{StaticResource Status}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
