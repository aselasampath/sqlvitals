<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.ConnectionPermissions"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" FontFamily="Segoe UI">
    <!-- Check permissions from a connection's card (#177): over the cards while it's open. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
            <!-- ← Connections / name / Permissions -->
            <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10">
                <Hyperlink x:Name="LnkBack" Command="{Binding BackCommand, ElementName=Root}" Foreground="{DynamicResource Accent}"
                           TextDecorations="None">← Connections</Hyperlink>
                <Run Text="  /  " /><Run x:Name="RunName" /><Run Text="  /  Permissions" />
            </TextBlock>

            <TextBlock x:Name="TxtTitle" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TxtLine" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,5,0,16"
                       TextTrimming="CharacterEllipsis" />

            <ContentControl x:Name="CheckHost" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
