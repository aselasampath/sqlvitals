<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.ThresholdsCategory"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- An explicit Save: a half-typed threshold must not grade samples -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource SaveBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDiscard" Content="Discard" Style="{StaticResource SecondaryButton}" Padding="18,8"
                            Click="Discard_Click" ToolTip="Put back the saved thresholds" />
                    <Button x:Name="BtnSave" Content="Save" Style="{StaticResource RefreshButton}" Padding="18,8" Margin="8,0,0,0"
                            Click="Save_Click" ToolTip="Grade every connection without its own thresholds on these" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtUnsaved" Style="{StaticResource Unsaved}" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource Status}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock Text="Health thresholds" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="TxtSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="TxtIntro" Style="{StaticResource CardText}" Margin="0,3,0,14" />
                        <controls:HealthThresholdsEditor x:Name="GlobalThresholds" />
                        <!-- What the monitored connections on these thresholds would score (#173) -->
                        <TextBlock x:Name="TxtPreview" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" FontSize="12">
                                <Hyperlink Click="Reset_Click" Foreground="{DynamicResource Accent}"
                                           ToolTip="Put SqlVitals' own defaults back in the boxes. Save to use them.">Reset to defaults</Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CardText}" Margin="0,0,16,0"
                                       Text="Fields that differ from SqlVitals' own defaults have an accent border. Leave a threshold blank to turn that level off. Weights are relative: the score is always out of 100, shared over the checks that reported, and 0 leaves a check out of it. Past warning a check loses half its points; past critical, all of them." />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
