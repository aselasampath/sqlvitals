<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.ConnectionsCategory"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:SqlVitals.Desktop.Pages.Settings"
             x:Name="Root" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- A card per saved connection -->
        <ScrollViewer x:Name="ListView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,18,24">
                <DockPanel Margin="0,0,14,16">
                    <Button x:Name="BtnNew" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource RefreshButton}"
                            Content="+  New connection" Click="New_Click"
                            ToolTip="Add a SQL Server connection" />
                    <StackPanel>
                        <TextBlock Text="Connections" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="TxtSubtitle" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="TxtStatus" Style="{StaticResource Status}" Margin="0,0,14,12" />

                <!-- No connections yet -->
                <Border x:Name="EmptyState" Style="{StaticResource SettingsCard}" Margin="0,0,14,0" Padding="28,28"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No saved connections yet" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardText}" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,14"
                                   Text="Add the SQL Server you want to monitor. SqlVitals checks it can sign in before saving, and keeps the details encrypted on this PC." />
                        <Button Content="+  New connection" Style="{StaticResource RefreshButton}" HorizontalAlignment="Center"
                                Click="New_Click" />
                    </StackPanel>
                </Border>

                <!-- Two cards a row, one in a narrow window; then "+ Add a connection" -->
                <ItemsControl x:Name="Cards" Focusable="False" AutomationProperties.Name="Saved connections">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="{Binding CardWidth, ElementName=Root}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type settings:ConnectionCardItem}">
                            <Border Margin="0,0,14,14" Padding="16,14" CornerRadius="10" MinHeight="150"
                                    Background="{DynamicResource BgCard}" BorderThickness="1"
                                    AutomationProperties.Name="{Binding Card.AutomationName}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Card.IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <!-- Dot, name and role -->
                                    <DockPanel DockPanel.Dock="Top">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{Binding RoleTint}">
                                            <TextBlock Text="{Binding Card.RoleLabel}" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Card.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   ToolTip="{Binding Card.Name}" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Card.ServerLine}" Foreground="{DynamicResource TextMuted}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,10"
                                               ToolTip="{Binding Card.ServerLine}" />

                                    <!-- State, then Check permissions, Test and Edit -->
                                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                            Padding="0,10,0,0" Margin="0,4,0,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                                                       ToolTip="{Binding StateToolTip}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Check permissions" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                                        Command="{Binding CheckPermissionsCommand}"
                                                        Visibility="{Binding CheckPermissionsVisibility}"
                                                        AutomationProperties.Name="{Binding CheckPermissionsName}"
                                                        ToolTip="Which permissions the login has, which pages miss out without the others, and the GRANT that adds them" />
                                                <Button Content="Test" Style="{StaticResource SecondaryButton}" Padding="14,5" Margin="8,0,0,0"
                                                        Click="Test_Click" IsEnabled="{Binding CanTest}"
                                                        AutomationProperties.Name="{Binding TestName}"
                                                        ToolTip="Try to sign in to the server with the saved details" />
                                                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="14,5" Margin="8,0,0,0"
                                                        BorderBrush="{DynamicResource AccentLight}" Click="Edit_Click"
                                                        AutomationProperties.Name="{Binding EditName}"
                                                        ToolTip="Open this connection's settings" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Sign-in, monitoring and thresholds -->
                                    <ItemsControl ItemsSource="{Binding Card.Tags}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Tag}">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource TagText}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- A connection's page, over the list while it's open -->
        <ContentControl x:Name="EditorHost" Focusable="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
