<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.AlertsCategory"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:SqlVitals.Desktop.Pages.Settings"
             x:Name="Root" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="Alerts &amp; chat" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="TxtSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

            <!-- Alerts -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Alerts" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardText}" Margin="0,3,0,10"
                               Text="Every sample of a monitored connection is checked against its health thresholds. An indicator that stays past one raises an alert, listed on the Alerts page with when it started and ended and its worst value." />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <ComboBox x:Name="CmbAlertSamples" DockPanel.Dock="Right" Width="160" VerticalAlignment="Center"
                                      AutomationProperties.Name="Samples in a row before an alert starts"
                                      SelectionChanged="AlertSetting_Changed" />
                            <StackPanel>
                                <TextBlock Text="Raise an alert after" Style="{StaticResource RowLabel}" />
                                <TextBlock Style="{StaticResource RowHelp}"
                                           Text="Samples in a row past a threshold before an alert starts. It ends after the same number back to normal, so a value hovering around a threshold raises one alert, not many. Samples follow each connection's Live Metrics interval: at the default 10 seconds, 3 samples is 30 seconds. Changes apply from the next sample." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="ChkNotifications" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          AutomationProperties.Name="Windows notifications" Click="ChkNotifications_Click" />
                                <StackPanel>
                                    <TextBlock Text="Windows notifications" Style="{StaticResource RowLabel}" />
                                    <TextBlock Style="{StaticResource RowHelp}"
                                               Text="When an alert starts or turns critical; clicking one opens the Alerts page for that connection. Off mutes every connection, on unmutes them all. Mute a single connection on its Monitoring &amp; alerts tab, or from the SqlVitals icon's menu in the notification area. Windows' own Do Not Disturb and notification settings still apply." />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="TxtMuted" Style="{StaticResource RowHelp}" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtAlertsStatus" Style="{StaticResource Status}" />
                </StackPanel>
            </Border>

            <!-- Chat channels (#120) -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="BtnAddChatChannel" DockPanel.Dock="Right" VerticalAlignment="Top"
                                Style="{StaticResource RefreshButton}" Click="BtnAddChatChannel_Click" Content="+  Add channel" />
                        <StackPanel>
                            <TextBlock Text="Chat channels" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource CardText}" Margin="0,3,16,0"
                                       Text="Post alerts to a Slack or Microsoft Teams channel through its webhook, so the whole team sees them when they start or turn critical. Messages are sent only while SqlVitals is running on this PC, for the connections it's monitoring at the time. Webhook URLs are stored encrypted, like passwords, and never written to the log. Setup steps for Slack and Teams are on the Chat Notifications page of the wiki." />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="TxtChatChannelsDropped" Visibility="Collapsed"
                               Foreground="{DynamicResource Warning}" FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="⚠  SqlVitals couldn't read the chat channels saved in its settings on this PC or Windows account, so they were removed. Add them again." />
                    <TextBlock x:Name="TxtNoChatChannels" Style="{StaticResource RowHelp}" Visibility="Collapsed"
                               Text="No chat channels yet. Click Add channel to set one up." />

                    <!-- A card per channel, two a row -->
                    <ItemsControl x:Name="ChannelCards" Focusable="False" AutomationProperties.Name="Chat channels">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="{Binding ChannelWidth, ElementName=Root}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type settings:ChatChannelCard}">
                                <Border Margin="0,0,12,12" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource Border}" AutomationProperties.Name="{Binding AutomationName}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{Binding LabelTint}">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource ChipText}" />
                                            </Border>
                                            <Ellipse Width="9" Height="9" Fill="{Binding Dot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,8" ToolTip="{Binding Detail}" />
                                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                                Padding="0,8,0,0" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Send test" Style="{StaticResource SecondaryButton}" Padding="12,4"
                                                        Click="SendTest_Click" AutomationProperties.Name="{Binding TestName}"
                                                        ToolTip="Post a test message to this channel, as it's saved" />
                                                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0"
                                                        BorderBrush="{DynamicResource AccentLight}" Click="EditChannel_Click"
                                                        AutomationProperties.Name="{Binding EditName}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Tag}">
                                                            <TextBlock Text="{Binding}" Style="{StaticResource TagText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add or edit a channel (as before #131) -->
                    <Border x:Name="ChatChannelForm" Visibility="Collapsed" Margin="0,4,12,0"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="156" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />  <!-- 0 Title -->
                                <RowDefinition Height="Auto" />  <!-- 1 Name -->
                                <RowDefinition Height="Auto" />  <!-- 2 Webhook URL -->
                                <RowDefinition Height="Auto" />  <!-- 3 Service -->
                                <RowDefinition Height="Auto" />  <!-- 4 Connections -->
                                <RowDefinition Height="Auto" />  <!-- 5 Post -->
                                <RowDefinition Height="Auto" />  <!-- 6 On -->
                                <RowDefinition Height="Auto" />  <!-- 7 Message -->
                                <RowDefinition Height="Auto" />  <!-- 8 Buttons -->
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtChatFormTitle" Grid.ColumnSpan="2" Text="New channel" Style="{StaticResource CardTitle}"
                                       Margin="0,0,0,12" />

                            <TextBlock Grid.Row="1" Text="Name" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBox x:Name="TxtChatName" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Channel name" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="What you call it, e.g. DBA team (Teams). Shown here, in the activity log and in the app log." />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Webhook URL" Style="{StaticResource FieldLabel}" Margin="0,20,12,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                <!-- A saved URL stays out of every control until Show is pressed. -->
                                <DockPanel x:Name="PnlChatUrlMasked" Visibility="Collapsed">
                                    <Button x:Name="BtnShowChatUrl" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                            Padding="12,5" Margin="8,0,0,0" Click="BtnShowChatUrl_Click"
                                            ToolTip="Show the whole URL, to check or change it" Content="Show" />
                                    <TextBlock x:Name="TxtChatUrlMasked" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBox x:Name="TxtChatUrl" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Webhook URL"
                                         TextChanged="TxtChatUrl_TextChanged" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Slack: an Incoming Webhook URL, starting https://hooks.slack.com/services/. Teams: the URL of a workflow made from the template &quot;Post to a channel when a webhook request is received&quot;. Anyone who has the URL can post to the channel, so treat it like a password." />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="Service" Style="{StaticResource FieldLabel}" Margin="0,20,12,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                                <ComboBox x:Name="CmbChatService" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Chat service">
                                    <ComboBoxItem Content="Slack" Tag="Slack" />
                                    <ComboBoxItem Content="Microsoft Teams" Tag="Teams" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Picked from the URL when SqlVitals recognises it." />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="Connections" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                                <RadioButton x:Name="RadChatAllConnections" GroupName="ChatConnections" IsChecked="True"
                                             Content="All monitored connections" Checked="ChatConnectionsChoice_Changed" />
                                <RadioButton x:Name="RadChatChosenConnections" GroupName="ChatConnections" Margin="0,4,0,0"
                                             Content="Only these:" Checked="ChatConnectionsChoice_Changed" />
                                <ItemsControl x:Name="LstChatConnections" Margin="20,4,0,0" IsEnabled="False"
                                              AutomationProperties.Name="Connections this channel posts for">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}" Margin="0,0,0,4"
                                                      AutomationProperties.Name="{Binding Name, Mode=OneWay}">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="All means every connection SqlVitals is monitoring at the time, including ones you add later. Muting a connection's Windows notifications doesn't affect its channels." />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Text="Post" Style="{StaticResource FieldLabel}" Margin="0,20,12,0" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,12,0,0">
                                <ComboBox x:Name="CmbChatPost" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Which alerts to post">
                                    <ComboBoxItem Content="Warnings and critical" />
                                    <ComboBoxItem Content="Critical only" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="A message is posted when an alert starts or turns critical. On Critical only, a warning that turns critical is posted as a new critical alert." />
                                <CheckBox x:Name="ChkChatPostEnds" Content="Also post when an alert ends" IsChecked="True" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Back to normal, for the alerts this channel was told about. When SqlVitals stops monitoring a connection with alerts still active, the channel is told either way, because no more updates will come." />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,12,0,0">
                                <CheckBox x:Name="ChkChatEnabled" Content="On" IsChecked="True" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Turn off to pause the channel without removing it. A test message can still be sent." />
                            </StackPanel>

                            <TextBlock x:Name="TxtChatFormMessage" Grid.Row="7" Grid.ColumnSpan="2"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                            <DockPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                <Button x:Name="BtnRemoveChatChannel" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                        Padding="14,6" Click="BtnRemoveChatChannel_Click" Foreground="{DynamicResource Danger}"
                                        Content="Remove channel…" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSaveChatChannel" Style="{StaticResource RefreshButton}"
                                            Padding="14,6" Margin="0,0,8,0" Click="BtnSaveChatChannel_Click" Content="Save channel" />
                                    <Button x:Name="BtnCancelChatChannel" Style="{StaticResource SecondaryButton}"
                                            Padding="14,6" Click="BtnCancelChatChannel_Click" Content="Close" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TxtChatStatus" Style="{StaticResource Status}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
