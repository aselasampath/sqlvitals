<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.AppearanceCategory"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="TxtSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

            <Border Style="{StaticResource SettingsCard}">
                <DockPanel>
                    <Button x:Name="BtnThemeToggle" DockPanel.Dock="Right" VerticalAlignment="Center"
                            Style="{StaticResource RefreshButton}" Padding="16,7" Click="BtnThemeToggle_Click" />
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource RowLabel}" />
                        <TextBlock x:Name="TxtTheme" Style="{StaticResource RowHelp}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
