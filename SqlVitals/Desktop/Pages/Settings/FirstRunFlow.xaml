<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.FirstRunFlow"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Background="{DynamicResource BgDeep}">
    <!-- First run (#177): Connect, Check and Start, over Settings while no connection is saved. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A step's number in a circle, and its name; each bound to its FirstRunStepItem. Done or
                 current: on the accent; still to come: muted. -->
            <Style x:Key="StepDot" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="{DynamicResource BgCard}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReached}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Accent}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- White on the accent, as the accent buttons; muted for a step still to come. -->
            <Style x:Key="StepNumber" TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Number}" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReached}" Value="True">
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StepName" TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Name}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StepLine" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Width" Value="48" />
                <Setter Property="Margin" Value="12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource Border}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- Welcome, the steps, and Skip -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="32,20,32,16">
            <DockPanel>
                <Button x:Name="BtnSkip" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                        Content="Skip for now" Command="{Binding SkipCommand}"
                        ToolTip="Go to Settings → Connections. This doesn't show again once a connection is saved." />
                <StackPanel>
                    <TextBlock Text="Welcome to SqlVitals" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="TxtIntro" Style="{StaticResource PageSubtitle}"
                               Text="Three steps to your first monitored server: connect, check the login's permissions, and start." />
                    <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,14,0,0" AutomationProperties.Name="{Binding StepsName}">
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Steps[0]}">
                            <Border x:Name="Dot1" Style="{StaticResource StepDot}"><TextBlock x:Name="Num1" Style="{StaticResource StepNumber}" /></Border>
                            <TextBlock x:Name="Name1" Style="{StaticResource StepName}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepLine}" />
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Steps[1]}">
                            <Border x:Name="Dot2" Style="{StaticResource StepDot}"><TextBlock x:Name="Num2" Style="{StaticResource StepNumber}" /></Border>
                            <TextBlock x:Name="Name2" Style="{StaticResource StepName}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepLine}" />
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Steps[2]}">
                            <Border x:Name="Dot3" Style="{StaticResource StepDot}"><TextBlock x:Name="Num3" Style="{StaticResource StepNumber}" /></Border>
                            <TextBlock x:Name="Name3" Style="{StaticResource StepName}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- 1. Connect: the connection editor -->
            <ContentControl x:Name="ConnectStep" Focusable="False"
                            Visibility="{Binding IsConnect, Converter={StaticResource Shown}}" />

            <!-- 2. Check: the permission check, then on to Start -->
            <DockPanel x:Name="CheckStep" Visibility="{Binding IsCheck, Converter={StaticResource Shown}}">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SaveBar}">
                    <DockPanel>
                        <Button x:Name="BtnNext" DockPanel.Dock="Right" Style="{StaticResource RefreshButton}" Padding="18,8"
                                Content="Next: Start  ›" Command="{Binding NextCommand}"
                                ToolTip="Missing permissions can be granted later: the pages that need them say so" />
                        <TextBlock Style="{StaticResource CardText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                                   Text="A missing permission can wait: each page that needs one says so, with the same script. Check again any time from the connection's card in Settings → Connections." />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,20,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="TxtCheckTitle" Text="{Binding CheckTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />
                        <ContentControl x:Name="CheckHost" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- 3. Start: monitoring on, then its Overview -->
            <ScrollViewer x:Name="StartStep" Visibility="{Binding IsStart, Converter={StaticResource Shown}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,20,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="TxtStartTitle" Text="{Binding StartTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,12" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource SettingsCard}">
                        <DockPanel>
                            <CheckBox x:Name="ChkStartMonitoring" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="24,0,0,0"
                                      Style="{StaticResource Switch}" IsChecked="{Binding StartMonitoring}" AutomationProperties.Name="Start monitoring now" />
                            <StackPanel>
                                <TextBlock Text="Start monitoring now" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="One light query every 10 seconds and a snapshot every 5 minutes, while SqlVitals runs: the health score, alerts and history fill in from there. Stop it any time from the server's sidebar or its tile on All servers." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button x:Name="BtnFinish" Style="{StaticResource RefreshButton}" Padding="18,8" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Content="{Binding FinishText}" AutomationProperties.Name="{Binding FinishName}"
                            Command="{Binding FinishCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
