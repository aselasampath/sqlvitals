<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.PermissionCheckView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SqlVitals.Desktop.ViewModels"
             xmlns:permissions="clr-namespace:SqlVitals.Engine.Permissions;assembly=SqlVitals.Engine"
             FontFamily="Segoe UI">
    <!-- The permission check (#177): bound to a PermissionCheckViewModel, in the first-run flow and
         from a connection's card. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- What it checks, and Check -->
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="BtnCheck" DockPanel.Dock="Right" VerticalAlignment="Top"
                    Content="{Binding CheckText}" Command="{Binding CheckCommand}" Margin="16,0,0,0"
                    ToolTip="Sign in again and read which permissions the login holds">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Style="{StaticResource CardText}" TextWrapping="Wrap"
                       Text="SqlVitals only reads. It checks the connection and the permissions each area needs: the server's state, msdb's backup history and Agent jobs, and definitions." />
        </DockPanel>

        <!-- "2 of 4 permissions are missing.", or why it couldn't check -->
        <TextBlock x:Name="TxtStatus" Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="NotRun">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Report.AllGranted}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Report.AllGranted}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- An area per row -->
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Permissions">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PermissionRow}">
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,8" AutomationProperties.Name="{Binding AutomationName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static permissions:PermissionState.Granted}">
                                                <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static permissions:PermissionState.Missing}">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding Needs, Mode=OneWay}" FontFamily="Consolas" FontSize="12" />
                                </TextBlock>
                                <TextBlock Text="{Binding Affects}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Affects}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                           Margin="0,3,0,0" FontStyle="Italic" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The GRANT script for what's missing -->
        <StackPanel x:Name="ScriptPanel" Visibility="{Binding HasScript, Converter={StaticResource Visible}}" Margin="0,8,0,0">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="BtnCopy" DockPanel.Dock="Right" Style="{StaticResource RefreshButton}" Content="{Binding CopyText}"
                        Command="{Binding CopyCommand}" Margin="16,0,0,0" VerticalAlignment="Center"
                        ToolTip="Copy the script, to paste into SSMS or send to your DBA" />
                <TextBlock Text="{Binding ScriptIntro}" Style="{StaticResource CardText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <TextBox x:Name="TxtScript" Text="{Binding Script, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     MaxHeight="260" Padding="10,8" Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource Border}" AutomationProperties.Name="GRANT script" />
        </StackPanel>
    </StackPanel>
</UserControl>
