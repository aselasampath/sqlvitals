<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.ConnectionEditor"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tabs underlined in the accent colour, as in the mockups. -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,18">
                                    <TabPanel IsItemsHost="True" />
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The header's colour and weight are set on its border, not the tab: the tab's content
                 inherits from the tab, and would turn bold and purple with it. -->
            <Style TargetType="TabItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                    Padding="2,6,2,8" Margin="0,0,24,-1"
                                    TextElement.Foreground="{DynamicResource TextMuted}" TextElement.FontSize="13">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#187C3AED" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A card's title and what it's for, on the left of its fields. -->
            <Style x:Key="CardSide" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,24,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- Saves every tab of this connection at once -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource SaveBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDiscard" Content="Discard" Style="{StaticResource SecondaryButton}" Padding="18,8"
                            Click="Discard_Click" ToolTip="Put back what's saved, on every tab" />
                    <Button x:Name="BtnSave" Content="Save" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource Accent}" Click="Save_Click"
                            ToolTip="Save every tab of this connection without switching to it" />
                    <Button x:Name="BtnSaveAndConnect" Content="Save &amp; make active" Style="{StaticResource RefreshButton}"
                            Padding="18,8" Margin="8,0,0,0" Click="SaveAndConnect_Click"
                            ToolTip="Save, then make it the active connection that every page queries" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtUnsaved" Style="{StaticResource Unsaved}" Visibility="Collapsed" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource Status}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
                <!-- ← Connections / name -->
                <TextBlock x:Name="Crumb" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10">
                    <Hyperlink x:Name="LnkBack" Click="Back_Click" Foreground="{DynamicResource Accent}" TextDecorations="None">← Connections</Hyperlink>
                    <Run Text="  /  " /><Run x:Name="RunCrumb" />
                </TextBlock>

                <!-- Name, status and score; where it points; Test and ⋯ -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnTest" Content="Test connection" Style="{StaticResource SecondaryButton}" Click="Test_Click"
                                ToolTip="Try to sign in with what's typed here, saved or not" />
                        <Button x:Name="BtnMore" Content="⋯" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"
                                Click="More_Click" AutomationProperties.Name="More actions" ToolTip="More actions">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MnuRemove" Header="Remove connection…" Click="Remove_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtName" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                            <Border x:Name="StatusChip" Style="{StaticResource Chip}" Margin="12,0,0,0">
                                <TextBlock x:Name="TxtStatusChip" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border x:Name="ActiveChip" Style="{StaticResource Chip}" Background="{DynamicResource AccentLight}">
                                <TextBlock Text="ACTIVE" Style="{StaticResource ChipText}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock x:Name="TxtLine" Foreground="{DynamicResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtViewOnHome" FontSize="12">
                                <Run Text=" · " Foreground="{DynamicResource TextMuted}" /><Hyperlink Click="ViewOnHome_Click"
                                    Foreground="{DynamicResource Accent}" ToolTip="Its score over time, its checks and its alerts">View on Home</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TabControl x:Name="Tabs">
                    <!-- ── Connection ─────────────────────────────────────── -->
                    <TabItem x:Name="TabConnection" Header="Connection">
                        <StackPanel>
                            <!-- Server -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource CardSide}">
                                        <TextBlock Text="Server" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Where SqlVitals connects, and how it signs in." Style="{StaticResource CardText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="Server name" /><Run Text=" *" Foreground="{DynamicResource Danger}" />
                                        </TextBlock>
                                        <TextBox x:Name="TxtServer" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Server name" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="e.g. myserver.database.windows.net, localhost\SQLEXPRESS, or host,1433 for a custom port" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    <Run Text="Authentication" /><Run Text=" *" Foreground="{DynamicResource Danger}" />
                                                </TextBlock>
                                                <ComboBox x:Name="CmbAuthentication" AutomationProperties.Name="Authentication"
                                                          SelectionChanged="CmbAuthentication_SelectionChanged">
                                                    <ComboBoxItem Content="SQL Server Authentication" Tag="SqlServer" />
                                                    <ComboBoxItem Content="Microsoft Entra MFA" Tag="EntraMfa" />
                                                    <ComboBoxItem Content="Windows Authentication" Tag="Windows" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel x:Name="PanelUserName" Grid.Column="2">
                                                <TextBlock x:Name="LblUserName" Style="{StaticResource FieldLabel}">
                                                    <Run x:Name="RunUserNameText" Text="Login" /><Run x:Name="RunUserNameRequired" Text=" *" Foreground="{DynamicResource Danger}" />
                                                </TextBlock>
                                                <TextBox x:Name="TxtUserName" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Login" />
                                                <TextBlock x:Name="TxtUserNameHint" Style="{StaticResource FieldHint}"
                                                           Text="Optional: your Entra account (user@domain.com) to pre-fill the sign-in prompt." />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="PanelPassword" Margin="0,14,0,0">
                                            <TextBlock x:Name="LblPassword" Style="{StaticResource FieldLabel}">
                                                <Run Text="Password" /><Run Text=" *" Foreground="{DynamicResource Danger}" />
                                            </TextBlock>
                                            <PasswordBox x:Name="TxtPassword" AutomationProperties.Name="Password" />
                                            <CheckBox x:Name="ChkSavePassword" Content="Remember password" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Database & security -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource CardSide}">
                                        <TextBlock Text="Database &amp; security" Style="{StaticResource CardTitle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Database name" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CmbDatabase" IsEditable="True" AutomationProperties.Name="Database name"
                                                          DropDownOpened="CmbDatabase_DropDownOpened" />
                                                <TextBlock x:Name="TxtDatabaseHint" Style="{StaticResource FieldHint}"
                                                           Text="Leave blank for the login's default database. Open the list to browse the server." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Encrypt" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CmbEncrypt" AutomationProperties.Name="Encrypt">
                                                    <ComboBoxItem Content="Mandatory" Tag="Mandatory" />
                                                    <ComboBoxItem Content="Optional" Tag="Optional" />
                                                    <ComboBoxItem Content="Strict (SQL Server 2022 and Azure SQL)" Tag="Strict" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="ChkTrustServerCertificate" Content="Trust server certificate" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Name -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource CardSide}">
                                        <TextBlock Text="Name" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Shown on its Home tile and in the sidebar." Style="{StaticResource CardText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Connection name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtConnectionName" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Connection name" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="Shown in the sidebar connection selector, e.g. Production or UAT. Leave blank to use server / database." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ── Monitoring & alerts ────────────────────────────── -->
                    <TabItem x:Name="TabMonitoring" Header="Monitoring &amp; alerts">
                        <Border Style="{StaticResource SettingsCard}" Padding="22,4">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <DockPanel>
                                        <CheckBox x:Name="ChkMonitorInBackground" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                  AutomationProperties.Name="Monitor in background" />
                                        <StackPanel>
                                            <TextBlock Text="Monitor in background" Style="{StaticResource RowLabel}" />
                                            <TextBlock Style="{StaticResource RowHelp}"
                                                       Text="With Start monitoring automatically on (Monitoring &amp; history), keep collecting live metrics, history and alerts for this connection while another one is active, so switching back shows continuous history and the sidebar can flag problems. Off for a new connection. You can also start it any time with ▶ in the sidebar selector." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="ChkNotify" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                  AutomationProperties.Name="Windows notifications for this connection" />
                                        <StackPanel>
                                            <TextBlock Text="Windows notifications" Style="{StaticResource RowLabel}" />
                                            <TextBlock Style="{StaticResource RowHelp}"
                                                       Text="Raise a Windows notification when one of this connection's alerts starts or turns critical; clicking it opens the Alerts page for this connection. Off mutes it: its alerts are still listed on the Alerts page, and still posted to its chat channels. Also in the SqlVitals icon's menu in the notification area (Notifications). Windows' own Do Not Disturb and notification settings still apply." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Top">
                                                <Hyperlink Click="AlertsAndChat_Click" Foreground="{DynamicResource Accent}">Alerts &amp; chat →</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="Chat channels" Style="{StaticResource RowLabel}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource RowHelp}"
                                                   Text="The Slack and Teams channels that post this connection's alerts. Set them up, and choose their connections, in Alerts &amp; chat." />
                                        <ItemsControl x:Name="LstChannels" Margin="0,8,0,0" Focusable="False"
                                                      AutomationProperties.Name="Chat channels that post this connection's alerts">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtNoChannels" Style="{StaticResource RowHelp}" Margin="0,8,0,0" Visibility="Collapsed"
                                                   Text="None: no chat channel posts this connection's alerts." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ── Health thresholds ──────────────────────────────── -->
                    <TabItem x:Name="TabThresholds">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <!-- An element, not a string, so it takes the header's colour and weight by binding. -->
                                <TextBlock Text="Health thresholds"
                                           Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                           FontWeight="{Binding (TextElement.FontWeight), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                <Border x:Name="OwnTag" Style="{StaticResource Chip}" Background="#333B82F6" Visibility="Collapsed">
                                    <TextBlock Text="OWN" Style="{StaticResource ChipText}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel>
                            <Border Style="{StaticResource SettingsCard}">
                                <DockPanel>
                                    <CheckBox x:Name="ChkCustomThresholds" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                              AutomationProperties.Name="Use its own health thresholds"
                                              Checked="ChkCustomThresholds_Changed" Unchecked="ChkCustomThresholds_Changed" />
                                    <StackPanel>
                                        <TextBlock Text="Use its own health thresholds" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource RowHelp}">
                                            <Run x:Name="RunOwnHelp" Text="Grade this connection's health dot on its own thresholds, e.g. for a server that always runs hot. Off: it uses the " /><Hyperlink
                                                Click="DefaultThresholds_Click" Foreground="{DynamicResource Accent}">default thresholds</Hyperlink><Run Text="." />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtPreview" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <controls:HealthThresholdsEditor x:Name="ConnectionThresholds" />
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock x:Name="TxtResetThresholds" DockPanel.Dock="Right" FontSize="12">
                                            <Hyperlink Click="ResetThresholds_Click" Foreground="{DynamicResource Accent}"
                                                       ToolTip="Put the default thresholds back in the boxes">Reset to defaults</Hyperlink>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtThresholdsNote" Style="{StaticResource CardText}" Margin="0,0,16,0" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ── Advanced ───────────────────────────────────────── -->
                    <TabItem x:Name="TabAdvanced" Header="Advanced">
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource CardSide}">
                                    <TextBlock Text="Advanced" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Rarely needed. Saving checks the server again." Style="{StaticResource CardText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Connection timeout (s)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtConnectTimeout" Style="{StaticResource FieldTextBox}" Width="120" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Connection timeout in seconds" />
                                    <TextBlock Text="Additional parameters" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                    <TextBox x:Name="TxtAdditionalParameters" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                             AutomationProperties.Name="Additional parameters" />
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Extra connection string keywords, e.g. MultipleActiveResultSets=True;HostNameInCertificate=*.contoso.com" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
