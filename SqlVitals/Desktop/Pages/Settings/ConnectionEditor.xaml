<UserControl x:Class="SqlVitals.Desktop.Pages.Settings.ConnectionEditor"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SqlVitals.Desktop;component/Pages/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tabs underlined in the accent colour, as in the mockups. -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,18">
                                    <TabPanel IsItemsHost="True" />
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The header's colour and weight are set on its border, not the tab: the tab's content
                 inherits from the tab, and would turn bold and purple with it. -->
            <Style TargetType="TabItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                    Padding="2,6,2,8" Margin="0,0,24,-1"
                                    TextElement.Foreground="{DynamicResource TextMuted}" TextElement.FontSize="13">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#187C3AED" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A card's title and what it's for, on the left of its fields. -->
            <Style x:Key="CardSide" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,24,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <DockPanel>
        <!-- Saves every tab of this connection at once -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource SaveBar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDiscard" Content="Discard" Style="{StaticResource SecondaryButton}" Padding="18,8"
                            Command="{Binding DiscardCommand}" ToolTip="Put back what's saved, on every tab" />
                    <!-- Save, beside Save & make active; on the first run Save & continue is the step's main button. -->
                    <Button x:Name="BtnSave" Content="{Binding SaveText}" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource Accent}" Command="{Binding SaveCommand}" ToolTip="{Binding SaveToolTip}"
                            Visibility="{Binding IsFirstRun, Converter={StaticResource Shown}, ConverterParameter=Not}" />
                    <Button x:Name="BtnSaveAndContinue" Content="{Binding SaveText}" Style="{StaticResource RefreshButton}" Padding="18,8"
                            Margin="8,0,0,0" Command="{Binding SaveCommand}" ToolTip="{Binding SaveToolTip}"
                            Visibility="{Binding IsFirstRun, Converter={StaticResource Shown}}" />
                    <Button x:Name="BtnSaveAndConnect" Content="Save &amp; make active" Style="{StaticResource RefreshButton}"
                            Padding="18,8" Margin="8,0,0,0" Command="{Binding SaveAndConnectCommand}"
                            Visibility="{Binding ShowsSaveAndConnect, Converter={StaticResource Shown}}"
                            ToolTip="Save, then make it the active connection that every page queries" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtUnsaved" Style="{StaticResource Unsaved}" Text="{Binding UnsavedText}" TextWrapping="Wrap"
                               Visibility="{Binding UnsavedText, Converter={StaticResource Shown}}" />
                    <!-- Why Save is disabled: the first rule a field breaks, on whichever tab. -->
                    <TextBlock x:Name="TxtProblem" Style="{StaticResource FieldError}" Text="{Binding Problem}" Margin="0,2,0,0" />
                    <controls:StatusText x:Name="TxtStatus" Style="{StaticResource Status}" Line="{Binding Status}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
                <!-- ← Connections / name -->
                <TextBlock x:Name="Crumb" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"
                           Visibility="{Binding IsFirstRun, Converter={StaticResource Shown}, ConverterParameter=Not}">
                    <Hyperlink x:Name="LnkBack" Command="{Binding BackCommand}" Foreground="{DynamicResource Accent}" TextDecorations="None">← Connections</Hyperlink>
                    <Run Text="  /  " /><Run x:Name="RunCrumb" Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>

                <!-- Name, status and score; where it points; Test and ⋯ -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnTest" Content="Test connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestCommand}"
                                ToolTip="Try to sign in with what's typed here, saved or not" />
                        <Button x:Name="BtnMore" Content="⋯" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"
                                Command="{Binding MoreCommand}" AutomationProperties.Name="More actions" ToolTip="More actions"
                                Visibility="{Binding HasStatus, Converter={StaticResource Shown}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MnuRemove" Header="Remove connection…" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{Binding TileStatus, Converter={StaticResource HealthBrush}}"
                                     Visibility="{Binding HasStatus, Converter={StaticResource Shown}}" />
                            <TextBlock x:Name="TxtName" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                            <Border x:Name="StatusChip" Style="{StaticResource Chip}" Margin="12,0,0,0"
                                    Background="{Binding TileStatus, Converter={StaticResource HealthBrush}, ConverterParameter=Tint}"
                                    Visibility="{Binding HasStatus, Converter={StaticResource Shown}}"
                                    AutomationProperties.Name="{Binding StatusName}">
                                <TextBlock x:Name="TxtStatusChip" Text="{Binding StatusText}" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border x:Name="ActiveChip" Style="{StaticResource Chip}" Background="{DynamicResource AccentLight}"
                                    Visibility="{Binding IsActive, Converter={StaticResource Shown}}">
                                <TextBlock Text="ACTIVE" Style="{StaticResource ChipText}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock x:Name="TxtLine" Text="{Binding Line}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtViewOnHome" FontSize="12" Visibility="{Binding HasStatus, Converter={StaticResource Shown}}">
                                <Run Text=" · " Foreground="{DynamicResource TextMuted}" /><Hyperlink Command="{Binding ViewOnHomeCommand}"
                                    Foreground="{DynamicResource Accent}" ToolTip="Its score over time, its checks and its alerts">View on Home</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTabIndex}">
                    <!-- ── Connection ─────────────────────────────────────── -->
                    <TabItem x:Name="TabConnection" Header="Connection">
                        <StackPanel>
                            <!-- Server -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource CardSide}">
                                        <TextBlock Text="Server" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Where SqlVitals connects, and how it signs in." Style="{StaticResource CardText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="Server name" /><Run Text=" *" Foreground="{DynamicResource Danger}" />
                                        </TextBlock>
                                        <TextBox x:Name="TxtServer" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Server name"
                                                 Text="{Binding Server, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                                                 Tag="{Binding ServerError}" />
                                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding ServerError}" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="e.g. myserver.database.windows.net, localhost\SQLEXPRESS, or host,1433 for a custom port" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    <Run Text="Authentication" /><Run Text=" *" Foreground="{DynamicResource Danger}" />
                                                </TextBlock>
                                                <ComboBox x:Name="CmbAuthentication" AutomationProperties.Name="Authentication"
                                                          ItemsSource="{Binding AuthenticationChoices}" DisplayMemberPath="Text"
                                                          SelectedValuePath="Value" SelectedValue="{Binding Authentication}" />
                                            </StackPanel>
                                            <StackPanel x:Name="PanelUserName" Grid.Column="2"
                                                        Visibility="{Binding ShowsUserName, Converter={StaticResource Shown}}">
                                                <TextBlock x:Name="LblUserName" Style="{StaticResource FieldLabel}">
                                                    <Run x:Name="RunUserNameText" Text="{Binding UserNameLabel, Mode=OneWay}" /><Run
                                                        x:Name="RunUserNameRequired" Text="{Binding UserNameRequiredMark, Mode=OneWay}" Foreground="{DynamicResource Danger}" />
                                                </TextBlock>
                                                <TextBox x:Name="TxtUserName" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Login"
                                                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                                                         Tag="{Binding UserNameError}" />
                                                <TextBlock Style="{StaticResource FieldError}" Text="{Binding UserNameError}" />
                                                <TextBlock x:Name="TxtUserNameHint" Style="{StaticResource FieldHint}"
                                                           Visibility="{Binding ShowsUserNameHint, Converter={StaticResource Shown}}"
                                                           Text="Optional: your Entra account (user@domain.com) to pre-fill the sign-in prompt." />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="PanelPassword" Margin="0,14,0,0"
                                                    Visibility="{Binding ShowsPassword, Converter={StaticResource Shown}}">
                                            <TextBlock x:Name="LblPassword" Style="{StaticResource FieldLabel}">
                                                <Run Text="Password" /><Run Text=" *" Foreground="{DynamicResource Danger}" />
                                            </TextBlock>
                                            <!-- Not bound: the code-behind copies it to the view model as it's typed. -->
                                            <PasswordBox x:Name="TxtPassword" AutomationProperties.Name="Password" />
                                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding PasswordError}" />
                                            <CheckBox x:Name="ChkSavePassword" Content="Remember password" Margin="0,10,0,0"
                                                      IsChecked="{Binding SavePassword}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Database & security -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource CardSide}">
                                        <TextBlock Text="Database &amp; security" Style="{StaticResource CardTitle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Database name" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CmbDatabase" IsEditable="True" AutomationProperties.Name="Database name"
                                                          ItemsSource="{Binding Databases}"
                                                          Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                                          IsDropDownOpen="{Binding IsDatabaseListOpen}" />
                                                <TextBlock x:Name="TxtDatabaseHint" Style="{StaticResource FieldHint}" Text="{Binding DatabaseHint}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Encrypt" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CmbEncrypt" AutomationProperties.Name="Encrypt"
                                                          ItemsSource="{Binding EncryptChoices}" DisplayMemberPath="Text"
                                                          SelectedValuePath="Value" SelectedValue="{Binding Encrypt}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="ChkTrustServerCertificate" Content="Trust server certificate" Margin="0,12,0,0"
                                                  IsChecked="{Binding TrustServerCertificate}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Name -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource CardSide}">
                                        <TextBlock Text="Name" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Shown on its Home tile and in the sidebar." Style="{StaticResource CardText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Connection name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TxtConnectionName" Style="{StaticResource FieldTextBox}" AutomationProperties.Name="Connection name"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                                                 Tag="{Binding NameError}" />
                                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding NameError}" />
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="Shown in the sidebar connection selector, e.g. Production or UAT. Leave blank to use server / database." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ── Monitoring & alerts ────────────────────────────── -->
                    <TabItem x:Name="TabMonitoring" Header="Monitoring &amp; alerts">
                        <Border Style="{StaticResource SettingsCard}" Padding="22,4">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                    <DockPanel>
                                        <CheckBox x:Name="ChkMonitorInBackground" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                  AutomationProperties.Name="Monitor in background" IsChecked="{Binding MonitorInBackground}" />
                                        <StackPanel>
                                            <TextBlock Text="Monitor in background" Style="{StaticResource RowLabel}" />
                                            <TextBlock Style="{StaticResource RowHelp}"
                                                       Text="With Start monitoring automatically on (Monitoring &amp; history), keep collecting live metrics, history and alerts for this connection while another one is active, so switching back shows continuous history and the sidebar can flag problems. Off for a new connection. You can also start it any time with ▶ in the sidebar selector." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="ChkNotify" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                  AutomationProperties.Name="Windows notifications for this connection" IsChecked="{Binding Notifies}" />
                                        <StackPanel>
                                            <TextBlock Text="Windows notifications" Style="{StaticResource RowLabel}" />
                                            <TextBlock Style="{StaticResource RowHelp}"
                                                       Text="Raise a Windows notification when one of this connection's alerts starts or turns critical; clicking it opens the Alerts page for this connection. Off mutes it: its alerts are still listed on the Alerts page, and still posted to its chat channels. Also in the SqlVitals icon's menu in the notification area (Notifications). Windows' own Do Not Disturb and notification settings still apply." />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Top">
                                                <Hyperlink Command="{Binding AlertsAndChatCommand}" Foreground="{DynamicResource Accent}">Alerts &amp; chat →</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="Chat channels" Style="{StaticResource RowLabel}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource RowHelp}"
                                                   Text="The Slack and Teams channels that post this connection's alerts. Set them up, and choose their connections, in Alerts &amp; chat." />
                                        <ItemsControl x:Name="LstChannels" Margin="0,8,0,0" Focusable="False" ItemsSource="{Binding Channels}"
                                                      AutomationProperties.Name="Chat channels that post this connection's alerts">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtNoChannels" Style="{StaticResource RowHelp}" Margin="0,8,0,0"
                                                   Visibility="{Binding HasNoChannels, Converter={StaticResource Shown}}"
                                                   Text="None: no chat channel posts this connection's alerts." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ── Health thresholds ──────────────────────────────── -->
                    <TabItem x:Name="TabThresholds">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <!-- An element, not a string, so it takes the header's colour and weight by binding. -->
                                <TextBlock Text="Health thresholds"
                                           Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                           FontWeight="{Binding (TextElement.FontWeight), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                <Border x:Name="OwnTag" Style="{StaticResource Chip}" Background="#333B82F6"
                                        Visibility="{Binding ShowsOwnTag, Converter={StaticResource Shown}}">
                                    <TextBlock Text="OWN" Style="{StaticResource ChipText}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel>
                            <Border Style="{StaticResource SettingsCard}">
                                <DockPanel>
                                    <CheckBox x:Name="ChkCustomThresholds" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                              AutomationProperties.Name="Use its own health thresholds"
                                              IsChecked="{Binding OwnThresholds, ValidatesOnNotifyDataErrors=False}" />
                                    <StackPanel>
                                        <TextBlock Text="Use its own health thresholds" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource RowHelp}">
                                            <Run x:Name="RunOwnHelp" Text="{Binding OwnHelp, Mode=OneWay}" /><Hyperlink
                                                Command="{Binding DefaultThresholdsCommand}" Foreground="{DynamicResource Accent}">default thresholds</Hyperlink><Run Text="." />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtPreview" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   Text="{Binding Preview}" Visibility="{Binding Preview, Converter={StaticResource Shown}}" />
                                        <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <controls:HealthThresholdsEditor x:Name="ConnectionThresholds" DataContext="{Binding Thresholds}" />
                                    <TextBlock x:Name="TxtThresholdsError" Style="{StaticResource FieldError}" Text="{Binding ThresholdsError}" Margin="0,10,0,0" />
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock x:Name="TxtResetThresholds" DockPanel.Dock="Right" FontSize="12"
                                                   Visibility="{Binding OwnThresholds, Converter={StaticResource Shown}}">
                                            <Hyperlink Command="{Binding ResetThresholdsCommand}" Foreground="{DynamicResource Accent}"
                                                       ToolTip="Put the default thresholds back in the boxes">Reset to defaults</Hyperlink>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtThresholdsNote" Style="{StaticResource CardText}" Margin="0,0,16,0" Text="{Binding ThresholdsNote}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ── Advanced ───────────────────────────────────────── -->
                    <TabItem x:Name="TabAdvanced" Header="Advanced">
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource CardSide}">
                                    <TextBlock Text="Advanced" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Rarely needed. Saving checks the server again." Style="{StaticResource CardText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Connection timeout (s)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtConnectTimeout" Style="{StaticResource FieldTextBox}" Width="120" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Connection timeout in seconds"
                                             Text="{Binding ConnectTimeout, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                                             Tag="{Binding ConnectTimeoutError}" />
                                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding ConnectTimeoutError}" />
                                    <TextBlock Text="Additional parameters" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                    <TextBox x:Name="TxtAdditionalParameters" Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                                             AutomationProperties.Name="Additional parameters"
                                             Text="{Binding AdditionalParameters, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                                             Tag="{Binding AdditionalParametersError}" />
                                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding AdditionalParametersError}" />
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Extra connection string keywords, e.g. MultipleActiveResultSets=True;HostNameInCertificate=*.contoso.com" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
