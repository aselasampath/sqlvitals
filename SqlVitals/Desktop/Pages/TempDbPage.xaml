<Page x:Class="SqlVitals.Desktop.Pages.TempDbPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="TempDB Pressure">
    <!-- The page template (#150): the verdict on who holds TempDB and the room left first; the
         counters and the file chart fold to one line; then the sessions. -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="TempDB Pressure" PageKey="TempDb">
        <controls:PageShell.Sections>
            <controls:FoldSection x:Name="CountersSection" Key="counters" Header="Counters">
                <WrapPanel x:Name="CounterGrid" />
            </controls:FoldSection>
            <controls:FoldSection x:Name="FilesSection" Key="files" Header="File space — used vs free (MB)">
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <lvc:CartesianChart x:Name="FileChart" Height="200"
                                        TooltipPosition="Top" LegendPosition="Right" />
                </Border>
            </controls:FoldSection>
        </controls:PageShell.Sections>

        <Border Style="{StaticResource KpiCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Top Sessions by TempDB Allocation" Style="{StaticResource SectionHeader}" />
                <DataGrid x:Name="SessionsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Session ID"     Binding="{Binding SessionId}"                    Width="80" />
                        <DataGridTextColumn Header="Login"          Binding="{Binding LoginName}"                   Width="130" />
                        <DataGridTextColumn Header="Database"       Binding="{Binding DatabaseName}"                Width="110" />
                        <DataGridTextColumn Header="Net KB"         Binding="{Binding NetTempDBUsageKB, StringFormat=N0}" Width="90">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Net TempDB allocation (alloc - dealloc) for this session in KB. Represents current TempDB footprint. Large values indicate temp tables or table variables not yet dropped."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="User Obj KB"   Binding="{Binding UserObjAllocKB, StringFormat=N0}" Width="100">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Pages allocated by explicit user objects: #temp tables, @table variables, cursors. High values = large temp tables in scope. Consider if these can be reduced or batched."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Internal KB"   Binding="{Binding InternalObjAllocKB, StringFormat=N0}" Width="100">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Pages allocated by internal SQL Server operations: sort spills, hash join spills, build inputs. High values indicate queries spilling to disk due to insufficient memory grants — look for missing indexes or low max server memory."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Wait Type"      Binding="{Binding WaitType}"                    Width="140">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Current wait type for this session. PAGEIOLATCH_* on TempDB files indicates I/O saturation. PAGELATCH_* indicates allocation page contention — fix by adding TempDB files equal to the number of scheduler cores (up to 8)."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Wait ms"        Binding="{Binding WaitTimeMs, StringFormat=N0}" Width="80">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Milliseconds the session has been waiting on its current wait type. Long waits on TempDB-related wait types signal I/O or allocation contention."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Status"         Binding="{Binding Severity}"                    Width="80">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Derived classification: Critical = net usage over 1 GB; Warning = over 100 MB; Info = normal range."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </controls:PageShell>
</Page>
