<Page x:Class="SqlVitals.Desktop.Pages.ServerDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:SqlVitals.Desktop.Pages"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Server">
    <Page.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RangeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="12,4" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLight}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <!-- ← Your servers / name -->
            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8">
                <Hyperlink x:Name="LnkBack" Click="Back_Click" Foreground="{StaticResource Accent}" TextDecorations="None">← Your servers</Hyperlink>
                <Run Text="  /  "/><Run x:Name="RunCrumb"/>
            </TextBlock>

            <!-- Name, status, and what can be done to the connection -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnMonitor" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Monitor_Click"
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="BtnEdit" Content="Edit connection" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Click="Edit_Click" ToolTip="Open this connection in Settings"/>
                    <Button x:Name="BtnMakeActive" Content="Make active" Style="{StaticResource RefreshButton}" Margin="8,0,0,0"
                            Click="MakeActive_Click"
                            ToolTip="Switch the dashboard and every page to this connection, as the sidebar selector does"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtName" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="StatusChip" CornerRadius="9" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        <Border x:Name="ActiveChip" CornerRadius="9" Padding="10,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                Background="{StaticResource AccentLight}">
                            <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtConnectionLine" Style="{StaticResource Muted}" Margin="22,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxtMissing" Style="{StaticResource Muted}" FontSize="14" Visibility="Collapsed"
                       Text="This connection was removed. Go back to your servers to see the others."/>

            <Grid x:Name="Main">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The score now -->
                <Border x:Name="ScoreCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Health score" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0">
                            <Run x:Name="RunScore" FontSize="52" FontWeight="Bold"/><Run
                                 Text=" / 100" FontSize="14" Foreground="{StaticResource TextMuted}"/>
                        </TextBlock>
                        <TextBlock x:Name="TxtLevel" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,6"/>
                        <TextBlock x:Name="TxtReason" Style="{StaticResource Body}"/>
                        <TextBlock x:Name="TxtContext" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- The score over time -->
                <Border x:Name="TrendCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="2">
                                <StackPanel Orientation="Horizontal" AutomationProperties.Name="Range">
                                    <RadioButton x:Name="Range1h"  Content="1 h"  GroupName="Range" Style="{StaticResource RangeButton}" Checked="Range_Checked"/>
                                    <RadioButton x:Name="Range24h" Content="24 h" GroupName="Range" Style="{StaticResource RangeButton}" Checked="Range_Checked"/>
                                    <RadioButton x:Name="Range7d"  Content="7 d"  GroupName="Range" Style="{StaticResource RangeButton}" Checked="Range_Checked"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtTrendTitle" Text="Score over the last 24 hours" Style="{StaticResource CardTitle}"
                                       Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtTrendNote" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                        <controls:ScoreChart x:Name="Chart" ShowAxes="True" Height="190"/>
                    </DockPanel>
                </Border>

                <!-- When the server can't be reached: why, what to check, and what happened -->
                <Grid x:Name="OutageRow" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Border Style="{StaticResource KpiCard}" BorderBrush="{StaticResource Danger}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtOutageTitle" Style="{StaticResource CardTitle}" FontSize="17" Margin="0"/>
                                <TextBlock x:Name="TxtOutageSince" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
                                <Border Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="TxtOutageError" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnRetry" Content="Retry now" Style="{StaticResource RefreshButton}" Click="Retry_Click"
                                            ToolTip="Try to collect a sample now"/>
                                    <Button x:Name="BtnTest" Content="Test connection" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Click="Test_Click" ToolTip="Open a connection to the server with the saved details, and close it"/>
                                    <Button Content="Copy error" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CopyError_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOutageAction" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Things to check" Style="{StaticResource CardTitle}"/>
                                <ItemsControl x:Name="ThingsList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{StaticResource TextMuted}"
                                                         Margin="2,6,8,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="13,4,0,0" FontSize="12">
                                    <Hyperlink Click="Edit_Click" Foreground="{StaticResource Accent}">Edit connection</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Before it went down" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="TxtBefore" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="What happened" Style="{StaticResource CardTitle}"/>
                                <ItemsControl x:Name="Timeline" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pages:DetailLine}">
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="64" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Checks, and what's happening on the server -->
                <Grid x:Name="ChecksRow" Grid.Row="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,16,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Checks" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="TxtNoChecks" Style="{StaticResource Muted}" Visibility="Collapsed"/>
                            <controls:HealthScoreBreakdown x:Name="Breakdown"/>
                            <TextBlock x:Name="TxtThresholds" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0">
                                <Run x:Name="RunThresholds"/>
                                <Hyperlink Click="ChangeThresholds_Click" Foreground="{StaticResource Accent}">Change</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border x:Name="BlockingCard" Style="{StaticResource KpiCard}" BorderBrush="{StaticResource Danger}"
                                Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="TxtBlockingFor" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource Danger}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Blocking right now" Style="{StaticResource CardTitle}" Margin="0"/>
                                </DockPanel>
                                <Grid x:Name="BlockingGrid" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Head blocker" Style="{StaticResource Muted}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtHead" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Text="Waiting" Style="{StaticResource Muted}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtWaiting" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Text="Statement" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtStatement" FontFamily="Consolas" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
                                </Grid>
                                <TextBlock x:Name="TxtBlockingNote" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                <TextBlock Margin="0,8,0,0" FontSize="12">
                                    <Hyperlink Click="BlockingChain_Click" Foreground="{StaticResource Accent}" FontWeight="SemiBold">See the blocking chain →</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                                        <Hyperlink Click="AllAlerts_Click" Foreground="{StaticResource Accent}">All alerts</Hyperlink>
                                    </TextBlock>
                                    <TextBlock x:Name="TxtAlertsTitle" Text="Alerts" Style="{StaticResource CardTitle}" Margin="0"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtNoAlerts" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <ItemsControl x:Name="AlertsList" Focusable="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pages:DetailAlert}">
                                            <DockPanel Margin="0,6,0,0">
                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" Margin="0,5,10,0"
                                                         VerticalAlignment="Top"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
