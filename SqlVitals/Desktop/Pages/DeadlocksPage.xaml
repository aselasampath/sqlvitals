<Page x:Class="SqlVitals.Desktop.Pages.DeadlocksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Deadlocks">
    <Page.Resources>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxHeight" Value="18"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- A deadlock seen more than once in the range is the one to look at first. -->
        <Style x:Key="TimesSeen" TargetType="TextBlock" BasedOn="{StaticResource Number}">
            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TimesSeen}" Value="1">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VictimText" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="RoleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ToolbarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource RefreshButton}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Deadlocks — history from system_health" Style="{StaticResource SectionHeader}"
                   FontSize="20" Margin="0,0,0,14"/>

        <!-- Range, source and anything that stopped the history being read -->
        <Border Grid.Row="1" Style="{StaticResource KpiCard}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Show:" Style="{StaticResource ToolbarLabel}"/>
                    <ComboBox x:Name="CmbRange" Width="190" Style="{StaticResource ToolbarCombo}"
                              SelectionChanged="CmbRange_SelectionChanged"
                              ToolTip="Deadlocks reported in this period, ending now. system_health rolls over its files, so how far back it reaches depends on how busy the server is."/>
                    <Button x:Name="BtnReload" Content="↻ Read again" Style="{StaticResource RefreshButton}" Padding="12,4"
                            ToolTip="Read system_health again for deadlocks since this page opened."
                            Click="BtnReload_Click"/>
                </WrapPanel>
                <TextBlock x:Name="TxtProblem" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- ── Every deadlock, newest first ───────────────────────── -->
            <TabItem x:Name="TabDeadlocks" Header="Deadlocks">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.4*" MinHeight="200"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource KpiCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=DeadlocksGrid}"/>
                                <TextBlock x:Name="TxtCount" Text="Deadlocks" Style="{StaticResource SectionHeader}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid>
                                <DataGrid x:Name="DeadlocksGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                          SelectionMode="Single" SelectionChanged="DeadlocksGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="130">
                                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="When the deadlock monitor found it and chose the victim, on this PC's clock."/></Style></DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Victim" Binding="{Binding VictimText}" Width="230" ElementStyle="{StaticResource VictimText}">
                                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The session SQL Server rolled back (error 1205): SPID, login and the procedure or statement it was running."/></Style></DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Other participants" Binding="{Binding OthersText}" Width="230" ElementStyle="{StaticResource SingleLineText}">
                                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The sessions that went on: they got the locks the victim held."/></Style></DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Objects" Binding="{Binding ObjectsText}" Width="230" ElementStyle="{StaticResource SingleLineText}">
                                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The tables (and indexes) whose locks they fought over."/></Style></DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Database" Binding="{Binding DatabasesText}" Width="100" ElementStyle="{StaticResource SingleLineText}"/>
                                        <DataGridTextColumn Header="Seen" Binding="{Binding TimesSeen, StringFormat='×{0}'}" Width="56" ElementStyle="{StaticResource TimesSeen}" SortMemberPath="TimesSeen">
                                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Deadlocks in the range with the same pattern: the same objects and the same code. See the Recurring tab."/></Style></DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Victim statement" Binding="{Binding VictimStatement}" Width="*" MinWidth="200" ElementStyle="{StaticResource SingleLineText}">
                                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="First line of the statement that was rolled back."/></Style></DataGridTextColumn.HeaderStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtNoData" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"
                                           Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,40,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  Background="{StaticResource Border}" Margin="0,4"/>

                    <!-- ── The selected deadlock ──────────────────────────── -->
                    <Border Grid.Row="2" Style="{StaticResource KpiCard}">
                        <Grid x:Name="DetailPanel" IsEnabled="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="70"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="90"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnCopyXml" Content="Copy XML" Style="{StaticResource SmallButton}"
                                            Click="BtnCopyXml_Click" ToolTip="Copy the deadlock report's XML."/>
                                    <Button x:Name="BtnSaveXdl" Content="Save as .xdl…" Style="{StaticResource SmallButton}"
                                            Click="BtnSaveXdl_Click"
                                            ToolTip="Save the deadlock graph. Open the file in SSMS (File → Open) to see it drawn."/>
                                </StackPanel>
                                <TextBlock x:Name="TxtDetailHeader" Text="Select a deadlock above to see who took part."
                                           Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Text="Participants" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                            <DataGrid x:Name="ProcessesGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      SelectionMode="Single" SelectionChanged="ProcessesGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="56" ElementStyle="{StaticResource RoleText}"/>
                                    <DataGridTextColumn Header="SPID" Binding="{Binding SessionText}" Width="72"/>
                                    <DataGridTextColumn Header="Login" Binding="{Binding LoginName}" Width="110" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="90" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Application" Binding="{Binding ClientApp}" Width="120" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="90" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Procedure / statement" Binding="{Binding CodeText}" Width="200" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Waiting for" Binding="{Binding WaitingFor}" Width="200" ElementStyle="{StaticResource SingleLineText}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The lock it asked for (mode on object) and couldn't get."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Holding" Binding="{Binding Holding}" Width="200" ElementStyle="{StaticResource SingleLineText}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The lock it held that another participant was waiting for."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Wait ms" Binding="{Binding WaitTimeMs, StringFormat=N0}" Width="70" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="Isolation" Binding="{Binding IsolationLevel}" Width="130" ElementStyle="{StaticResource SingleLineText}"/>
                                    <DataGridTextColumn Header="Tran count" Binding="{Binding TranCount}" Width="75" ElementStyle="{StaticResource Number}">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Open transactions (@@TRANCOUNT). More than 1 often means a transaction started by the caller."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Wait resource" Binding="{Binding WaitResource}" Width="200" ElementStyle="{StaticResource SingleLineText}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="3" Text="Resources and the statement of the selected participant"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,4"/>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <DataGrid x:Name="ResourcesGrid" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
                                        <DataGridTextColumn Header="Object" Binding="{Binding ObjectText}" Width="*" MinWidth="140" ElementStyle="{StaticResource SingleLineText}"/>
                                        <DataGridTextColumn Header="Held by" Binding="{Binding OwnersText}" Width="100" ElementStyle="{StaticResource SingleLineText}"/>
                                        <DataGridTextColumn Header="Wanted by" Binding="{Binding WaitersText}" Width="100" ElementStyle="{StaticResource SingleLineText}"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="140" ElementStyle="{StaticResource SingleLineText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                              Background="{StaticResource Border}" Margin="4,0"/>

                                <TextBox x:Name="TxtStatement" Grid.Column="2"
                                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource BgDeep}" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource Border}" BorderThickness="1"
                                         FontFamily="Consolas" FontSize="11" Padding="6"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── The same deadlock again and again ─────────────────── -->
            <TabItem x:Name="TabRecurring" Header="Recurring">
                <Border Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=PatternsGrid}"/>
                            <TextBlock x:Name="TxtPatternCount" Text="Deadlock patterns" Style="{StaticResource SectionHeader}"
                                       Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,8"
                                   Text="Deadlocks on the same objects by the same code count as one pattern, the most frequent first. Fix the top one first: it keeps coming back. Double-click a row to open its newest deadlock."/>
                        <DataGrid x:Name="PatternsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" MouseDoubleClick="PatternsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Deadlocks" Binding="{Binding Count, StringFormat=N0}" Width="80" ElementStyle="{StaticResource Number}"/>
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="130"/>
                                <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="130"/>
                                <DataGridTextColumn Header="Objects" Binding="{Binding Objects}" Width="260" ElementStyle="{StaticResource SingleLineText}"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*" MinWidth="240" ElementStyle="{StaticResource SingleLineText}">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The procedures that took part, or the statements when they ran outside one (ad hoc statements count as the same whatever their values)."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="110" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Open newest" Tag="{Binding}" Click="OpenNewest_Click"
                                                    Style="{StaticResource RefreshButton}" Padding="8,3" FontSize="11" Margin="2,1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
