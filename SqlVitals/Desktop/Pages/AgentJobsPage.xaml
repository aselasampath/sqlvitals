<Page x:Class="SqlVitals.Desktop.Pages.AgentJobsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="SQL Agent Jobs">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxHeight" Value="18"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- Failed in red and running long in amber: the two a DBA has to act on. -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="ToolTip" Value="{Binding StatusDetail}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="RunningLong">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NeverRun">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="JobName" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LastOutcome" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastRunFailed}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Duration" TargetType="TextBlock" BasedOn="{StaticResource Number}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunningLong}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <!-- Runs and steps: failed ones in red. -->
        <Style x:Key="RunOutcome" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- The page template (#150): the verdict on failed and long-running jobs first; where they
         were read from folds to one line; then every job, and the selected job's runs and steps. The
         job's details and the step's full message are in the drawer. Bound to AgentJobsViewModel (#186). -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="SQL Agent Jobs" PageKey="AgentJobs">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnReload" Content="↻ Read again" Style="{StaticResource RefreshButton}" Padding="12,4"
                        ToolTip="Read the jobs from msdb again."
                        Command="{Binding RefreshCommand}"/>
                <CheckBox x:Name="ChkAutoRefresh" Content="Every 30 s" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"
                          VerticalAlignment="Center" Margin="14,0,0,0" FontFamily="Segoe UI" FontSize="12"
                          ToolTip="Read the jobs again every 30 seconds while this page is open, to watch running jobs."
                          IsChecked="{Binding AutoRefresh}"/>
            </StackPanel>
        </controls:PageShell.Actions>

        <controls:PageShell.Sections>
            <!-- Agent's state, the times, and anything that makes the list less than it seems -->
            <controls:FoldSection x:Name="SourceSection" Key="source" Header="SQL Server Agent" FoldedSummary="{Binding SourceSummary}">
                <StackPanel>
                    <TextBlock x:Name="TxtProblem" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,0,0,6"
                               TextWrapping="Wrap" Text="{Binding Problem}" Visibility="{Binding ShowsProblem, Converter={StaticResource Visible}}"/>
                    <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextMuted}" FontSize="12"
                               TextWrapping="Wrap" Text="{Binding ReadNote}"/>
                </StackPanel>
            </controls:FoldSection>
        </controls:PageShell.Sections>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.2*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- ── Every job, the ones to act on first ───────────────────── -->
            <Border Grid.Row="0" Style="{StaticResource KpiCard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <controls:GridFilterBox x:Name="JobsFilter" DockPanel.Dock="Right" Target="{Binding ElementName=JobsGrid}"/>
                        <ComboBox x:Name="CmbFilter" DockPanel.Dock="Right" Width="250" Style="{StaticResource ToolbarCombo}" Margin="0,0,10,0"
                                  ItemsSource="{Binding FilterNames}" SelectedIndex="{Binding FilterIndex}" ToolTip="Which jobs to list"/>
                        <TextBlock x:Name="TxtCount" Text="{Binding CountText}" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="108" SortMemberPath="Status" ElementStyle="{StaticResource StatusText}">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Running long: running now for more than a minute past its average successful run. Failed: its last run failed. Sorted with these first."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Job" Binding="{Binding Name}" Width="210" ElementStyle="{StaticResource JobName}"/>
                                <DataGridTextColumn Header="Last run" Binding="{Binding LastRunStart, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="When the last finished run started, in the server's time."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Last outcome" Binding="{Binding LastOutcomeText}" Width="98" ElementStyle="{StaticResource LastOutcome}"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80" SortMemberPath="Duration" ElementStyle="{StaticResource Duration}">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="How long it has been running so far, or how long its last run took (h:mm:ss)."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="78" SortMemberPath="AverageDuration" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average duration of its successful runs that msdb's job history still keeps."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="vs avg" Binding="{Binding RatioText}" Width="64" SortMemberPath="Ratio" ElementStyle="{StaticResource Duration}">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Duration divided by the average: ×2.0 took twice as long as usual."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Next run" Binding="{Binding NextRunText}" Width="170" SortMemberPath="NextRun" ElementStyle="{StaticResource SingleLineText}">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="When its enabled schedules run it next, in the server's time. (due): the time has passed and it hasn't started, e.g. because SQL Server Agent is stopped."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledText}" Width="74"/>
                                <DataGridTextColumn Header="Failed runs" Binding="{Binding FailuresText}" Width="88" SortMemberPath="FailedRuns" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Failed runs out of all the runs msdb still keeps. msdb trims its job history (by default to 100 rows per job), so this covers recent runs only."/></Style></DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" ElementStyle="{StaticResource Muted}"/>
                                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerText}" Width="100" SortMemberPath="Owner" ElementStyle="{StaticResource Muted}"/>
                                <DataGridTextColumn Header="Last message" Binding="{Binding LastMessage}" Width="*" MinWidth="150" ElementStyle="{StaticResource SingleLineText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TxtNoData" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"
                                   Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,40,0,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   IsHitTestVisible="False" Text="{Binding NoDataText}"
                                   Visibility="{Binding ShowsNoData, Converter={StaticResource Visible}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}" Margin="0,4"/>

            <!-- ── The selected job's runs and their steps; its details and the step's message in the drawer ── -->
            <Border Grid.Row="2" Style="{StaticResource KpiCard}">
                <Grid x:Name="DetailPanel" IsEnabled="{Binding HasJob}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="70"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtDetailHeader" Text="{Binding DetailHeader}"
                                   Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtDetailSub" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Text="{Binding RunsProblem}" Visibility="{Binding ShowsRunsProblem, Converter={StaticResource Visible}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="TxtRunsLabel" Text="{Binding RunsLabel}"
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                    <DataGrid x:Name="RunsGrid" Grid.Row="2" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Started" Binding="{Binding Start, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="90" ElementStyle="{StaticResource RunOutcome}"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="72" SortMemberPath="Duration" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Detail}" Width="*" MinWidth="240" ElementStyle="{StaticResource SingleLineText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="For a failed run, the step that failed and its error; otherwise the job's own message."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="Steps of the selected run; the selected step's full message is in the drawer"
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,4"/>
                    <DataGrid x:Name="StepsGrid" Grid.Row="4" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Step" Binding="{Binding StepId}" Width="44" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding StepName}" Width="170" ElementStyle="{StaticResource SingleLineText}"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="80" ElementStyle="{StaticResource RunOutcome}"/>
                            <DataGridTextColumn Header="Started" Binding="{Binding Start, StringFormat='HH:mm:ss'}" Width="64"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="72" SortMemberPath="Duration" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="160" ElementStyle="{StaticResource SingleLineText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </controls:PageShell>
</Page>