<Page x:Class="SqlVitals.Desktop.Pages.QueryStorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Query Store">
    <Page.Resources>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <!-- The statement on one line; the whole statement in the tooltip. -->
        <Style x:Key="QueryText" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="ToolTip" Value="{Binding QueryTextTip}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- More than one plan in the period: often a plan change worth a look in Query details. -->
        <Style x:Key="PlansNumber" TargetType="TextBlock" BasedOn="{StaticResource Number}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSeveralPlans}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FailedNumber" TargetType="TextBlock" BasedOn="{StaticResource Number}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FailedExecutions}" Value="0">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SeverityText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="OK">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarningRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="#1FF59E0B"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#337C3AED"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ToolbarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style x:Key="TabStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource RefreshButton}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ViewPlanCell">
            <Button Content="View Plan" Tag="{Binding}" Click="ViewPlan_Click" Style="{StaticResource RowButton}"
                    ToolTip="The plan this query used most in the period, drawn like SSMS."/>
        </DataTemplate>
    </Page.Resources>

    <!-- The page template (#146): the verdict on regressed queries first, the health cards folding
         to one line, then the period and the reports. -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="Query Store" PageKey="QueryStore">
        <controls:PageShell.Actions>
            <Button Content="🐢 Regressed queries" Style="{StaticResource LinkButton}"
                    VerticalAlignment="Center" Click="BtnRegressions_Click"
                    ToolTip="Open Query Regressions: queries that got slower, recent period against a baseline, for this database."/>
        </controls:PageShell.Actions>

        <controls:PageShell.Sections>
        <controls:FoldSection x:Name="HealthSection" Key="health" Header="Health and settings">
        <StackPanel>
        <!-- Health and settings cards -->
        <WrapPanel x:Name="HealthPanel"/>

        <!-- Settings checks: why, and the fix to copy -->
        <ItemsControl x:Name="ChecksList" Margin="0,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="⧉ Copy fix" Tag="{Binding}" Click="CopyFix_Click"
                                Padding="8,1" FontSize="11" Margin="8,0,0,0"
                                ToolTip="{Binding Fix}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Fix}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LevelText}" Width="62" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelText}" Value="Warning">
                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimary}" ToolTip="{Binding Reason}">
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Reason, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
        </controls:FoldSection>
        </controls:PageShell.Sections>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="260"/>
        </Grid.RowDefinitions>

        <!-- Period, how far back the data goes, and a query by ID -->
        <Border Grid.Row="0" Style="{StaticResource KpiCard}" Margin="0,0,0,10" Padding="12,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Query ID:" Style="{StaticResource ToolbarLabel}"/>
                        <TextBox x:Name="TxtQueryId" Width="90" Style="{StaticResource ToolbarBox}" KeyDown="TxtQueryId_KeyDown"
                                 ToolTip="Any Query Store query ID, e.g. one from an SSMS report or a colleague's message. Enter opens its details."/>
                        <Button Content="Open details" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="6,0,0,0"
                                Click="BtnOpenQuery_Click" ToolTip="Open the Query details window for this query ID."/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Left" Text="Period:" Style="{StaticResource ToolbarLabel}"/>
                    <ComboBox DockPanel.Dock="Left" x:Name="CmbPeriod" Width="130" Style="{StaticResource ToolbarCombo}"
                              SelectionChanged="CmbPeriod_SelectionChanged"
                              ToolTip="What every tab but Forced Plans reads, on the server's clock, in whole Query Store intervals."/>
                    <StackPanel DockPanel.Dock="Left" x:Name="CustomPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,16,0">
                        <TextBlock Text="From" Style="{StaticResource ToolbarLabel}"/>
                        <DatePicker x:Name="FromDate" Height="26" Width="115" FontSize="11"/>
                        <TextBox x:Name="FromTime" Width="50" Margin="4,0,10,0" Style="{StaticResource ToolbarBox}" KeyDown="CustomTime_KeyDown"
                                 ToolTip="Time on this PC's clock, 24-hour, e.g. 09:30"/>
                        <TextBlock Text="to" Style="{StaticResource ToolbarLabel}"/>
                        <DatePicker x:Name="ToDate" Height="26" Width="115" FontSize="11"/>
                        <TextBox x:Name="ToTime" Width="50" Margin="4,0,10,0" Style="{StaticResource ToolbarBox}" KeyDown="CustomTime_KeyDown"
                                 ToolTip="Time on this PC's clock, 24-hour, e.g. 17:05"/>
                        <Button Content="Show" Style="{StaticResource RefreshButton}" Padding="12,3" Click="BtnApplyCustom_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtDataFrom" Style="{StaticResource TabStatus}"/>
                </DockPanel>
                <TextBlock x:Name="TxtPeriodError" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0"
                    SelectionChanged="Tabs_SelectionChanged">

            <!-- ── Top Queries (SSMS: Top Resource Consuming Queries) ──────── -->
            <TabItem x:Name="TabTop" Header="Top Queries">
                <Border Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=TopGrid}"/>
                            <WrapPanel>
                                <TextBlock Text="Rank by:" Style="{StaticResource ToolbarLabel}"/>
                                <ComboBox x:Name="CmbRank" Width="120" Style="{StaticResource ToolbarCombo}" SelectionChanged="TopChoice_SelectionChanged"
                                          ToolTip="What makes a query heavy. Log used and TempDB used need SQL Server 2017 or later."/>
                                <TextBlock Text="Statistic:" Style="{StaticResource ToolbarLabel}"/>
                                <ComboBox x:Name="CmbStatistic" Width="90" Style="{StaticResource ToolbarCombo}" SelectionChanged="TopChoice_SelectionChanged"
                                          ToolTip="Total: the query's whole cost in the period. Average: per execution. Max: its worst execution. Std dev: how much executions differ."/>
                                <TextBlock Text="Show:" Style="{StaticResource ToolbarLabel}"/>
                                <ComboBox x:Name="CmbTop" Width="70" Style="{StaticResource ToolbarCombo}" SelectionChanged="TopChoice_SelectionChanged"/>
                                <TextBlock x:Name="TxtTopStatus" Style="{StaticResource TabStatus}"/>
                            </WrapPanel>
                        </DockPanel>
                        <controls:ScriptNotice DockPanel.Dock="Top" x:Name="TopNotice"/>
                        <DataGrid x:Name="TopGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding QueryId}" Width="70" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Query ID" ToolTip="Query Store's query_id, as in SSMS's reports. Double-click a row for its history and plans."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ObjectText}" Width="140" ElementStyle="{StaticResource SingleLineText}">
                                    <DataGridTextColumn.Header><TextBlock Text="Object" ToolTip="The procedure, function or trigger the statement is in, or ad hoc."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Plans}" Width="50" ElementStyle="{StaticResource PlansNumber}">
                                    <DataGridTextColumn.Header><TextBlock Text="Plans" ToolTip="Plans the query used in the period. Highlighted when more than one: compare them in Query details."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Executions, StringFormat=N0}" Width="85" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Executions" ToolTip="Executions in the period, over all its plans."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn x:Name="ColMetric" Binding="{Binding MetricValue, StringFormat=N1}" Width="120" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock x:Name="TxtMetricHeader" Text="Total CPU ms" FontWeight="SemiBold" ToolTip="What the list is ranked by."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn x:Name="ColTotalCpu" Binding="{Binding TotalCpuMs, StringFormat=N0}" Width="95" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Total CPU ms" ToolTip="CPU time of every execution in the period, in milliseconds."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding AvgDurationMs, StringFormat=N1}" Width="105" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Avg duration ms" ToolTip="Wall-clock time per execution: what users wait. High duration with low CPU usually means waiting (see the Waits tab)."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding TotalLogicalReads, StringFormat=N0}" Width="100" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Total reads" ToolTip="Logical reads (8 KB pages) of every execution in the period. Missing indexes usually show here."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding FailedExecutions, StringFormat=N0}" Width="60" ElementStyle="{StaticResource FailedNumber}">
                                    <DataGridTextColumn.Header><TextBlock Text="Failed" ToolTip="Aborted executions (usually a client timeout) plus those ended by an error."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ForcedText}" Width="80" ElementStyle="{StaticResource SingleLineText}">
                                    <DataGridTextColumn.Header><TextBlock Text="Forced plan" ToolTip="The plan forced for this query, if any. See the Forced Plans tab."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding LastExecutionLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="115">
                                    <DataGridTextColumn.Header><TextBlock Text="Last executed" ToolTip="When it last ran in the period, on this PC's clock."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Severity}" Width="65" ElementStyle="{StaticResource SeverityText}">
                                    <DataGridTextColumn.Header><TextBlock Text="Status" ToolTip="By total CPU in the period, whatever the list is ranked by: Critical over 60 s, Warning over 10 s, Info below."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="88" CanUserSort="False" CellTemplate="{StaticResource ViewPlanCell}"/>
                                <DataGridTextColumn Binding="{Binding QueryTextLine}" Width="*" MinWidth="220" ElementStyle="{StaticResource QueryText}">
                                    <DataGridTextColumn.Header><TextBlock Text="Query text" ToolTip="The statement on one line; hover for all of it. Type part of it in the filter box to find a query."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ── Over Time (SSMS: Overall Resource Consumption) ──────────── -->
            <TabItem x:Name="TabOverTime" Header="Over Time">
                <Border Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Charts:" Style="{StaticResource ToolbarLabel}"/>
                            <ItemsControl x:Name="ChartMetricsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,12,0" FontSize="12"
                                                  Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                                  Checked="ChartMetric_Changed" Unchecked="ChartMetric_Changed"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="TxtOverTimeStatus" Style="{StaticResource TabStatus}" Margin="0,0,0,6"/>
                        <controls:ScriptNotice DockPanel.Dock="Top" x:Name="OverTimeNotice"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChartsPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ── High Variation (SSMS: Queries With High Variation) ─────── -->
            <TabItem x:Name="TabVariation" Header="High Variation">
                <Border Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=VariationGrid}"/>
                            <WrapPanel>
                                <TextBlock Text="Metric:" Style="{StaticResource ToolbarLabel}"/>
                                <ComboBox x:Name="CmbVariationMetric" Width="120" Style="{StaticResource ToolbarCombo}"
                                          SelectionChanged="CmbVariationMetric_SelectionChanged"/>
                                <TextBlock x:Name="TxtVariationStatus" Style="{StaticResource TabStatus}"/>
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TabStatus}" Margin="0,0,0,8"
                                   Text="High variation with more than one plan often means the plan suits some parameter values and not others (parameter sniffing). Compare the plans in Query details."/>
                        <controls:ScriptNotice DockPanel.Dock="Top" x:Name="VariationNotice"/>
                        <DataGrid x:Name="VariationGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding QueryId}" Width="70" ElementStyle="{StaticResource Number}" Header="Query ID"/>
                                <DataGridTextColumn x:Name="ColVarAvg" Binding="{Binding Avg, StringFormat=N1}" Width="90" ElementStyle="{StaticResource Number}" Header="Avg"/>
                                <DataGridTextColumn x:Name="ColVarMin" Binding="{Binding Min, StringFormat=N1}" Width="90" ElementStyle="{StaticResource Number}" Header="Min"/>
                                <DataGridTextColumn x:Name="ColVarMax" Binding="{Binding Max, StringFormat=N1}" Width="90" ElementStyle="{StaticResource Number}" Header="Max"/>
                                <DataGridTextColumn x:Name="ColVarStdDev" Binding="{Binding StdDev, StringFormat=N1}" Width="95" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Std dev" FontWeight="SemiBold" ToolTip="The std dev of all its executions in the period, over every interval and plan. The list is ranked by it, as in SSMS."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Variation, StringFormat='{}{0:0.0}×'}" Width="75" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Variation" ToolTip="Std dev ÷ avg. 3.2× means executions typically differ by more than three times the average."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Plans}" Width="50" ElementStyle="{StaticResource PlansNumber}" Header="Plans"/>
                                <DataGridTextColumn Binding="{Binding Executions, StringFormat=N0}" Width="85" ElementStyle="{StaticResource Number}" Header="Executions"/>
                                <DataGridTextColumn Binding="{Binding ObjectText}" Width="140" ElementStyle="{StaticResource SingleLineText}" Header="Object"/>
                                <DataGridTemplateColumn Header="" Width="88" CanUserSort="False" CellTemplate="{StaticResource ViewPlanCell}"/>
                                <DataGridTextColumn Binding="{Binding QueryTextLine}" Width="*" MinWidth="220" ElementStyle="{StaticResource QueryText}" Header="Query text"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ── Waits (SSMS: Query Wait Statistics) ─────────────────────── -->
            <TabItem x:Name="TabWaits" Header="Waits">
                <Border Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MaxHeight="280"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TxtWaitsStatus" Style="{StaticResource TabStatus}" Margin="0,0,0,6"/>
                        <controls:ScriptNotice Grid.Row="1" x:Name="WaitsNotice"/>
                        <ListBox Grid.Row="2" x:Name="WaitCategoriesList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="WaitCategoriesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Explanation}" Cursor="Hand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category.Name}" Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding FillWidth}"/>
                                                <ColumnDefinition Width="{Binding RestWidth}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Height="14" CornerRadius="2" Background="{StaticResource Accent}" MinWidth="2"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <DockPanel Grid.Row="3" Margin="0,10,0,6">
                            <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=WaitQueriesGrid}"/>
                            <TextBlock x:Name="TxtWaitQueriesHeader" Text="Click a wait category to see the queries that waited on it."
                                       Style="{StaticResource TabStatus}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="4" x:Name="WaitQueriesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding QueryId}" Width="70" ElementStyle="{StaticResource Number}" Header="Query ID"/>
                                <DataGridTextColumn Binding="{Binding ObjectText}" Width="140" ElementStyle="{StaticResource SingleLineText}" Header="Object"/>
                                <DataGridTextColumn Binding="{Binding WaitMs, StringFormat=N0}" Width="100" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Total wait ms" FontWeight="SemiBold" ToolTip="Time this query spent waiting in the category in the period."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding AvgWaitMs, StringFormat=N1}" Width="95" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Avg wait ms" ToolTip="Total wait ÷ the query's executions in the period."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Executions, StringFormat=N0}" Width="85" ElementStyle="{StaticResource Number}" Header="Executions"/>
                                <DataGridTextColumn Binding="{Binding PctOfCategory, StringFormat='{}{0:N1} %'}" Width="90" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="% of category" ToolTip="This query's share of all the category's wait time in the period."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="88" CanUserSort="False" CellTemplate="{StaticResource ViewPlanCell}"/>
                                <DataGridTextColumn Binding="{Binding QueryTextLine}" Width="*" MinWidth="220" ElementStyle="{StaticResource QueryText}" Header="Query text"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ── Forced Plans (SSMS: Queries With Forced Plans) ─────────── -->
            <TabItem x:Name="TabForced" Header="Forced Plans">
                <Border Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MaxHeight="220"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=ForcedGrid}"/>
                            <TextBlock x:Name="TxtForcedStatus" Style="{StaticResource TabStatus}"/>
                        </DockPanel>
                        <controls:ScriptNotice Grid.Row="1" x:Name="ForcedNotice"/>
                        <DataGrid Grid.Row="2" x:Name="ForcedGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick" RowStyle="{StaticResource WarningRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding QueryId}" Width="70" ElementStyle="{StaticResource Number}" Header="Query ID"/>
                                <DataGridTextColumn Binding="{Binding PlanId}" Width="65" ElementStyle="{StaticResource Number}" Header="Plan ID"/>
                                <DataGridTextColumn Binding="{Binding ObjectText}" Width="130" ElementStyle="{StaticResource SingleLineText}" Header="Object"/>
                                <DataGridTextColumn Binding="{Binding ForcedBy}" Width="120" ElementStyle="{StaticResource SingleLineText}">
                                    <DataGridTextColumn.Header><TextBlock Text="Forced by" ToolTip="Manual: sp_query_store_force_plan. Automatic plan correction: automatic tuning (FORCE_LAST_GOOD_PLAN), SQL Server 2017+ and Azure SQL."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ForceFailures, StringFormat=N0}" Width="75" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Failures" ToolTip="Times forcing this plan failed since it was forced. While it fails, the query runs with whatever plan the optimizer picks."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding LastFailureText}" Width="140" ElementStyle="{StaticResource SingleLineText}">
                                    <DataGridTextColumn.Header><TextBlock Text="Last failure reason" ToolTip="E.g. NO_INDEX: an index the plan uses was dropped or disabled."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding LastExecutionLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="115">
                                    <DataGridTextColumn.Header><TextBlock Text="Last executed" ToolTip="When this plan last ran, on this PC's clock."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Executions, StringFormat=N0}" Width="85" ElementStyle="{StaticResource Number}">
                                    <DataGridTextColumn.Header><TextBlock Text="Executions" ToolTip="Executions of this plan in the period. Far fewer than the query's (see Query details) means forcing isn't taking."/></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding AvgDurationMs, StringFormat=N1}" Width="105" ElementStyle="{StaticResource Number}" Header="Avg duration ms"/>
                                <DataGridTextColumn Binding="{Binding Severity}" Width="65" ElementStyle="{StaticResource SeverityText}" Header="Status"/>
                                <DataGridTemplateColumn Header="" Width="185" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="View Plan" Tag="{Binding}" Click="ViewPlan_Click" Style="{StaticResource RowButton}"
                                                        ToolTip="The forced plan, drawn like SSMS."/>
                                                <Button Content="Copy unforce" Tag="{Binding}" Click="CopyUnforce_Click" Style="{StaticResource RowButton}"
                                                        ToolTip="Copy EXEC sys.sp_query_store_unforce_plan for this plan. SqlVitals never forces or unforces a plan itself."/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding QueryTextLine}" Width="*" MinWidth="200" ElementStyle="{StaticResource QueryText}" Header="Query text"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="3" x:Name="TxtHintsHeader" Text="Query Store hints" Style="{StaticResource SectionHeader}"
                                   Margin="0,12,0,6" Visibility="Collapsed"
                                   ToolTip="Hints set with sys.sp_query_store_set_hints, or by the system (SQL Server 2022+ and Azure SQL)."/>
                        <controls:ScriptNotice Grid.Row="4" x:Name="HintsNotice"/>
                        <DataGrid Grid.Row="5" x:Name="HintsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding QueryId}" Width="70" ElementStyle="{StaticResource Number}" Header="Query ID"/>
                                <DataGridTextColumn Binding="{Binding HintText}" Width="220" ElementStyle="{StaticResource SingleLineText}" Header="Hint"/>
                                <DataGridTextColumn Binding="{Binding Source}" Width="110" ElementStyle="{StaticResource SingleLineText}" Header="Source"/>
                                <DataGridTextColumn Binding="{Binding Failures, StringFormat=N0}" Width="70" ElementStyle="{StaticResource Number}" Header="Failures"/>
                                <DataGridTextColumn Binding="{Binding LastFailureText}" Width="160" ElementStyle="{StaticResource SingleLineText}" Header="Last failure reason"/>
                                <DataGridTextColumn Binding="{Binding QueryTextLine}" Width="*" MinWidth="200" ElementStyle="{StaticResource QueryText}" Header="Query text"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
    </controls:PageShell>
</Page>
