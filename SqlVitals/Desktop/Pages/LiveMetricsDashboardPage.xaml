<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      xmlns:helpers="clr-namespace:SqlVitals.Desktop.Helpers"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="SqlVitals.Desktop.Pages.LiveMetricsDashboardPage"
      Title="Live charts">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <helpers:HealthBrush x:Key="Health"/>
    <!-- Chart toggle chip button -->
    <Style x:Key="ChipButton" TargetType="{x:Type ToggleButton}">
      <Setter Property="Height"          Value="24"/>
      <Setter Property="Padding"         Value="10,0"/>
      <Setter Property="Margin"          Value="0,0,6,0"/>
      <Setter Property="FontFamily"      Value="Segoe UI"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Panel close [x] button -->
    <Style x:Key="CloseButton" TargetType="{x:Type Button}">
      <Setter Property="Width"           Value="18"/>
      <Setter Property="Height"          Value="18"/>
      <Setter Property="Padding"         Value="0"/>
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground"      Value="#88AABB"/>
      <Setter Property="FontFamily"      Value="Segoe UI"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="VerticalContentAlignment"   Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#44FF4444"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <Page.Background>
    <StaticResource ResourceKey="BgDeep"/>
  </Page.Background>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <!-- toolbar -->
      <RowDefinition Height="Auto"/>
      <!-- monitoring is off -->
      <RowDefinition Height="Auto"/>
      <!-- chart chips -->
      <RowDefinition Height="2*"/>
      <!-- chart grid -->
    </Grid.RowDefinitions>

    <!-- ?? Toolbar ???????????????????????????????????????????????? -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Live charts" DockPanel.Dock="Left"
                       Style="{StaticResource SectionHeader}" FontSize="20"
                       VerticalAlignment="Center" Margin="0,0,0,0"/>
      <!-- Health score of the latest sample (#36); click for the checks that lowered it -->
      <Button x:Name="BtnHealthScore" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center"
              Cursor="Hand" Command="{Binding ShowBreakdownCommand}" AutomationProperties.Name="Health score"
              ToolTip="{Binding HealthToolTip}"
              BorderBrush="{Binding HealthLevel, Converter={StaticResource Health}, FallbackValue={StaticResource HealthNone}}">
        <Button.Style>
          <Style TargetType="{x:Type Button}">
            <Style.Triggers>
              <!-- Not monitored: no score now -->
              <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Button.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" Background="{DynamicResource BgCard}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1.5" CornerRadius="13" Padding="10,2" Height="26">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderThickness" Value="2.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <TextBlock FontFamily="Segoe UI" VerticalAlignment="Center">
          <Run Text="Health" FontSize="11" Foreground="{DynamicResource TextMuted}"/><Run
               Text=" "/><Run x:Name="RunHealthScore" Text="{Binding HealthScoreText, Mode=OneWay}" FontSize="14" FontWeight="Bold"
               Foreground="{Binding HealthLevel, Mode=OneWay, Converter={StaticResource Health}, FallbackValue={StaticResource HealthNone}}"/><Run
               Text=" / 100" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
        </TextBlock>
      </Button>
      <Popup x:Name="HealthScorePopup" PlacementTarget="{Binding ElementName=BtnHealthScore}"
             Placement="Bottom" VerticalOffset="6" StaysOpen="False"
             AllowsTransparency="True" PopupAnimation="Fade">
        <controls:HealthScoreBreakdown x:Name="HealthScoreDetails"/>
      </Popup>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
        <!-- Range: live, or a past range from the monitoring history; and the baseline. Moved
             to the top bar when the page opens (#140), with the sample interval. -->
        <controls:TimeRangePicker x:Name="RangePicker" Margin="0,0,16,0" RangeChanged="RangePicker_RangeChanged"
                                  BaselineChanged="RangePicker_BaselineChanged"/>
        <!-- Sample every: collection (and recording) continues while a past range is shown -->
        <ComboBox x:Name="CmbInterval" Width="110" Height="26"
                          Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}"
                          FontFamily="Segoe UI" FontSize="12"
                          AutomationProperties.Name="Sample every"
                          ToolTip="How often this connection is sampled. Collection and recording carry on in the background, also while a past range is shown."
                          ItemsSource="{Binding IntervalNames}" SelectedIndex="{Binding IntervalIndex}">
          <ComboBox.ItemContainerStyle>
            <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource DarkComboItem}"/>
          </ComboBox.ItemContainerStyle>
        </ComboBox>
        <!-- Starts or stops monitoring this connection (#115); the same as ▶ / ■ in the selector -->
        <Button x:Name="BtnMonitor" Content="{Binding MonitorText}" Height="26" MinWidth="130"
                Margin="6,0,0,0" Padding="10,0"
                Style="{StaticResource SecondaryButton}" FontSize="11"
                Command="{Binding ToggleMonitoringCommand}" IsEnabled="{Binding CanStart}"
                ToolTip="{Binding MonitorToolTip}" AutomationProperties.Name="{Binding MonitorName}"
                ToolTipService.ShowOnDisabled="True"/>
        <!-- Countdown -->
        <Border Margin="8,0,0,0" Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="3" Padding="6,0" Height="26" VerticalAlignment="Center">
          <TextBlock x:Name="TxtCountdown" Text="{Binding NextSampleIn}"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Mono" FontSize="11"
                               MinWidth="28" TextAlignment="Center"/>
        </Border>
      </StackPanel>
    </DockPanel>

    <!-- Monitoring is off (#115): nothing is collected; past ranges still show the saved history -->
    <Border x:Name="MonitoringOffBanner" Grid.Row="1" Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="4"
            Padding="14,10" Margin="0,0,0,10" Visibility="{Binding ShowsMonitoringOff, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button x:Name="BtnBannerStart" DockPanel.Dock="Right" VerticalAlignment="Center"
                Style="{StaticResource RefreshButton}" Padding="14,6" Margin="12,0,0,0"
                Content="▶  Start monitoring" ToolTipService.ShowOnDisabled="True"
                Command="{Binding StartMonitoringCommand}" IsEnabled="{Binding CanStart}" ToolTip="{Binding BannerToolTip}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Monitoring is off. SqlVitals isn't collecting anything from this server."
                     Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13"
                     FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock FontFamily="Segoe UI" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}">
            <Run x:Name="TxtMonitoringOffReason" Text="{Binding MonitoringOffReason, Mode=OneWay}"/>
            <Run Text=" Past ranges (1h, 24h, 7d, Custom…) still show the history saved earlier. "/>
            <Hyperlink Command="{Binding OpenMonitoringSettingsCommand}" Foreground="{DynamicResource AccentLight}">Start monitoring automatically…</Hyperlink>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ?? Chart selection chips ?????????????????????????????????? -->
    <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Charts:" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           FontFamily="Segoe UI" FontSize="11"/>
        <ToggleButton x:Name="ChipWaits"      Content="Waits - Stack Area"
                              Tag="Waits"
                              IsChecked="{Binding ShowsWaits}"
                              Background="#1A2A3A" BorderBrush="#4488CC"
                              Foreground="#88CCFF"
                              Style="{StaticResource ChipButton}"/>
        <ToggleButton x:Name="ChipCpu"        Content="CPU Usage"
                              Tag="Cpu"
                              IsChecked="{Binding ShowsCpu}"
                              Background="#2A1A1A" BorderBrush="#CC4444"
                              Foreground="#FF8888"
                              Style="{StaticResource ChipButton}"/>
        <ToggleButton x:Name="ChipThroughput" Content="SQL Throughput"
                              Tag="Throughput"
                              IsChecked="{Binding ShowsThroughput}"
                              Background="#1A2A1A" BorderBrush="#44AA44"
                              Foreground="#88FF88"
                              Style="{StaticResource ChipButton}"/>
        <ToggleButton x:Name="ChipPhysicalIO" Content="Physical R/W"
                              Tag="PhysicalIO"
                              IsChecked="{Binding ShowsPhysicalIo}"
                              Background="#2A2A1A" BorderBrush="#AAAA44"
                              Foreground="#FFFF88"
                              Style="{StaticResource ChipButton}"/>
        <ToggleButton x:Name="ChipMemory"     Content="Memory"
                              Tag="Memory"
                              IsChecked="{Binding ShowsMemory}"
                              Background="#2A1A2A" BorderBrush="#AA44AA"
                              Foreground="#FF88FF"
                              Style="{StaticResource ChipButton}"/>
        <ToggleButton x:Name="ChipProcessMap" Content="Process Map"
                              Tag="ProcessMap"
                              IsChecked="{Binding ShowsProcessMap}"
                              Background="#1A2A2A" BorderBrush="#44AAAA"
                              Foreground="#88FFFF"
                              Style="{StaticResource ChipButton}"/>
        <TextBlock x:Name="TxtHistoryStatus" Foreground="{StaticResource TextMuted}" Text="{Binding HistoryStatus}"
                   VerticalAlignment="Center" Margin="10,0,0,0"
                   FontFamily="Segoe UI" FontSize="11"/>
      </WrapPanel>
    </Border>

        <!-- ?? Chart grid  ???????????????????????????????????????????? -->
        <!-- UniformGrid auto-adjusts columns when panels close -->
        <UniformGrid Grid.Row="3" x:Name="ChartGrid" Columns="2" />
    </Grid>
</Page>
