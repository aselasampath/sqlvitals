<Page x:Class="SqlVitals.Desktop.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:SqlVitals.Desktop.Pages"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Overview">
    <Page.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ChartTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ChartCell" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <!-- Name, status, and what can be done to the connection -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnMonitor" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Monitor_Click"
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="BtnEdit" Content="Edit connection" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Click="Edit_Click" ToolTip="Open this connection in Settings"/>
                    <Button x:Name="BtnMakeActive" Content="Make active" Style="{StaticResource RefreshButton}" Margin="8,0,0,0"
                            Click="MakeActive_Click"
                            ToolTip="Switch every server page to this connection, as opening one of its pages does"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtName" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="StatusChip" CornerRadius="9" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        <Border x:Name="ActiveChip" CornerRadius="9" Padding="10,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                Background="{StaticResource AccentLight}">
                            <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtConnectionLine" Style="{StaticResource Muted}" Margin="22,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxtMissing" Style="{StaticResource Muted}" FontSize="14" Visibility="Collapsed"
                       Text="This connection was removed. Open All servers to see the others."/>

            <StackPanel x:Name="Main">
                <!-- Its active alerts: what is happening, since when, and the evidence -->
                <Border x:Name="AlertsCard" Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                                <Hyperlink Click="AllAlerts_Click" Foreground="{StaticResource Accent}">All alerts</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="TxtAlertsTitle" Text="Active alerts" Style="{StaticResource CardTitle}" Margin="0"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtNoAlerts" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="AlertsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:OverviewAlert}">
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Content="{Binding EvidenceText}" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Click="Evidence_Click"
                                                ToolTip="{Binding EvidenceToolTip}"/>
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Dot}" Margin="0,4,10,0"
                                                 VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Happening}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- When the server can't be reached: why, what to check, and what happened (#130) -->
                <Grid x:Name="OutageRow" Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Border Style="{StaticResource KpiCard}" BorderBrush="{StaticResource Danger}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtOutageTitle" Style="{StaticResource CardTitle}" FontSize="17" Margin="0"/>
                                <TextBlock x:Name="TxtOutageSince" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
                                <Border Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="TxtOutageError" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnRetry" Content="Retry now" Style="{StaticResource RefreshButton}" Click="Retry_Click"
                                            ToolTip="Try to collect a sample now"/>
                                    <Button x:Name="BtnTest" Content="Test connection" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Click="Test_Click" ToolTip="Open a connection to the server with the saved details, and close it"/>
                                    <Button Content="Copy error" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CopyError_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOutageAction" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Things to check" Style="{StaticResource CardTitle}"/>
                                <ItemsControl x:Name="ThingsList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{StaticResource TextMuted}"
                                                         Margin="2,6,8,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="13,4,0,0" FontSize="12">
                                    <Hyperlink Click="Edit_Click" Foreground="{StaticResource Accent}">Edit connection</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Before it went down" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="TxtBefore" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="What happened" Style="{StaticResource CardTitle}"/>
                                <ItemsControl x:Name="Timeline" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pages:DetailLine}">
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="64" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- The score and what is costing it points; the headline numbers; since you last looked -->
                <Grid x:Name="HealthRow" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ScoreCard" Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,16,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Health score" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <!-- The worst state and its reason first, the number second (#173) -->
                            <TextBlock x:Name="TxtLevel" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Margin="0,2,0,4">
                                <Run x:Name="RunScore" FontSize="40" FontWeight="Bold"/><Run
                                     Text=" / 100" FontSize="14" Foreground="{StaticResource TextMuted}"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtContext" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtCoverage" Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="Collapsed"/>

                            <TextBlock x:Name="TxtCostsTitle" Text="What is costing points" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                            <TextBlock x:Name="TxtNoCosts" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <ItemsControl x:Name="CostsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pages:CostRow}">
                                        <StackPanel Margin="0,8,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Points}" Foreground="{Binding Dot}"
                                                           FontSize="13" FontWeight="Bold"/>
                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" Margin="16,2,0,0"/>
                                            <TextBlock Margin="16,2,0,0" FontSize="12">
                                                <Hyperlink Click="CostLink_Click" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                                           ToolTip="{Binding LinkToolTip}">
                                                    <Run Text="{Binding LinkText, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtPassingTitle" Text="Passing" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,14,0,2"/>
                            <ItemsControl x:Name="PassingList" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgDeep}" CornerRadius="9" Padding="8,2" Margin="0,4,6,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}">
                                                <Run Text="✓" Foreground="{StaticResource Success}"/>
                                                <Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Checks with no data: grey, no tick, left out of the score (#173) -->
                            <TextBlock x:Name="TxtUnknownTitle" Text="No data · left out of the score" Style="{StaticResource Muted}" Visibility="Collapsed"
                                       FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <ItemsControl x:Name="UnknownList" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgDeep}" CornerRadius="9" Padding="8,2" Margin="0,4,6,0"
                                                ToolTip="The server didn't report it, so it isn't counted as passing.">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                                <Run Text="?" Foreground="{StaticResource HealthNone}"/>
                                                <Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtThresholds" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0">
                                <Run x:Name="RunThresholds"/>
                                <Hyperlink Click="ChangeThresholds_Click" Foreground="{StaticResource Accent}">Change</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <!-- CPU, batch requests/s, waiting tasks and page life expectancy, with their last few minutes -->
                        <ItemsControl x:Name="HeadlinesList" Focusable="False" Margin="0,0,-12,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:HeadlineTile}">
                                    <Border Style="{StaticResource KpiCard}" Padding="14,10" Margin="0,0,12,12" ToolTip="{Binding ToolTip}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="24" FontWeight="Bold"
                                                       Margin="0,2,0,0"/>
                                            <controls:Sparkline Values="{Binding Trend}" LineBrush="{Binding LineBrush}" Height="30"
                                                                Margin="0,4,0,4"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="BlockingCard" Style="{StaticResource KpiCard}" BorderBrush="{StaticResource Danger}"
                                Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="TxtBlockingFor" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource Danger}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Blocking right now" Style="{StaticResource CardTitle}" Margin="0"/>
                                </DockPanel>
                                <Grid x:Name="BlockingGrid" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Head blocker" Style="{StaticResource Muted}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtHead" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Text="Waiting" Style="{StaticResource Muted}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtWaiting" Style="{StaticResource Body}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Text="Statement" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtStatement" FontFamily="Consolas" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"/>
                                </Grid>
                                <TextBlock x:Name="TxtBlockingNote" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                <TextBlock Margin="0,8,0,0" FontSize="12">
                                    <Hyperlink Click="BlockingChain_Click" Foreground="{StaticResource Accent}" FontWeight="SemiBold">See the blocking chain →</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- What happened since this Overview was last opened -->
                        <Border x:Name="SinceCard" Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="Since you last looked" Style="{StaticResource CardTitle}" Margin="0"/>
                                <TextBlock x:Name="TxtSinceWhen" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                                <ItemsControl x:Name="SinceList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pages:SinceRow}">
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Count}" Foreground="{Binding CountBrush}"
                                                           FontSize="22" FontWeight="Bold" Width="48" VerticalAlignment="Top"/>
                                                <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Top" Margin="12,4,0,0">
                                                    <Hyperlink Click="SinceLink_Click" Foreground="{StaticResource Accent}">
                                                        <Run Text="{Binding LinkText, Mode=OneWay}"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding What}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- The charts over the top bar's time window, with each alert's start marked -->
                <Border x:Name="ChartsCard" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                                <Hyperlink Click="LiveCharts_Click" Foreground="{StaticResource Accent}"
                                           ToolTip="Waits, CPU, throughput, physical I/O, memory and the process map, full size">Full-size live charts →</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="TxtChartsTitle" Text="Charts" Style="{StaticResource CardTitle}" Margin="0"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtChartsNote" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,10"/>
                        <UniformGrid x:Name="ChartsGrid" Columns="3" Margin="0,0,-16,-16">
                            <DockPanel Style="{StaticResource ChartCell}">
                                <TextBlock DockPanel.Dock="Top" Text="Health score" Style="{StaticResource ChartTitle}" Margin="0,0,0,4"/>
                                <controls:ScoreChart x:Name="ChartScore" ShowAxes="True" Height="150"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource ChartCell}">
                                <TextBlock DockPanel.Dock="Top" x:Name="LegendCpu" Style="{StaticResource ChartTitle}" Margin="0,0,0,4"/>
                                <controls:MetricChart x:Name="ChartCpu" Height="150"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource ChartCell}">
                                <TextBlock DockPanel.Dock="Top" x:Name="LegendWaits" Style="{StaticResource ChartTitle}" Margin="0,0,0,4"
                                           TextWrapping="Wrap"/>
                                <controls:MetricChart x:Name="ChartWaits" Height="150"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource ChartCell}">
                                <TextBlock DockPanel.Dock="Top" x:Name="LegendThroughput" Style="{StaticResource ChartTitle}" Margin="0,0,0,4"/>
                                <controls:MetricChart x:Name="ChartThroughput" Height="150"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource ChartCell}">
                                <TextBlock DockPanel.Dock="Top" x:Name="LegendPle" Style="{StaticResource ChartTitle}" Margin="0,0,0,4"/>
                                <controls:MetricChart x:Name="ChartPle" Height="150"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource ChartCell}">
                                <TextBlock DockPanel.Dock="Top" x:Name="LegendIo" Style="{StaticResource ChartTitle}" Margin="0,0,0,4"/>
                                <controls:MetricChart x:Name="ChartIo" Height="150"/>
                            </DockPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- The window the charts show; moved to the top bar when the page opens (#140) -->
            <controls:TimeRangePicker x:Name="RangePicker" RangeChanged="RangePicker_RangeChanged"/>
        </StackPanel>
    </ScrollViewer>
</Page>
