<Page x:Class="SqlVitals.Desktop.Pages.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      xmlns:vm="clr-namespace:SqlVitals.Desktop.ViewModels.Pages"
      Background="{StaticResource BgDeep}" Title="Backups">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <!-- A line that only shows when there is something to say. -->
        <Style x:Key="WhenSet" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A part of the summary line: no backup to restore in red, overdue in amber. -->
        <Style x:Key="SummaryPart" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Bold">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Muted">
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxHeight" Value="18"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- No backup to restore in red, an overdue one in amber: the two a DBA has to act on. -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="ToolTip" Value="{Binding WarningsText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="FullOverdue">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="LogOverdue">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotChecked">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseName" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FullAge" TargetType="TextBlock" BasedOn="{StaticResource Number}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FullIsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogAge" TargetType="TextBlock" BasedOn="{StaticResource Number}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesLogBackups}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LogIsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <!-- History: backups from before the database was created or restored don't count. -->
        <Style x:Key="HistoryText" TargetType="TextBlock" BasedOn="{StaticResource SingleLineText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFull}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BeforeCreate}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChecksumText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ToolbarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
    </Page.Resources>

    <!-- The page template (#146): the verdict first, the RPO and counts folding to one line, then the
         databases. Bound to BackupsViewModel (#184). -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="Backups" PageKey="Backups">
        <controls:PageShell.Actions>
            <Button x:Name="BtnReload" Content="↻ Read again" Style="{StaticResource RefreshButton}" Padding="12,4"
                    ToolTip="Read the backup history from msdb again."
                    Command="{Binding RefreshCommand}"/>
        </controls:PageShell.Actions>

        <!-- The RPO checked against, counts, and anything that stopped the backups being read -->
        <controls:PageShell.Sections>
        <controls:FoldSection x:Name="SummarySection" Key="summary" Header="RPO and counts" FoldedSummary="{Binding FoldedSummary}">
        <Border Style="{StaticResource KpiCard}" Margin="0">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Warn when the last full backup is older than" Style="{StaticResource ToolbarLabel}"/>
                    <TextBox x:Name="TxtFullAge" Width="70" Style="{StaticResource ToolbarBox}"
                             Text="{Binding FullAgeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A number of days (7), or with a unit: 26h, 1d 12h. Every online database except tempdb is checked.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text=", or the last log backup older than" Style="{StaticResource ToolbarLabel}" Margin="6,0,6,0"/>
                    <TextBox x:Name="TxtLogAge" Width="70" Style="{StaticResource ToolbarBox}"
                             Text="{Binding LogAgeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A number of minutes (60), or with a unit: 2h, 90 min. Set it a little above how often your log backups run. Checked for databases in the FULL or BULK_LOGGED recovery model.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="(FULL and BULK_LOGGED recovery)" Style="{StaticResource ToolbarLabel}" Margin="6,0,16,0"/>
                    <Button x:Name="BtnApply" Content="✓ Apply" Style="{StaticResource RefreshButton}" Padding="12,4"
                            ToolTip="Check the databases against these ages (or press Enter in either box). They are saved for every server."
                            Command="{Binding ApplyCommand}"/>
                </WrapPanel>
                <TextBlock x:Name="TxtError" Text="{Binding RpoError, TargetNullValue=''}" Style="{StaticResource WhenSet}"
                           Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <ItemsControl x:Name="SummaryParts" ItemsSource="{Binding Summary}" Focusable="False" Margin="0,10,0,0"
                              Visibility="{Binding ShowsSummary, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BackupsViewModel+SummaryPart}">
                            <TextBlock Text="{Binding Text}" FontSize="13" Style="{StaticResource SummaryPart}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TxtProblem" Text="{Binding Problem, TargetNullValue=''}" Style="{StaticResource WhenSet}"
                           Foreground="{StaticResource Warning}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtStatus" Text="{Binding ReadNote}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        </controls:FoldSection>
        </controls:PageShell.Sections>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
        </Grid.RowDefinitions>

        <!-- ── Every database, the ones to act on first ──────────────── -->
        <Border Grid.Row="0" Style="{StaticResource KpiCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <controls:GridFilterBox DockPanel.Dock="Right" Target="{Binding ElementName=DatabasesGrid}"/>
                    <ComboBox DockPanel.Dock="Right" x:Name="CmbFilter" Width="250" Style="{StaticResource ToolbarCombo}" Margin="0,0,10,0"
                              ItemsSource="{Binding FilterNames}" SelectedIndex="{Binding FilterIndex}" ToolTip="Which databases to list"/>
                    <TextBlock x:Name="TxtCount" Text="{Binding CountText}" Style="{StaticResource SectionHeader}"
                               Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="DatabasesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Single" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="128" SortMemberPath="Status" ElementStyle="{StaticResource StatusText}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Red: nothing to restore (no full backup), or no log backup can be restored or taken. Amber: a backup older than the ages above. Sorted with these first."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Database" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource DatabaseName}"/>
                            <DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryModel}" Width="108"/>
                            <DataGridTextColumn Header="Last full" Binding="{Binding FullFinish, StringFormat='yyyy-MM-dd HH:mm'}" Width="124">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="When the newest full backup (copy-only ones too) finished, in the server's time."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Full age" Binding="{Binding FullAgeText}" Width="88" SortMemberPath="FullAge" ElementStyle="{StaticResource FullAge}"/>
                            <DataGridTextColumn Header="Last diff" Binding="{Binding DifferentialFinish, StringFormat='yyyy-MM-dd HH:mm'}" Width="124"/>
                            <DataGridTextColumn Header="Diff age" Binding="{Binding DifferentialAgeText}" Width="88" SortMemberPath="DifferentialAge" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Last log" Binding="{Binding LogFinish, StringFormat='yyyy-MM-dd HH:mm'}" Width="124"/>
                            <DataGridTextColumn Header="Log age" Binding="{Binding LogAgeText}" Width="88" SortMemberPath="LogAge" ElementStyle="{StaticResource LogAge}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="How long ago the last log backup finished. n/a: SIMPLE recovery has no log backups."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Data at risk" Binding="{Binding DataAtRiskText}" Width="96" SortMemberPath="DataAtRisk" ElementStyle="{StaticResource Number}">
                                <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="The work lost if the database were lost now, without a tail-log backup: the time since the newest backup it could be restored to (the last log backup in FULL recovery, the last full or differential in SIMPLE). This is the RPO you have right now."/></Style></DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Full size" Binding="{Binding FullSizeText}" Width="80" SortMemberPath="FullBytes" ElementStyle="{StaticResource Number}"/>
                            <DataGridTextColumn Header="Warnings" Binding="{Binding WarningsText}" Width="*" MinWidth="180" ElementStyle="{StaticResource SingleLineText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtNoData" Text="{Binding NoDataText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"
                               Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,40,0,0"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               IsHitTestVisible="False" Visibility="{Binding ShowsNoData, Converter={StaticResource Visible}}"/>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource Border}" Margin="0,4"/>

        <!-- ── The selected database's backups ───────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource KpiCard}">
            <Grid x:Name="DetailPanel" IsEnabled="{Binding HasSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtDetailHeader" Text="{Binding DetailHeader}"
                               Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDetailSub" Text="{Binding DetailText}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="TxtHistoryLabel" Text="{Binding HistoryLabel}"
                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                <DataGrid x:Name="HistoryGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single" ItemsSource="{Binding History}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Finished" Binding="{Binding Finish, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140" ElementStyle="{StaticResource HistoryText}"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="150" ElementStyle="{StaticResource HistoryText}"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="72" SortMemberPath="Duration" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" SortMemberPath="Bytes" ElementStyle="{StaticResource Number}"/>
                        <DataGridTextColumn Header="Compressed" Binding="{Binding CompressedText}" Width="88" SortMemberPath="CompressedBytes" ElementStyle="{StaticResource Number}">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="What was written, when backup compression made it smaller."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Checksum" Binding="{Binding ChecksumText}" Width="76" ElementStyle="{StaticResource ChecksumText}">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Whether it was taken WITH CHECKSUM, so pages were verified as they were read. Damaged: SQL Server found damage while backing up (CONTINUE_AFTER_ERROR)."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryModel}" Width="90" ElementStyle="{StaticResource Muted}"/>
                        <DataGridTextColumn Header="By" Binding="{Binding UserName}" Width="130" ElementStyle="{StaticResource Muted}"/>
                        <DataGridTextColumn Header="Written to" Binding="{Binding Device}" Width="*" MinWidth="200" ElementStyle="{StaticResource SingleLineText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
    </controls:PageShell>
</Page>
