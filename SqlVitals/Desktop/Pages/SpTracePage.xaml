<Page x:Class="SqlVitals.Desktop.Pages.SpTracePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="SP Trace">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="TraceFlatBtn" TargetType="Button">
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <Style x:Key="TraceLabel" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Margin"              Value="10,0,5,0"/>
        </Style>

        <Style x:Key="TraceInput" TargetType="TextBox">
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TraceFilterCombo" TargetType="ComboBox">
            <Setter Property="Height"      Value="26"/>
            <Setter Property="Background"  Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- The page template (#149): the verdict on what the capture is doing first, then the trace's
         controls and the calls; a call selected shows its statement and plan in the details drawer. -->
    <controls:PageShell x:Name="Shell" Margin="16,12,16,12" Title="Live SP Trace" PageKey="SpTrace">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- status strip -->
            <RowDefinition Height="*"/>
            <!-- tabs -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <ToggleButton x:Name="BtnTrace" Content="{Binding TraceButtonText}"
                              Width="104" Height="26" Padding="6,0"
                              Background="#1A22C55E" BorderBrush="{StaticResource Success}"
                              Foreground="{StaticResource Success}"
                              FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                              Command="{Binding ToggleTraceCommand}" IsChecked="{Binding IsTracing, Mode=OneWay}"/>

                <TextBlock Text="Min duration (ms):" Style="{StaticResource TraceLabel}"/>
                <TextBox x:Name="TxtMinDuration" Text="{Binding MinDurationText, UpdateSourceTrigger=PropertyChanged}" Width="56"
                         Style="{StaticResource TraceInput}"
                         ToolTip="Only capture calls at least this slow. Raise this on a busy server to cut trace overhead."/>

                <TextBlock Text="Poll:" Style="{StaticResource TraceLabel}"/>
                <ComboBox x:Name="CmbInterval" Width="64" Height="26"
                          Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}"
                          FontFamily="Segoe UI" FontSize="11"
                          ItemsSource="{Binding IntervalNames}" SelectedIndex="{Binding IntervalIndex}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <Border Margin="6,0,0,0" Background="{StaticResource BgDeep}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="3" Padding="6,0" Height="26" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountdown" Text="{Binding Countdown}"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                               MinWidth="26" TextAlignment="Center"/>
                </Border>

                <ToggleButton x:Name="BtnAutoScroll" Content="Auto-scroll" IsChecked="{Binding AutoScroll}"
                              Height="26" Padding="8,0" Margin="10,0,0,0"
                              Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Border}"
                              Foreground="{StaticResource TextMuted}"
                              FontFamily="Segoe UI" FontSize="11" Cursor="Hand"/>

                <Button x:Name="BtnClear" Content="Clear" Margin="6,0,0,0"
                        Style="{StaticResource TraceFlatBtn}" Command="{Binding ClearCommand}"/>
            </WrapPanel>
        </Border>

        <!-- ── Status strip ───────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="3" Padding="10,5" Margin="0,0,0,8">
            <DockPanel>
                <Border x:Name="ModeBadge" DockPanel.Dock="Left"
                        Background="#1A38BDF8" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" CornerRadius="3" Padding="7,1"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtModeBadge" Text="{Binding ModeText}"
                               Foreground="{StaticResource Accent}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="TxtTraceStatus"
                           Text="{Binding TraceStatus}"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>

        <!-- ── Tabs ───────────────────────────────────────────────── -->
        <TabControl x:Name="TraceTabs" Grid.Row="2" SelectedIndex="{Binding TabIndex}"
                    Background="Transparent" BorderThickness="0">

            <!-- Live calls -->
            <TabItem x:Name="TabLiveCalls" Header="Live Calls">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="140"/>
                    </Grid.RowDefinitions>

                    <!-- Filter bar — client-side, applies to captured history -->
                    <Border Grid.Row="0" Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="4" Padding="4,6" Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock x:Name="TxtFilterCount" Text="{Binding FilterCount}"
                                           Style="{StaticResource TraceLabel}"/>
                                <Button x:Name="BtnClearFilters" Content="Clear filters"
                                        Style="{StaticResource TraceFlatBtn}" Command="{Binding ClearFiltersCommand}"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Search:" Style="{StaticResource TraceLabel}"/>
                                <TextBox x:Name="TxtSearch" Width="150"
                                         Style="{StaticResource TraceInput}"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Procedure name or statement text contains…"/>

                                <TextBlock Text="Database:" Style="{StaticResource TraceLabel}"/>
                                <ComboBox x:Name="CmbDatabase" Width="120"
                                          Style="{StaticResource TraceFilterCombo}"
                                          ItemsSource="{Binding Database.Items}" SelectedItem="{Binding Database.Selected}"/>

                                <TextBlock Text="Login:" Style="{StaticResource TraceLabel}"/>
                                <ComboBox x:Name="CmbLogin" Width="110"
                                          Style="{StaticResource TraceFilterCombo}"
                                          ItemsSource="{Binding Login.Items}" SelectedItem="{Binding Login.Selected}"/>

                                <TextBlock Text="Application:" Style="{StaticResource TraceLabel}"/>
                                <ComboBox x:Name="CmbApp" Width="150"
                                          Style="{StaticResource TraceFilterCombo}"
                                          ItemsSource="{Binding ClientApp.Items}" SelectedItem="{Binding ClientApp.Selected}"/>

                                <TextBlock Text="Host:" Style="{StaticResource TraceLabel}"/>
                                <ComboBox x:Name="CmbHost" Width="110"
                                          Style="{StaticResource TraceFilterCombo}"
                                          ItemsSource="{Binding Host.Items}" SelectedItem="{Binding Host.Selected}"/>

                                <TextBlock Text="Event:" Style="{StaticResource TraceLabel}"/>
                                <ComboBox x:Name="CmbEvent" Width="140"
                                          Style="{StaticResource TraceFilterCombo}"
                                          ItemsSource="{Binding Event.Items}" SelectedItem="{Binding Event.Selected}"/>

                                <TextBlock Text="SPID:" Style="{StaticResource TraceLabel}"/>
                                <TextBox x:Name="TxtSpidFilter" Width="50"
                                         Style="{StaticResource TraceInput}"
                                         Text="{Binding SpidText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Exact session id"/>

                                <TextBlock Text="Dur ≥" Style="{StaticResource TraceLabel}"/>
                                <TextBox x:Name="TxtMinDurFilter" Width="56"
                                         Style="{StaticResource TraceInput}"
                                         Text="{Binding MinDurationFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Show calls with duration of at least this many ms"/>

                                <TextBlock Text="CPU ≥" Style="{StaticResource TraceLabel}"/>
                                <TextBox x:Name="TxtMinCpuFilter" Width="56"
                                         Style="{StaticResource TraceInput}"
                                         Text="{Binding MinCpuText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Show calls with CPU time of at least this many ms"/>

                                <TextBlock Text="Reads ≥" Style="{StaticResource TraceLabel}"/>
                                <TextBox x:Name="TxtMinReadsFilter" Width="66"
                                         Style="{StaticResource TraceInput}"
                                         Text="{Binding MinReadsText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Show calls with at least this many logical reads"/>

                                <CheckBox x:Name="ChkHideResets" Content="Hide sp_reset_connection"
                                          IsChecked="{Binding HideResets}" Margin="10,0,0,0" VerticalAlignment="Center"
                                          Foreground="{StaticResource TextMuted}"
                                          FontFamily="Segoe UI" FontSize="11"
                                          ToolTip="Connection-pool resets are noise for most investigations"/>

                                <CheckBox x:Name="ChkHideExecuteSql" Content="Hide sp_executesql"
                                          IsChecked="{Binding HideExecuteSql}" Margin="10,0,0,0" VerticalAlignment="Center"
                                          Foreground="{StaticResource TextMuted}"
                                          FontFamily="Segoe UI" FontSize="11"
                                          ToolTip="Hide parameterised ad-hoc batches — note their statement text is often the real query"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                        <Grid>
                            <DataGrid x:Name="CallsGrid" IsReadOnly="True" ItemsSource="{Binding Calls}" SelectedItem="{Binding SelectedCall}"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time"      Binding="{Binding EventTime, StringFormat=HH:mm:ss.fff}" Width="92"/>
                                    <DataGridTextColumn Header="Procedure" Binding="{Binding ObjectName}"    Width="230"/>
                                    <DataGridTextColumn Header="Dur (ms)"  Binding="{Binding DurationMs, StringFormat=N0}"   Width="75"/>
                                    <DataGridTextColumn Header="CPU (ms)"  Binding="{Binding CpuTimeMs, StringFormat=N0}"    Width="75"/>
                                    <DataGridTextColumn Header="Reads"     Binding="{Binding LogicalReads, StringFormat=N0}" Width="85"/>
                                    <DataGridTextColumn Header="Writes"    Binding="{Binding Writes, StringFormat=N0}"       Width="70"/>
                                    <DataGridTextColumn Header="Rows"      Binding="{Binding RowsReturned, StringFormat=N0}" Width="70"/>
                                    <DataGridTextColumn Header="SPID"      Binding="{Binding SessionId}"      Width="55"/>
                                    <DataGridTextColumn Header="Login"     Binding="{Binding LoginName}"      Width="110"/>
                                    <DataGridTextColumn Header="Application" Binding="{Binding ClientAppName}" Width="140"/>
                                    <DataGridTextColumn Header="Host"      Binding="{Binding ClientHostName}" Width="110"/>
                                    <DataGridTextColumn Header="Event"     Binding="{Binding EventName}"      Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="TxtNoCalls"
                                       Text="{Binding NoCalls}"
                                       Visibility="{Binding ShowsNoCalls, Converter={StaticResource Visible}}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!-- Aggregates -->
            <TabItem x:Name="TabByProcedure" Header="By Procedure">
                <Border Style="{StaticResource KpiCard}" Margin="0,8,0,0">
                    <Grid>
                        <DataGrid x:Name="AggregateGrid" IsReadOnly="True" ItemsSource="{Binding Procedures}"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Procedure"    Binding="{Binding FullName}"        Width="260"/>
                                <DataGridTextColumn Header="Database"     Binding="{Binding DatabaseName}"    Width="130"/>
                                <DataGridTextColumn Header="Executions"   Binding="{Binding ExecCount, StringFormat=N0}"        Width="85"/>
                                <DataGridTextColumn Header="Avg (ms)"     Binding="{Binding AvgDurationMs, StringFormat=N1}"    Width="80"/>
                                <DataGridTextColumn Header="Total (ms)"   Binding="{Binding TotalDurationMs, StringFormat=N0}"  Width="90"/>
                                <DataGridTextColumn Header="Max ever (ms)" Binding="{Binding MaxDurationMs, StringFormat=N0}"   Width="100"/>
                                <DataGridTextColumn Header="Avg CPU (ms)" Binding="{Binding AvgCpuMs, StringFormat=N1}"         Width="95"/>
                                <DataGridTextColumn Header="Avg Reads"    Binding="{Binding AvgLogicalReads, StringFormat=N0}"  Width="95"/>
                                <DataGridTextColumn Header="Last Run"     Binding="{Binding LastExecutionTime, StringFormat=HH:mm:ss}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="TxtNoAggregates"
                                   Text="No procedure activity in the last poll window.&#10;This view shows what ran between polls — start the trace, or press Refresh again to sample another window."
                                   TextAlignment="Center"
                                   Visibility="{Binding ShowsNoProcedures, Converter={StaticResource Visible}}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
    </controls:PageShell>
</Page>
