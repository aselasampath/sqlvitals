<Page x:Class="SqlVitals.Desktop.Pages.DatabaseStoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Database Storage">
    <!-- The page template (#150): the verdict on files near their limit first, the sizes folding to
         one line, then the files, TempDB, server configuration and tables on tabs the Navigator keeps. -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="Database Storage &amp; Configuration" PageKey="DbStorage">
        <controls:PageShell.Sections>
            <controls:FoldSection x:Name="SizesSection" Key="sizes" Header="Sizes">
                <WrapPanel>
                    <Border Style="{StaticResource KpiCard}" Width="160" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Total DB Size" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" />
                            <TextBlock x:Name="KpiTotalSize" Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="All ONLINE databases" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Width="160" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Data Files" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" />
                            <TextBlock x:Name="KpiDataSize" Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="ROWS type files" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Width="160" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Log Files" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" />
                            <TextBlock x:Name="KpiLogSize" Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="LOG type files" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Width="160" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="TempDB Size" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" />
                            <TextBlock x:Name="KpiTempDbSize" Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="All tempdb files" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Width="160" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Max DOP" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" />
                            <TextBlock x:Name="KpiMaxDop" Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="max degree of parallelism" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Width="160" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="Cost Threshold" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="11" />
                            <TextBlock x:Name="KpiCostThreshold" Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Text="cost threshold for parallelism" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </controls:FoldSection>
        </controls:PageShell.Sections>

        <TabControl x:Name="Tabs" Background="{StaticResource BgDeep}"
                    BorderBrush="{StaticResource Border}"
                    Foreground="{StaticResource TextPrimary}">
            <TabItem x:Name="TabFiles" Header="Database Files">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="All ONLINE database files (data + log)"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"
                                   FontSize="11" Margin="0,0,0,8" />
                        <DataGrid x:Name="GridFiles" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"     Width="140" />
                                <DataGridTextColumn Header="State"       Binding="{Binding State}"            Width="70"  />
                                <DataGridTextColumn Header="Recovery"    Binding="{Binding RecoveryModel}"    Width="80"  />
                                <DataGridTextColumn Header="Compat"      Binding="{Binding CompatibilityLevel}" Width="60" />
                                <DataGridTextColumn Header="File Type"   Binding="{Binding FileType}"         Width="70"  />
                                <DataGridTextColumn Header="Logical Name" Binding="{Binding LogicalFileName}" Width="130" />
                                <DataGridTextColumn Header="Size MB"     Binding="{Binding FileSizeMB,   StringFormat=N2}" Width="80"  />
                                <DataGridTextColumn Header="Used MB"     Binding="{Binding SpaceUsedMB,  StringFormat=N2}" Width="80"  />
                                <DataGridTextColumn Header="Free MB"     Binding="{Binding FreeSpaceMB,  StringFormat=N2}" Width="80"  />
                                <DataGridTextColumn Header="Max MB"      Binding="{Binding MaxSizeMBDisplay}"  Width="80"  />
                                <DataGridTextColumn Header="Auto-Growth" Binding="{Binding AutoGrowth}"    Width="90"  />
                                <DataGridTextColumn Header="Auto-Shrink" Binding="{Binding AutoShrinkDisplay}" Width="80" />
                                <DataGridTextColumn Header="QS On"       Binding="{Binding QueryStoreOnDisplay}" Width="60" />
                                <DataGridTextColumn Header="Encrypted"   Binding="{Binding EncryptedDisplay}"  Width="70" />
                                <DataGridTextColumn Header="Physical Path" Binding="{Binding PhysicalPath}"  Width="300" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem x:Name="TabTempDb" Header="TempDB Files">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TempDB data and log files"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"
                                   FontSize="11" Margin="0,0,0,8" />
                        <DataGrid x:Name="GridTempDb" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Name"  Binding="{Binding FileName}"  Width="180" />
                                <DataGridTextColumn Header="Type"       Binding="{Binding FileType}"  Width="80"  />
                                <DataGridTextColumn Header="Size MB"    Binding="{Binding SizeMB,  StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Used MB"    Binding="{Binding UsedMB,  StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Free MB"    Binding="{Binding FreeMB,  StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Physical Path" Binding="{Binding PhysicalPath}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem x:Name="TabConfig" Header="Server Config">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Key server configuration parameters (sp_configure)"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"
                                   FontSize="11" Margin="0,0,0,8" />
                        <DataGrid x:Name="GridConfig" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter"     Binding="{Binding ParameterName}" Width="260" />
                                <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue}"  Width="110" />
                                <DataGridTextColumn Header="Min"           Binding="{Binding MinValue}"      Width="80"  />
                                <DataGridTextColumn Header="Max"           Binding="{Binding MaxValue}"      Width="100" />
                                <DataGridTextColumn Header="Dynamic"       Binding="{Binding IsDynamicDisplay}" Width="70" />
                                <DataGridTextColumn Header="Description"   Binding="{Binding Description}"   Width="*"   />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem x:Name="TabTables" Header="Top Tables">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Top 20 tables by total storage size (current database context)"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"
                                   FontSize="11" Margin="0,0,0,8" />
                        <DataGrid x:Name="GridTables" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Schema"       Binding="{Binding SchemaName}"   Width="90"  />
                                <DataGridTextColumn Header="Table"        Binding="{Binding TableName}"    Width="200" />
                                <DataGridTextColumn Header="Row Count"    Binding="{Binding RowCount, StringFormat=N0}" Width="100" />
                                <DataGridTextColumn Header="Data MB"      Binding="{Binding DataSizeMB,  StringFormat=N3}" Width="90" />
                                <DataGridTextColumn Header="Index MB"     Binding="{Binding IndexSizeMB, StringFormat=N3}" Width="90" />
                                <DataGridTextColumn Header="Total MB"     Binding="{Binding TotalSizeMB, StringFormat=N3}" Width="90" />
                                <DataGridTextColumn Header="Used MB"      Binding="{Binding UsedSizeMB,  StringFormat=N3}" Width="90" />
                                <DataGridTextColumn Header="Unused MB"    Binding="{Binding UnusedSizeMB,StringFormat=N3}" Width="90" />
                                <DataGridTextColumn Header="Indexes"      Binding="{Binding IndexCount}"  Width="70"  />
                                <DataGridTextColumn Header="Type"         Binding="{Binding TableType}"   Width="80"  />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </controls:PageShell>
</Page>
