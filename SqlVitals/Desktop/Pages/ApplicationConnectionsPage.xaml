<Page x:Class="SqlVitals.Desktop.Pages.ApplicationConnectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      xmlns:vm="clr-namespace:SqlVitals.Desktop.ViewModels"
      Background="{StaticResource BgDeep}" Title="Application Connections">
    <!-- The page template (#149): the verdict first, the counts and the chart folding to one line
         each, then every application. Bound to ApplicationConnectionsViewModel (#185). -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="Application Connections" PageKey="AppConnections">
        <controls:PageShell.Sections>
            <controls:FoldSection x:Name="SummarySection" Key="summary" Header="Counts" FoldedSummary="{Binding CountsSummary}">
                <StackPanel>
                    <TextBlock x:Name="TxtSummary" Text="{Binding Summary}" Foreground="{StaticResource TextMuted}"
                               FontSize="12" Margin="0,0,0,10" />

                    <!-- KPI cards -->
                    <ItemsControl x:Name="KpiPanel" ItemsSource="{Binding Counts}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KpiCard}">
                                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10" Width="200">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel MaxWidth="340">
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource KpiToneValue}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource KpiLabel}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:FoldSection>

            <!-- Connections bar chart -->
            <controls:FoldSection x:Name="ChartSection" Key="chart" Header="Connections by application" FoldedSummary="{Binding ChartSummary}">
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <lvc:CartesianChart x:Name="ConnectionsChart" Height="220"
                                        TooltipPosition="Top" LegendPosition="Hidden" />
                </Border>
            </controls:FoldSection>
        </controls:PageShell.Sections>

            <!-- Connections DataGrid -->
            <Border Style="{StaticResource KpiCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Connections by Application" Style="{StaticResource SectionHeader}" />
                    <DataGrid x:Name="ConnectionsGrid" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="280" />
                            <DataGridTextColumn Header="Connections" Binding="{Binding CurrentConnections, StringFormat=N0}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Active Requests" Binding="{Binding ActiveRequests, StringFormat=N0}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CPU Time (ms)" Binding="{Binding TotalCpuTimeMs, StringFormat=N0}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Total CPU time consumed by all sessions from this application since login." />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Memory (KB)" Binding="{Binding TotalMemoryKB, StringFormat=N0}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Total memory pages (8 KB each) used by all sessions from this application." />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Logical Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Total logical reads (buffer pool page accesses) by all sessions from this application." />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reads" Binding="{Binding TotalReads, StringFormat=N0}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Total physical reads performed by all sessions from this application." />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Writes" Binding="{Binding TotalWrites, StringFormat=N0}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Total physical writes performed by all sessions from this application." />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="First Login" Binding="{Binding FirstLoginTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130" />
                            <DataGridTextColumn Header="Last Request" Binding="{Binding LastRequestTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </controls:PageShell>
</Page>
