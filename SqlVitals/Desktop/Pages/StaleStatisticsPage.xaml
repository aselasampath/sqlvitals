<Page x:Class="SqlVitals.Desktop.Pages.StaleStatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}" Title="Stale Statistics">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Stale Statistics" Style="{StaticResource SectionHeader}"
                   FontSize="20" Margin="0,0,0,6" />
        <Border Grid.Row="1" Background="#1A7C3AED" BorderBrush="#7C3AED" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="#A78BFA" FontFamily="Segoe UI" FontSize="11">
                ℹ  SQL Server relies on statistics to estimate row counts and choose efficient execution plans.
                Stale statistics cause the optimizer to make poor decisions. A high modification_counter relative
                to row count indicates statistics are out of date. Run UPDATE STATISTICS or enable
                AUTO_UPDATE_STATISTICS for automatic maintenance.
            </TextBlock>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource KpiCard}">
            <StackPanel>
                <TextBlock Text="Statistics with pending modifications — sorted by modification count"
                           Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Sampling:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                    <RadioButton x:Name="RbDefaultSampling" GroupName="Sampling" Content="Default" IsChecked="True"
                                 VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextPrimary}"
                                 ToolTip="No WITH clause: SQL Server chooses the sample size (or uses a persisted sample percent). Fast, but skewed data can still get a poor histogram." />
                    <RadioButton x:Name="RbFullScan" GroupName="Sampling" Content="FULLSCAN"
                                 VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{StaticResource TextPrimary}"
                                 ToolTip="WITH FULLSCAN: reads every row for the most accurate histogram. Heavy I/O on large tables — run it off-peak." />
                    <Button x:Name="BtnUpdateStatsScript" Content="Generate UPDATE STATISTICS Script"
                            Style="{DynamicResource RefreshButton}" Padding="12,4" VerticalAlignment="Center"
                            IsEnabled="False" Click="BtnUpdateStatsScript_Click"
                            ToolTip="Generate a T-SQL UPDATE STATISTICS script for the selected rows (or all of them if none are selected). The script is shown for review — nothing is executed." />
                </WrapPanel>

                <DataGrid x:Name="StatsGrid" MaxHeight="620" CanUserAddRows="False"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          SelectionChanged="StatsGrid_SelectionChanged"
                          RowBackground="{StaticResource BgDeep}"
                          AlternatingRowBackground="{StaticResource BgSidebar}"
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Border}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Database"      Binding="{Binding DatabaseName}"                                       Width="110">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Database containing the statistics object."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Schema"        Binding="{Binding SchemaName}"                                         Width="80">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Schema the table belongs to. The UPDATE STATISTICS script qualifies every table with it."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Table"         Binding="{Binding TableName}"                                          Width="160">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Table the statistics are defined on."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Statistics"    Binding="{Binding StatisticsName}"                                     Width="200">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Name of the statistics object. Auto-created stats start with '_WA_Sys_'; index stats share the index name."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last Updated"  Binding="{Binding LastUpdated, StringFormat='yyyy-MM-dd'}"             Width="110">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="When statistics were last refreshed. NULL = never updated since creation."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Days Old"      Binding="{Binding DaysOld, StringFormat=N0}"                          Width="80">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Days since last update. High days old + high modifications = stale statistics that may cause bad query plans."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Rows"          Binding="{Binding RowsInTable, StringFormat=N0}"                      Width="100">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Current row count of the table. Auto-update threshold: 20% of rows on small tables; sqrt(1000 × rows) on larger tables (trace flag 2371)."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Modifications"  Binding="{Binding ModificationsSinceLastUpdate, StringFormat=N0}"    Width="120">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Row modifications since last statistics update (modification_counter). High values relative to Rows = statistics are significantly out of date."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sample %"      Binding="{Binding SamplePct, StringFormat=F1}"                        Width="90">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Percentage of rows sampled during last statistics update. Low sample rate = less accurate histograms. Use FULLSCAN for critical statistics."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Auto Created"  Binding="{Binding AutoCreated}"                                       Width="100">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="True = auto-created by the query optimizer; False = created by a user or index. Auto-created stats are maintained automatically if AUTO_UPDATE_STATISTICS is ON."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="User Created"  Binding="{Binding UserCreated}"                                       Width="100">
                            <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="True = manually created with CREATE STATISTICS. These are under your control — update them explicitly or in your maintenance plan."/></Style></DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
