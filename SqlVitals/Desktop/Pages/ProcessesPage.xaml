<Page x:Class="SqlVitals.Desktop.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{DynamicResource BgDeep}" Title="Processes">
    <Page.Resources>
        <!-- Segmented Map | Grid switch (#116), in the look of the time-range buttons -->
        <Style x:Key="ViewButton" TargetType="RadioButton">
            <Setter Property="GroupName"   Value="ProcessesView"/>
            <Setter Property="MinWidth"    Value="46"/>
            <Setter Property="Height"      Value="22"/>
            <Setter Property="Padding"     Value="10,0"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextMuted}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Processes" Style="{StaticResource SectionHeader}" Margin="0"
                       FontSize="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="BtnMap"  Content="Map"  Style="{StaticResource ViewButton}" IsChecked="True"
                                 Checked="View_Checked" ToolTip="Sessions as blocking chains"/>
                    <RadioButton x:Name="BtnGrid" Content="Grid" Style="{StaticResource ViewButton}"
                                 Checked="View_Checked" ToolTip="One row per session, grouped by login, to sort and compare"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- Auto-refresh interval -->
                <TextBlock Text="Auto-refresh:" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="12"/>
                <ComboBox x:Name="CmbInterval" Width="80" Height="26"
                          Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource Border}" FontFamily="Segoe UI" FontSize="12"
                          SelectionChanged="CmbInterval_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <!-- Toggle button -->
                <ToggleButton x:Name="BtnAutoRefresh" Content="Start" Width="58" Height="26"
                              Margin="6,0,0,0" Padding="6,0"
                              Background="#1A22C55E" BorderBrush="{DynamicResource Success}"
                              Foreground="{DynamicResource Success}"
                              FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                              Checked="BtnAutoRefresh_Checked" Unchecked="BtnAutoRefresh_Unchecked"/>

                <!-- Countdown indicator -->
                <Border Margin="8,0,0,0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="6,0" Height="26"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountdown" Text="--" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" FontFamily="Segoe UI Mono" FontSize="11"
                               MinWidth="28" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Shared process map: zoom, search, legend, themed canvas, details panel; and the grid (#116) -->
        <controls:ProcessMapControl x:Name="ProcessMap" Grid.Row="1"/>
    </Grid>
</Page>
