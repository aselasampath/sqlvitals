<Page x:Class="SqlVitals.Desktop.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}" Title="Process Map">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Process Map" Style="{StaticResource SectionHeader}"
                       FontSize="20" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- Auto-refresh interval -->
                <TextBlock Text="Auto-refresh:" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="12"/>
                <ComboBox x:Name="CmbInterval" Width="80" Height="26"
                          Background="#1E1E2E" Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}" FontFamily="Segoe UI" FontSize="12"
                          SelectionChanged="CmbInterval_SelectionChanged" />

                <!-- Toggle button -->
                <ToggleButton x:Name="BtnAutoRefresh" Content="▶ Start" Width="72" Height="26"
                              Margin="6,0,0,0" Padding="6,0"
                              Background="#1E3A1E" BorderBrush="#44AA44" BorderThickness="1"
                              Foreground="#66DD66" FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                              Checked="BtnAutoRefresh_Checked" Unchecked="BtnAutoRefresh_Unchecked"/>

                <!-- Countdown indicator -->
                <Border Margin="8,0,0,0" Background="#1A1A2E" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="6,0" Height="26"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountdown" Text="--" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" FontFamily="Segoe UI Mono" FontSize="11"
                               MinWidth="28" TextAlignment="Center"/>
                </Border>

                <Separator Width="1" Background="{StaticResource Border}" Margin="10,4"/>

                <!-- Search -->
                <TextBlock Text="Search SPID:" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="12"/>
                <TextBox x:Name="TxtSearch" Width="100" Height="26"
                         Background="#1E1E2E" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource Border}" BorderThickness="1"
                         Padding="4,2" FontFamily="Segoe UI" FontSize="12"
                         TextChanged="TxtSearch_TextChanged" VerticalContentAlignment="Center"/>
                <Button Content="Show Legend" Margin="12,0,0,0" Height="26" Padding="8,0"
                        Background="Transparent" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" Foreground="{StaticResource Accent}"
                        FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                        Click="BtnLegend_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Legend (collapsed by default) -->
        <Border Grid.Row="1" x:Name="LegendPanel" Visibility="Collapsed"
                Background="#1A1A2E" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#FF6060" Offset="0"/>
                                <GradientStop Color="#AA0000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Active / Running" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#FF9030" Offset="0"/>
                                <GradientStop Color="#C04000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Head Blocker" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#9090FF" Offset="0"/>
                                <GradientStop Color="#0000CC" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Blocked" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#60AAFF" Offset="0"/>
                                <GradientStop Color="#2244AA" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Sleeping" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Canvas -->
        <Border Grid.Row="2" Background="#12122A" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="ProcessCanvas" MinWidth="800" MinHeight="500"
                            MouseMove="Canvas_MouseMove" />
                </ScrollViewer>

                <!-- Process Details Overlay -->
                <Border x:Name="DetailsPopup" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="400"
                        Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0"
                        Margin="0" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.2" ShadowDepth="-2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Background="#E0E0E0" Padding="12,8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Foreground="#FF4444"
                                        Background="Transparent" BorderThickness="0"
                                        FontWeight="Bold" FontSize="16" Cursor="Hand"
                                        Padding="4,0" Click="BtnCloseDetails_Click"/>
                                <TextBlock Text="Session Details" FontWeight="Bold" FontSize="14" Foreground="#333333"/>
                            </DockPanel>
                        </Border>

                        <!-- Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="TxtDetailsContent" FontFamily="Consolas" FontSize="12"
                                           Foreground="#222222" TextWrapping="Wrap"/>
                                <Separator Margin="0,12" Background="#DDDDDD"/>
                                <TextBlock Text="Input Buffer / Query Text:" FontWeight="Bold" Margin="0,0,0,4" Foreground="#444444" FontSize="12"/>
                                <TextBox x:Name="TxtInfoBuffer" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="11" Background="#FFFFFF"
                                         BorderBrush="#CCCCCC" BorderThickness="1" Padding="4" MinHeight="100"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- Tooltip popup -->
    <Page.Resources>
        <ToolTip x:Key="NodeTooltip">
            <StackPanel Margin="4">
                <TextBlock x:Name="TipTitle" FontWeight="Bold" FontSize="13"
                           Foreground="White" FontFamily="Segoe UI"/>
                <TextBlock x:Name="TipDetails" Foreground="#CCCCCC" FontSize="11"
                           FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="340"/>
            </StackPanel>
        </ToolTip>
    </Page.Resources>
</Page>
