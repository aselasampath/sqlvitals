<Page x:Class="SqlVitals.Desktop.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{DynamicResource BgDeep}" Title="Processes">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <!-- Segmented Map | Grid | Waiting switch (#116, #178), in the look of the time-range buttons -->
        <Style x:Key="ViewButton" TargetType="RadioButton">
            <Setter Property="GroupName"   Value="ProcessesView"/>
            <Setter Property="MinWidth"    Value="46"/>
            <Setter Property="Height"      Value="22"/>
            <Setter Property="Padding"     Value="10,0"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextMuted}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <!-- The page template (#146): the verdict on blocking first, then the map, the grid or the
         requests waiting (#178). Bound to ProcessesViewModel (#186). -->
    <controls:PageShell x:Name="Shell" Margin="16" Title="Processes" PageKey="Processes">
        <controls:PageShell.Actions>
        <StackPanel Orientation="Horizontal">
            <Border Margin="0,0,16,0" VerticalAlignment="Center"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="BtnMap"  Content="Map"  Style="{StaticResource ViewButton}" IsChecked="{Binding IsMap}"
                                 ToolTip="Sessions as blocking chains"/>
                    <RadioButton x:Name="BtnGrid" Content="Grid" Style="{StaticResource ViewButton}" IsChecked="{Binding IsGrid}"
                                 ToolTip="One row per session, grouped by login, to sort and compare"/>
                    <RadioButton x:Name="BtnWaiting" Content="Waiting" Style="{StaticResource ViewButton}" IsChecked="{Binding IsWaiting}"
                                 ToolTip="Every request waiting now: on what, for how long, and the session blocking it"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Auto-refresh interval -->
                <TextBlock Text="Auto-refresh:" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="12"/>
                <ComboBox x:Name="CmbInterval" Width="80" Height="26"
                          Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource Border}" FontFamily="Segoe UI" FontSize="12"
                          ItemsSource="{Binding Intervals}" DisplayMemberPath="Text"
                          SelectedValuePath="Seconds" SelectedValue="{Binding IntervalSeconds}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <!-- Toggle button -->
                <ToggleButton x:Name="BtnAutoRefresh" Content="{Binding AutoRefreshText}" IsChecked="{Binding AutoRefresh}" Width="58" Height="26"
                              Margin="6,0,0,0" Padding="6,0"
                              Background="#1A22C55E" BorderBrush="{DynamicResource Success}"
                              Foreground="{DynamicResource Success}"
                              FontFamily="Segoe UI" FontSize="11" Cursor="Hand"/>

                <!-- Countdown indicator -->
                <Border Margin="8,0,0,0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="6,0" Height="26"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountdown" Text="{Binding Countdown}" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" FontFamily="Segoe UI Mono" FontSize="11"
                               MinWidth="28" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>
        </controls:PageShell.Actions>

        <Grid>
            <!-- Shared process map: zoom, search, legend, themed canvas, details panel; and the grid (#116) -->
            <controls:ProcessMapControl x:Name="ProcessMap" Sessions="{Binding SessionsRead}"
                                        Visibility="{Binding ShowsMap, Converter={StaticResource Visible}}"/>

            <!-- Waiting (#178): every request waiting now, as the Active Waits page showed them -->
            <Border x:Name="WaitingPanel" Style="{StaticResource KpiCard}" Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}">
                <DataGrid x:Name="WaitingGrid" ItemsSource="{Binding Waits}" AutomationProperties.Name="Requests waiting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Session"     Binding="{Binding SessionId}"          Width="65" />
                        <DataGridTextColumn Header="Blocking"    Binding="{Binding BlockingSessionId}"  Width="65" />
                        <DataGridTextColumn Header="Wait Type"   Binding="{Binding WaitType}"           Width="180" />
                        <DataGridTextColumn Header="Category"    Binding="{Binding WaitCategory}"       Width="100" />
                        <DataGridTextColumn Header="Wait (sec)"  Binding="{Binding WaitTimeSec, StringFormat=N2}" Width="80" />
                        <DataGridTextColumn Header="Severity"    Binding="{Binding WaitSeverity}"       Width="80" />
                        <DataGridTextColumn Header="Status"      Binding="{Binding RequestStatus}"      Width="80" />
                        <DataGridTextColumn Header="Command"     Binding="{Binding Command}"            Width="120" />
                        <DataGridTextColumn Header="Login"       Binding="{Binding LoginName}"          Width="100" />
                        <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}"       Width="120" />
                        <DataGridTextColumn Header="CPU (ms)"    Binding="{Binding CpuTimeMs}"          Width="80" />
                        <DataGridTextColumn Header="Logical Reads" Binding="{Binding LogicalReads}"     Width="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </controls:PageShell>
</Page>
