<Page x:Class="SqlVitals.Desktop.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:SqlVitals.Desktop.Pages"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      x:Name="Root" Background="{StaticResource BgDeep}" Title="Home">
    <Page.Resources>
        <!-- A status or "Active" label beside a tile's name. -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <!-- "+ Add a connection": a dashed tile, darker while pointed at or focused. -->
        <Style x:Key="AddTile" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Dash" RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="4 3"
                                       Stroke="{StaticResource Border}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,20,6,20">
            <!-- Heading, and a count per status on the right -->
            <DockPanel Margin="0,0,14,14">
                <ItemsControl x:Name="Counts" DockPanel.Dock="Right" VerticalAlignment="Bottom" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pages:HomeCount}">
                            <Border Style="{StaticResource Chip}" Background="{Binding Tint}" Padding="10,3">
                                <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                    <TextBlock Text="Your servers" Style="{StaticResource SectionHeader}" FontSize="20" Margin="0"/>
                    <TextBlock x:Name="TxtHeadline" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxtNote" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,14,12" Visibility="Collapsed"/>

            <!-- A tile's score breakdown (#36), beside its menu button -->
            <Popup x:Name="BreakdownPopup" Placement="Bottom" VerticalOffset="4" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade" Closed="BreakdownPopup_Closed">
                <controls:HealthScoreBreakdown x:Name="Breakdown"/>
            </Popup>

            <!-- One tile per saved connection, then "+ Add a connection" -->
            <ItemsControl x:Name="Tiles" Focusable="False" MouseLeave="Tiles_MouseLeave"
                          AutomationProperties.Name="Saved connections">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="{Binding TileWidth, ElementName=Root}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:HomeTile}">
                        <Border Margin="0,0,14,14" Padding="16,14" CornerRadius="10" MinHeight="236"
                                Background="{StaticResource BgCard}" BorderThickness="1"
                                AutomationProperties.Name="{Binding Tile.AutomationName}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tile.IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <!-- Name, status, "Active", and the tile's menu -->
                                <DockPanel DockPanel.Dock="Top">
                                    <!-- Open, Start or Stop monitoring, the score's breakdown, Edit (#141):
                                         what the sidebar's connection selector did before 0.57.0 -->
                                    <Button DockPanel.Dock="Right" Content="&#xE712;" Click="TileMenu_Click"
                                            Style="{StaticResource NavArrowButton}" Width="26" Height="26" Margin="6,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" BorderBrush="Transparent"
                                            AutomationProperties.Name="{Binding MenuName}" ToolTip="More: monitoring, the score's breakdown, edit"/>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{Binding StatusTint}">
                                        <TextBlock Text="{Binding Tile.StatusLabel}" Style="{StaticResource ChipText}"/>
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource AccentLight}"
                                            Visibility="{Binding ActiveVisibility}">
                                        <TextBlock Text="ACTIVE" Style="{StaticResource ChipText}"/>
                                    </Border>
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Tile.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                               ToolTip="{Binding Tile.Name}"/>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Tile.ServerLine}" Style="{StaticResource Muted}"
                                           Margin="18,2,0,8" ToolTip="{Binding Tile.ServerLine}"/>

                                <!-- When it was sampled, and the button -->
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Content="{Binding Tile.ActionText}" Click="TileAction_Click"
                                            IsEnabled="{Binding Tile.CanAct}" Visibility="{Binding ScoreVisibility}"
                                            Style="{StaticResource SecondaryButton}" Padding="14,5"
                                            AutomationProperties.Name="{Binding ActionName}" ToolTip="{Binding ActionToolTip}"
                                            ToolTipService.ShowOnDisabled="True"/>
                                    <TextBlock Text="{Binding Tile.Footer}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               ToolTip="{Binding Tile.Footer}"/>
                                </DockPanel>

                                <!-- Not monitored: why, and Start -->
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding OffVisibility}" Margin="0,22,0,0">
                                    <TextBlock Text="{Binding Tile.Reason}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <Button Content="{Binding Tile.ActionText}" Click="TileAction_Click" HorizontalAlignment="Left"
                                            IsEnabled="{Binding Tile.CanAct}" Margin="0,10,0,0"
                                            Style="{StaticResource RefreshButton}"
                                            AutomationProperties.Name="{Binding ActionName}" ToolTip="{Binding ActionToolTip}"
                                            ToolTipService.ShowOnDisabled="True"/>
                                </StackPanel>

                                <!-- Monitored: the score, its last hour, why it's lower, and a bar per check -->
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding ScoreVisibility}">
                                    <DockPanel>
                                        <controls:ScoreChart DockPanel.Dock="Right" Width="120" Height="36" VerticalAlignment="Bottom"
                                                             Data="{Binding Trend}" LineBrush="{Binding StatusBrush}"
                                                             ToolTip="{Binding TrendToolTip}"/>
                                        <TextBlock VerticalAlignment="Bottom">
                                            <Run Text="{Binding Tile.ScoreText, Mode=OneWay}" FontSize="38" FontWeight="Bold"
                                                 Foreground="{Binding StatusBrush, Mode=OneWay}"/><Run
                                                 Text=" / 100" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Tile.Reason}" Foreground="{StaticResource TextPrimary}" FontSize="12"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,6,0,8"
                                               ToolTip="{Binding ReasonToolTip}"/>
                                    <ItemsControl ItemsSource="{Binding Bars}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pages:HomeBar}">
                                                <StackPanel Margin="2,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                                                    <Border Height="6" CornerRadius="3" Background="{Binding Brush}"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
