<Page x:Class="SqlVitals.Desktop.Pages.PlanCacheHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDeep}" Title="Plan Cache Health">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="Plan Cache Health" Style="{StaticResource SectionHeader}"
                       FontSize="20" Margin="0,0,0,12" />

            <!-- Explanatory banner -->
            <Border Background="#1A7C3AED" BorderBrush="#7C3AED" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                <TextBlock TextWrapping="Wrap" Foreground="#94A3B8" FontFamily="Segoe UI" FontSize="11">
                    Diagnoses plan cache health: parameterization failures, Key/RID Lookups in hot plans,
                    active cardinality misestimates and skewed parallelism, and frozen plan guides.
                    Live-query tabs (Cardinality, Parallelism) are empty when no queries are running with
                    execution statistics collection enabled (requires Query Profiling Infrastructure).
                </TextBlock>
            </Border>

            <!-- Cache-erased alert banner (hidden by default) -->
            <Border x:Name="BannerCacheErased"
                    Background="#1AEF4444" BorderBrush="#EF4444" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="TxtCacheErasedMsg" TextWrapping="Wrap"
                           Foreground="#EF4444" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold">
                    ⚠  Plan cache was erased recently (DBCC FREEPROCCACHE or server restart).
                    Historical plan data may be incomplete. Wait for plans to repopulate before drawing conclusions.
                </TextBlock>
            </Border>

            <!-- KPI strip -->
            <WrapPanel x:Name="KpiStrip" Margin="0,0,0,18" />

            <!-- Tab control -->
            <TabControl Background="{StaticResource BgDeep}"
                        BorderBrush="{StaticResource Border}"
                        Foreground="{StaticResource TextPrimary}">

                <!-- ── Tab 1: Multi-Plan Queries ─────────────────────────────── -->
                <TabItem Header="Multi-Plan Queries">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Queries with Many Cached Plans (Parameterisation Failures)" />
                            <Border Background="#1AFBBF24" BorderBrush="#FBBF24" BorderThickness="1"
                                    CornerRadius="4" Padding="10,6" Margin="0,4,0,10">
                                <TextBlock TextWrapping="Wrap" Foreground="#FBBF24" FontSize="11">
                                    Each row is a unique query hash that has > 5 distinct cached plans.
                                    This usually means the query is using literal values rather than parameters,
                                    causing a new plan to be compiled for every unique value.
                                    Fix: use sp_executesql with parameters, or enable Optimize for Ad-hoc Workloads.
                                </TextBlock>
                            </Border>
                            <DataGrid x:Name="MultiPlanGrid" MaxHeight="420" IsReadOnly="True"
                                      CanUserAddRows="False" ClipboardCopyMode="IncludeHeader"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AutoGenerateColumns="False"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Plan Count"       Binding="{Binding PlanCount, StringFormat=N0}"        Width="90">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of distinct cached execution plans for the same query hash. More than 5 plans for the same query strongly suggests ad-hoc parameterization."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Executions" Binding="{Binding TotalExecutions, StringFormat=N0}"  Width="120">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Sum of execution counts across all plans for this query hash. High total executions × high plan count = large compilation overhead."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Database"         Binding="{Binding DatabaseName}"                       Width="110">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Database context for the cached plans. Plans from multiple databases can share the same query hash if the query structure is identical."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Query Hash"       Binding="{Binding QueryHash}"                          Width="130">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="SQL Server query hash — uniquely identifies the logical query structure independent of literal values. Use this to correlate across plan_cache and Query Store."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Severity"         Binding="{Binding Severity}"                           Width="80" />
                                    <DataGridTextColumn Header="Query Text"       Binding="{Binding QueryText}"                          Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ── Tab 2: Key / RID Lookups ──────────────────────────────── -->
                <TabItem Header="Key / RID Lookups">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Key and RID Lookups in High-Execution Plans" />
                            <Border Background="#1AFBBF24" BorderBrush="#FBBF24" BorderThickness="1"
                                    CornerRadius="4" Padding="10,6" Margin="0,4,0,10">
                                <TextBlock TextWrapping="Wrap" Foreground="#FBBF24" FontSize="11">
                                    Key Lookups (clustered index) and RID Lookups (heap) occur when a nonclustered
                                    index seek is used but additional columns must be fetched from the base table.
                                    Under heavy load these become a major I/O bottleneck.
                                    Fix: add the required columns as INCLUDE columns to the nonclustered index
                                    to make it covering, or create a proper covering index.
                                </TextBlock>
                            </Border>
                            <DataGrid x:Name="KeyLookupGrid" MaxHeight="420" IsReadOnly="True"
                                      CanUserAddRows="False" ClipboardCopyMode="IncludeHeader"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AutoGenerateColumns="False"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lookup Type"     Binding="{Binding LookupType}"                            Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Key Lookup = lookup into a clustered index (row-store). RID Lookup = lookup into a heap table (no clustered index). Both are expensive because they require a second random-access I/O per row returned."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Executions"      Binding="{Binding ExecutionCount, StringFormat=N0}"        Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Number of plan executions since it was compiled (use_counts). Multiply by avg logical reads to estimate total I/O pressure from this plan."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Logical Reads" Binding="{Binding TotalLogicalReads, StringFormat=N0}" Width="140">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Cumulative logical reads generated by all executions of this plan. High total reads from a lookup-containing plan indicate significant buffer pool churn."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Avg Logical Reads" Binding="{Binding AvgLogicalReads, StringFormat=N2}"    Width="130">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Average logical reads per execution. A high average combined with high execution count makes this plan a top I/O contributor."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Database"         Binding="{Binding DatabaseName}"                          Width="110" />
                                    <DataGridTextColumn Header="Object"           Binding="{Binding ObjectName}"                            Width="130" />
                                    <DataGridTextColumn Header="Query Text"       Binding="{Binding QueryText}"                             Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ── Tab 3: Cardinality Misestimates (live) ────────────────── -->
                <TabItem Header="Cardinality Misestimates (live)">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Active Queries with Large Cardinality Misestimates ( ≥ 1 000 × )" />
                            <Border Background="#1A7C3AED" BorderBrush="#7C3AED" BorderThickness="1"
                                    CornerRadius="4" Padding="10,6" Margin="0,4,0,10">
                                <TextBlock TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11">
                                    Requires Query Profiling Infrastructure (sys.dm_exec_query_profiles).
                                    Only populated while queries are actively executing with STATISTICS PROFILE or
                                    the lightweight profiling feature enabled (TraceFlag 7412 or database-scoped config).
                                    A ratio ≥ 1 000 means the optimizer guessed far fewer rows than actually flowed
                                    through an operator, leading to under-sized memory grants, bad join strategies,
                                    or serial plans.  Fix: update statistics, use RECOMPILE, or add filtered stats.
                                </TextBlock>
                            </Border>
                            <DataGrid x:Name="CardinalityGrid" MaxHeight="420" IsReadOnly="True"
                                      CanUserAddRows="False" ClipboardCopyMode="IncludeHeader"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AutoGenerateColumns="False"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Session"          Binding="{Binding SessionId}"                                Width="70">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Session ID of the actively executing query. Cross-reference with Active Waits to see current wait state."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Node ID"          Binding="{Binding NodeId}"                                   Width="65">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Query plan node (operator) ID where the misestimate was detected."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Est. Rows"        Binding="{Binding EstimatedRows, StringFormat=N0}"            Width="90">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Row count estimated by the query optimizer when the plan was compiled."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Actual Rows"      Binding="{Binding ActualRows, StringFormat=N0}"               Width="100">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Actual rows that have flowed through this operator so far. Can exceed Estimated Rows if data distribution has changed since statistics were last updated."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Misestimate Ratio" Binding="{Binding MisestimateRatio, StringFormat=N0}"       Width="140">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Actual Rows ÷ Estimated Rows. A ratio of 1 000+ means the optimizer's row estimate was off by more than three orders of magnitude — a strong signal of outdated or missing statistics."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Severity"         Binding="{Binding Severity}"                                  Width="80" />
                                    <DataGridTextColumn Header="Database"         Binding="{Binding DatabaseName}"                              Width="110" />
                                    <DataGridTextColumn Header="Query Text"       Binding="{Binding QueryText}"                                 Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ── Tab 4: Skewed Parallelism (live) ──────────────────────── -->
                <TabItem Header="Skewed Parallelism (live)">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Active Parallel Queries with Unbalanced Thread Distribution ( ≥ 5 × )" />
                            <Border Background="#1A7C3AED" BorderBrush="#7C3AED" BorderThickness="1"
                                    CornerRadius="4" Padding="10,6" Margin="0,4,0,10">
                                <TextBlock TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11">
                                    Requires Query Profiling Infrastructure (sys.dm_exec_query_profiles).
                                    Skew ratio = max thread rows ÷ min thread rows across all parallel workers
                                    at a single plan node.  A ratio ≥ 5 means one thread is doing 5× more work
                                    than another, negating most of the parallelism benefit and causing CXPACKET/
                                    CXCONSUMER waits.  Causes: data skew, non-SARGable predicates after data
                                    partitioning, or hash-join bucket imbalance.
                                </TextBlock>
                            </Border>
                            <DataGrid x:Name="SkewGrid" MaxHeight="420" IsReadOnly="True"
                                      CanUserAddRows="False" ClipboardCopyMode="IncludeHeader"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AutoGenerateColumns="False"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Session"         Binding="{Binding SessionId}"                               Width="70">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Session ID of the actively executing parallel query."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Node ID"         Binding="{Binding NodeId}"                                  Width="65">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Plan node where thread skew was measured. Typically a Repartition Streams, Distribute Streams, or Hash Match operator."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Max Thread Rows" Binding="{Binding MaxActualRows, StringFormat=N0}"          Width="130">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Row count on the busiest thread (highest actual_rows across all workers for this node). This thread is the bottleneck."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Min Thread Rows" Binding="{Binding MinActualRows, StringFormat=N0}"          Width="130">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Row count on the least busy thread. A large gap between Max and Min indicates severe data skew in the partitioning key."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Skew Ratio"      Binding="{Binding SkewRatio, StringFormat=N1}"             Width="90">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Max Thread Rows ÷ Min Thread Rows. A ratio of 5 means one thread processes 5× more data, effectively serializing 80 % of the work onto a single CPU."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Severity"        Binding="{Binding Severity}"                               Width="80" />
                                    <DataGridTextColumn Header="Database"        Binding="{Binding DatabaseName}"                           Width="110" />
                                    <DataGridTextColumn Header="Query Text"      Binding="{Binding QueryText}"                              Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ── Tab 5: Plan Guides ─────────────────────────────────────── -->
                <TabItem Header="Plan Guides">
                    <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Plan Guides — Frozen Query Plans" />
                            <Border Background="#1AFBBF24" BorderBrush="#FBBF24" BorderThickness="1"
                                    CornerRadius="4" Padding="10,6" Margin="0,4,0,10">
                                <TextBlock TextWrapping="Wrap" Foreground="#FBBF24" FontSize="11">
                                    Plan guides force the optimizer to use a specific execution plan regardless
                                    of current statistics, schema changes, or new SQL Server versions.
                                    Disabled guides are shown in red — they are still registered but ignored,
                                    which often indicates a maintenance gap.
                                    Review each guide: ensure it still produces the intended plan and that the
                                    forced plan remains optimal on the current hardware/data volume.
                                </TextBlock>
                            </Border>
                            <DataGrid x:Name="PlanGuidesGrid" MaxHeight="420" IsReadOnly="True"
                                      CanUserAddRows="False" ClipboardCopyMode="IncludeHeader"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AutoGenerateColumns="False"
                                      RowBackground="{StaticResource BgDeep}"
                                      AlternatingRowBackground="{StaticResource BgSidebar}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Guide Name"  Binding="{Binding GuideName}"   Width="160">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Name of the plan guide from sys.plan_guides. Use this name with sp_control_plan_guide to enable, disable, or drop it."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Type"        Binding="{Binding GuideType}"   Width="90">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="OBJECT = applies to a specific stored procedure/trigger. SQL = applies to an ad-hoc statement. TEMPLATE = applies to all parameterized versions of a query template."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Database"    Binding="{Binding DatabaseName}" Width="110" />
                                    <DataGridTextColumn Header="Object"      Binding="{Binding ObjectName}"  Width="130">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="For OBJECT-type guides: the stored procedure or function the guide is attached to. Blank for SQL/TEMPLATE guides."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Disabled"    Binding="{Binding IsDisabled}"  Width="70">
                                        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="True if the plan guide is registered but currently disabled. A disabled guide does not affect query execution."/></Style></DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Query Text"  Binding="{Binding QueryText}"   Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
