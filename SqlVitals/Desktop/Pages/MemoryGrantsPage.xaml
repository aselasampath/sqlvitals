<Page x:Class="SqlVitals.Desktop.Pages.MemoryGrantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Memory"
      Unloaded="Page_Unloaded">
    <!-- The page template (#150): the verdict on queries waiting for memory first; the figures and
         the trend fold to one line; then the clerks and the grants on tabs the Navigator keeps.
         Start and Stop are the top bar's Resume and Pause (#140). -->
    <controls:PageShell x:Name="Shell" Margin="20" Title="Memory" PageKey="Memory">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Interval:" Foreground="{StaticResource TextMuted}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbInterval" Width="75" Height="26" FontSize="11"
                          Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource Border}" VerticalContentAlignment="Center"
                          SelectionChanged="CmbInterval_SelectionChanged"
                          ToolTip="How often the memory figures are read while trending. Resume (▶) in the top bar starts it, Pause stops it."
                          Margin="0,0,8,0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="5s" />
                    <ComboBoxItem Content="10s" IsSelected="True" />
                    <ComboBoxItem Content="30s" />
                    <ComboBoxItem Content="60s" />
                </ComboBox>
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="4" Padding="10,3" Height="26" ToolTip="Seconds to the next read; -- while paused">
                    <TextBlock x:Name="TxtCountdown" Text="--"
                               Foreground="{StaticResource Accent}" FontSize="12"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </controls:PageShell.Actions>

        <controls:PageShell.Sections>
            <controls:FoldSection x:Name="FiguresSection" Key="figures" Header="Figures">
                <Border Background="{StaticResource BgCard}" Padding="18,10" CornerRadius="6"
                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                <WrapPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Physical Memory" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiPhysical" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="SQL Server Memory" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiTotal" Text="--" Foreground="#38BDF8"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Target Memory" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiTarget" Text="--" Foreground="#60A5FA"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Buffer Pool" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiBuffer" Text="--" Foreground="#34D399"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Plan Cache" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiPlanCache" Text="--" Foreground="#A78BFA"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Available Physical" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiAvailPhys" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Total Page File" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiPageFile" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Available Page File" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiAvailPage" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="System Memory State" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiMemState" Text="--" Foreground="#34D399"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Memory Model" Foreground="{StaticResource TextMuted}" FontSize="10" />
                        <TextBlock x:Name="KpiMemModel" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </WrapPanel>
                </Border>
            </controls:FoldSection>
            <controls:FoldSection x:Name="TrendSection" Key="trend" Header="Trend (GB)">
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <Grid Height="170">
                        <lvc:CartesianChart x:Name="MemChart"
                                            Background="Transparent"
                                            TooltipPosition="Top"
                                            LegendPosition="Bottom" />
                        <TextBlock x:Name="TxtNoData"
                                   Text="Press Resume (▶) in the top bar to trend memory"
                                   Foreground="{StaticResource TextMuted}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible" />
                    </Grid>
                </Border>
            </controls:FoldSection>
        </controls:PageShell.Sections>

        <TabControl x:Name="Tabs" Background="{StaticResource BgDeep}"
                    BorderBrush="{StaticResource Border}"
                    Foreground="{StaticResource TextPrimary}">
            <TabItem x:Name="TabClerks" Header="Memory Clerks">
                <!-- The chart beside the grid, so the grid keeps its height under the folds (#150). -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="260" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Top Memory Clerks (MB)" Style="{StaticResource SectionHeader}" />
                            <lvc:CartesianChart x:Name="ClerksChart" MinHeight="120"
                                                TooltipPosition="Top" LegendPosition="Hidden" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                        <DataGrid x:Name="ClerksGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Clerk Type"   Binding="{Binding ClerkType}"                              Width="160" />
                                <DataGridTextColumn Header="Clerk Name"   Binding="{Binding ClerkName}"                              Width="200" />
                                <DataGridTextColumn Header="Total (MB)"   Binding="{Binding TotalPagesMB, StringFormat=N0}"          Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total (KB)"   Binding="{Binding TotalPagesKB, StringFormat=N0}"          Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="% of Total"   Binding="{Binding PctOfTotalMemory, StringFormat=N1}"      Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabGrants" Header="Memory Grants">
                <Border Style="{StaticResource KpiCard}" Margin="0,10,0,0">
                    <DataGrid x:Name="GrantsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Session ID"   Binding="{Binding SessionId}"                               Width="80" />
                            <DataGridTextColumn Header="Login"        Binding="{Binding LoginName}"                               Width="120" />
                            <DataGridTextColumn Header="Database"     Binding="{Binding DatabaseName}"                            Width="100" />
                            <DataGridTextColumn Header="Requested KB" Binding="{Binding RequestedMemoryKB, StringFormat=N0}"      Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Granted KB"   Binding="{Binding GrantedMemoryKB, StringFormat=N0}"        Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Used KB"      Binding="{Binding UsedMemoryKB, StringFormat=N0}"           Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Used %"       Binding="{Binding MemGrantUsedPct, StringFormat=N1}"        Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Wait ms"      Binding="{Binding WaitForGrantMs, StringFormat=N0}"         Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Pending"      Binding="{Binding IsPending}"                               Width="65" />
                            <DataGridTextColumn Header="Severity"     Binding="{Binding Severity}"                                Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </controls:PageShell>
</Page>
