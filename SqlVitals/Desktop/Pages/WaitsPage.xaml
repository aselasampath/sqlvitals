<Page x:Class="SqlVitals.Desktop.Pages.WaitsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
      Background="{StaticResource BgDeep}" Title="Waits">
    <!-- The page template (#149): the verdict first, the top 15 folding to one line, then the trend
         of the wait types picked above the top waits for the range (#178: Wait Trend and Top Waits
         were two pages). Start and Stop are the top bar's Resume and Pause (#140). -->
    <controls:PageShell x:Name="Shell" Margin="16,12,16,12" Title="Waits" PageKey="Waits">
        <controls:PageShell.Actions>
            <StackPanel Orientation="Horizontal">
                    <!-- Metric selector -->
                    <TextBlock Text="Metric:"
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbMetric"
                              Width="200" Height="26" FontSize="11"
                              Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                              BorderBrush="{StaticResource Border}" VerticalContentAlignment="Center"
                              SelectionChanged="CmbMetric_SelectionChanged"
                              Margin="0,0,20,0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Wait Time (ms/sec)"     IsSelected="True" />
                        <ComboBoxItem Content="Signal Wait (ms/sec)" />
                        <ComboBoxItem Content="Resource Wait (ms/sec)" />
                        <ComboBoxItem Content="Waiting Tasks/sec" />
                    </ComboBox>

                    <!-- Interval -->
                    <TextBlock Text="Interval:"
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbInterval"
                              Width="80" Height="26" FontSize="11"
                              Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                              BorderBrush="{StaticResource Border}" VerticalContentAlignment="Center"
                              SelectionChanged="CmbInterval_SelectionChanged"
                              ToolTip="How often the waits are read while live. Resume (▶) in the top bar starts reading, Pause stops it."
                              Margin="0,0,8,0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="5s" />
                        <ComboBoxItem Content="10s" IsSelected="True" />
                        <ComboBoxItem Content="30s" />
                        <ComboBoxItem Content="60s" />
                    </ComboBox>

                    <!-- Countdown badge -->
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="4" Padding="10,3" Height="26" Margin="0,0,12,0"
                            ToolTip="Seconds to the next read; -- while paused">
                        <TextBlock x:Name="TxtCountdown" Text="--"
                                   Foreground="{StaticResource Accent}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Live, or a past range from the monitoring history; and the baseline. In the top bar (#140). -->
                    <controls:TimeRangePicker x:Name="RangePicker"
                                              RangeChanged="RangePicker_RangeChanged"
                                              BaselineChanged="RangePicker_BaselineChanged" />
            </StackPanel>
        </controls:PageShell.Actions>

        <controls:PageShell.Sections>
            <controls:FoldSection x:Name="ChartSection" Key="chart" Header="Top 15 — Wait Time (sec)">
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <lvc:CartesianChart x:Name="TopChart" Height="150" Background="Transparent" TooltipPosition="Top" LegendPosition="Hidden" />
                </Border>
            </controls:FoldSection>
        </controls:PageShell.Sections>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

    <!-- ─── The trend ─────────────────────────────────────────────────── -->
    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="160" MaxWidth="340" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ─── LEFT: Wait Type Selector ──────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Title -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Select Wait Types"
                           Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                           Margin="12,14,12,8" />

                <!-- Top 20 / Clear All -->
                <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnTopWaits" Grid.Column="0"
                            Content="Top 20"
                            ToolTip="Tick the 20 wait types that waited the most: since the server started, or over the range picked"
                            Margin="0,0,3,0" Padding="6,5" FontSize="11"
                            Background="#1A93C5FD" Foreground="#93C5FD"
                            BorderBrush="#93C5FD" BorderThickness="1"
                            Click="BtnTopWaits_Click" />
                    <Button x:Name="BtnClearAll" Grid.Column="1"
                            Content="Clear All"
                            Margin="3,0,0,0" Padding="6,5" FontSize="11"
                            Background="#1A93C5FD" Foreground="#93C5FD"
                            BorderBrush="#93C5FD" BorderThickness="1"
                            Click="BtnClearAll_Click" />
                </Grid>

                <!-- Selected count -->
                <TextBlock x:Name="TxtSelCount" DockPanel.Dock="Top"
                           Text="0 / 0 selected"
                           Foreground="{StaticResource TextMuted}" FontSize="11"
                           Margin="12,0,12,6" />

                <!-- Search / Filter -->
                <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
                    <TextBox x:Name="TxtSearch"
                             Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"
                             Padding="6,5" FontSize="11"
                             TextChanged="TxtSearch_TextChanged" />
                    <TextBlock Text="Filter wait types…"
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               Padding="8,5" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Wait type checkbox list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WaitTypeList" Margin="4,0,4,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding WaitType}"
                                          IsChecked="{Binding IsChecked}"
                                          Foreground="{StaticResource TextPrimary}" Margin="4,2" FontSize="11"
                                          Checked="WaitType_CheckChanged"
                                          Unchecked="WaitType_CheckChanged" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ─── SPLITTER ──────────────────────────────────────────────── -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource Border}" ResizeDirection="Columns" />

        <!-- ─── RIGHT: Chart area ─────────────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chart + no-data overlay -->
            <Grid Grid.Row="0">
                <lvc:CartesianChart x:Name="TrendChart"
                                    Background="Transparent"
                                    TooltipPosition="Top"
                                    LegendPosition="Bottom" />
                <TextBlock x:Name="TxtNoData"
                           Text="Select wait types on the left, then press Resume (▶) in the top bar to begin trending"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"
                           Foreground="{StaticResource TextMuted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Visible" />
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="1" Background="{StaticResource BgCard}" Padding="12,4"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left"
                               Text="Ready — tick wait types, then press Resume (▶) in the top bar"
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtMaxNote" DockPanel.Dock="Right"
                               Foreground="{StaticResource Warning}" FontSize="11"
                               VerticalAlignment="Center" Text="" />
                </DockPanel>
            </Border>

        </Grid>
    </Grid>

    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Margin="0,4"
                  Background="{StaticResource Border}" ResizeDirection="Rows" />

    <!-- ─── The top waits, for the range: since the server started while live (#178) ─── -->
    <Border Grid.Row="2" Style="{StaticResource KpiCard}" Margin="0">
        <DockPanel>
            <TextBlock x:Name="TxtTopHeader" DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"
                       Text="Top wait types since the server started" />
            <DataGrid x:Name="WaitsGrid" AutomationProperties.Name="Top wait types">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rank"       Binding="{Binding WaitRank}"           Width="50" />
                    <DataGridTextColumn Header="Wait Type"  Binding="{Binding WaitType}"           Width="200" />
                    <DataGridTextColumn Header="Category"   Binding="{Binding WaitCategory}"       Width="100" />
                    <DataGridTextColumn Header="Wait (sec)" Binding="{Binding WaitTimeSec, StringFormat=N1}" Width="90" />
                    <DataGridTextColumn Header="Avg ms/task" Binding="{Binding AvgWaitMsPerTask, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Tasks"      Binding="{Binding WaitingTasksCount}"  Width="70" />
                    <DataGridTextColumn Header="% of Total" Binding="{Binding PctOfTotal, StringFormat=N1}" Width="80" />
                    <DataGridTextColumn Header="Cumul %"    Binding="{Binding CumulativePct, StringFormat=N1}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
    </Grid>
    </controls:PageShell>
</Page>
