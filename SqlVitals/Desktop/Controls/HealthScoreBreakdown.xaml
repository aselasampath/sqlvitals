<UserControl x:Class="SqlVitals.Desktop.Controls.HealthScoreBreakdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <!-- Shown in a popup when a health score is clicked (#36): the score, and each check's share of it. -->
    <Border x:Name="Frame" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="6" Padding="16,12" MinWidth="420" MaxWidth="560">
        <StackPanel>
            <DockPanel x:Name="Header">
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <Run x:Name="RunScore" FontSize="26" FontWeight="Bold" /><Run
                         Text=" / 100" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                </TextBlock>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Health score" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock x:Name="TxtSubtitle" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </DockPanel>

            <!-- The worst state and its reason before anything else (#173): "Critical: blocking for 4 min" -->
            <TextBlock x:Name="TxtVerdict" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

            <TextBlock x:Name="TxtLoweredBy" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" />

            <!-- One row per check, built in code. -->
            <Grid x:Name="GridChecks" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- Checks with no data, which the score leaves out (#173) -->
            <TextBlock x:Name="TxtLeftOut" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextPrimary}" />

            <TextBlock x:Name="TxtFootnote" Margin="0,10,0,0" FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="Each check's weight is shared out over the checks that reported, so the score is always out of 100: that is its worth. Past its warning threshold it loses half; past critical, all of it. A check with no data is left out, never counted as passing. A server that can't be reached scores 0. Thresholds and weights: Settings → Health thresholds." />
        </StackPanel>
    </Border>
</UserControl>
