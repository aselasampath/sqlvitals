<UserControl x:Class="SqlVitals.Desktop.Controls.HealthScoreBreakdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <!-- Shown in a popup when a health score is clicked (#36): the score, and each check's share of it. -->
    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="6" Padding="16,12" MinWidth="420" MaxWidth="560">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <Run x:Name="RunScore" FontSize="26" FontWeight="Bold" /><Run
                         Text=" / 100" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                </TextBlock>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Health score" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock x:Name="TxtSubtitle" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxtLoweredBy" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" />

            <!-- One row per check, built in code. -->
            <Grid x:Name="GridChecks" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>

            <TextBlock x:Name="TxtFootnote" Margin="0,10,0,0" FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="Each check is worth its weight in points. Past its warning threshold it loses half; past critical, all of it. A server that can't be reached scores 0. Thresholds: Settings → Health Thresholds." />
        </StackPanel>
    </Border>
</UserControl>
