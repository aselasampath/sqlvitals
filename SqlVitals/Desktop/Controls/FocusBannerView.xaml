<UserControl x:Class="SqlVitals.Desktop.Controls.FocusBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
    <!-- "Opened from alert" (#145): what a page opened as evidence shows, and the way back to all of it. -->
    <Border x:Name="Frame" Margin="16,10,16,0" Padding="12,7" CornerRadius="8" BorderThickness="1"
            AutomationProperties.Name="Opened from alert">
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.12"/>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.45"/>
        </Border.BorderBrush>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <TextBlock x:Name="ShowAllCell" VerticalAlignment="Center" FontSize="12.5">
                    <Hyperlink x:Name="LinkShowAll" Click="ShowAll_Click" Foreground="{DynamicResource AccentLight}"
                               ToolTip="Clear the filter: the page as the sidebar opens it">
                        <Run x:Name="RunShowAll" Text="Show all"/>
                    </Hyperlink>
                </TextBlock>
                <Button x:Name="BtnClose" Content="&#xE711;" Click="Close_Click" Margin="10,0,0,0"
                        Style="{StaticResource NavArrowButton}" Width="22" Height="22" FontSize="10"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" BorderBrush="Transparent"
                        AutomationProperties.Name="Hide this banner" ToolTip="Hide this banner; the page stays as it is"/>
            </StackPanel>
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextPrimary}">
                    <Run x:Name="RunTitle" Text="Opened from alert" FontWeight="SemiBold"/><Run Text="   "/><Run
                         x:Name="RunWhat" Foreground="{DynamicResource TextMuted}"/>
                </TextBlock>
                <TextBlock x:Name="PastLine" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextMuted}" Visibility="Collapsed">
                    <Run x:Name="RunPast"/><Run x:Name="RunGap" Text="  "/><Hyperlink x:Name="LinkHistory" Click="History_Click"
                         Foreground="{DynamicResource AccentLight}"><Run x:Name="RunHistory"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
