<UserControl x:Class="SqlVitals.Desktop.Controls.TimeRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <!-- Segmented button: one of Live / 1h / 24h / 7d / Custom is checked. -->
        <Style x:Key="RangeButton" TargetType="RadioButton">
            <Setter Property="GroupName"   Value="Range" />
            <Setter Property="MinWidth"    Value="38" />
            <Setter Property="Height"      Value="24" />
            <Setter Property="Padding"     Value="8,0" />
            <Setter Property="FontFamily"  Value="Segoe UI" />
            <Setter Property="FontSize"    Value="11" />
            <Setter Property="Cursor"      Value="Hand" />
            <Setter Property="Foreground"  Value="{DynamicResource TextMuted}" />
            <Setter Property="Background"  Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily"        Value="Segoe UI" />
            <Setter Property="FontSize"          Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TimeBox" TargetType="TextBox">
            <Setter Property="Width"                    Value="52" />
            <Setter Property="Height"                   Value="24" />
            <Setter Property="Margin"                   Value="6,0,0,0" />
            <Setter Property="Padding"                  Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background"               Value="{DynamicResource BgDeep}" />
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush"               Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"              Value="{DynamicResource Border}" />
            <Setter Property="FontFamily"               Value="Segoe UI" />
            <Setter Property="FontSize"                 Value="12" />
            <Setter Property="ToolTip"                  Value="Time on this PC's clock, 24-hour, for example 09:30" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BtnLive"   Content="Live"   Style="{StaticResource RangeButton}" IsChecked="True"
                             Click="Preset_Click" ToolTip="Live data, collected as you watch" />
                <RadioButton x:Name="BtnHour"   Content="1h"     Style="{StaticResource RangeButton}"
                             Click="Preset_Click" ToolTip="The last hour, from the monitoring history" />
                <RadioButton x:Name="BtnDay"    Content="24h"    Style="{StaticResource RangeButton}"
                             Click="Preset_Click" ToolTip="The last 24 hours, from the monitoring history" />
                <RadioButton x:Name="BtnWeek"   Content="7d"     Style="{StaticResource RangeButton}"
                             Click="Preset_Click" ToolTip="The last 7 days, from the monitoring history" />
                <RadioButton x:Name="BtnCustom" Content="Custom…" Style="{StaticResource RangeButton}"
                             Click="Custom_Click" ToolTip="Pick a start and end from the monitoring history" />
            </StackPanel>
        </Border>

        <!-- Stays open until Show, Cancel or Esc: with StaysOpen=False a click in a date's
             calendar, itself a popup, would close this one. -->
        <Popup x:Name="CustomPopup" PlacementTarget="{Binding ElementName=BtnCustom}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" VerticalOffset="4" Closed="CustomPopup_Closed">
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="12" Width="300"
                    PreviewKeyDown="CustomPopup_PreviewKeyDown">
                <StackPanel>
                    <TextBlock Text="Custom range" Foreground="{DynamicResource TextPrimary}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="FromDate" Grid.Column="1" Height="24" FontSize="12" />
                        <TextBox x:Name="FromTime" Grid.Column="2" Style="{StaticResource TimeBox}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="ToDate" Grid.Column="1" Height="24" FontSize="12" />
                        <TextBox x:Name="ToTime" Grid.Column="2" Style="{StaticResource TimeBox}" />
                    </Grid>

                    <TextBlock x:Name="TxtError" Foreground="{DynamicResource Danger}" FontFamily="Segoe UI" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{DynamicResource SecondaryButton}" Padding="12,4" Margin="0,0,6,0"
                                Click="CustomCancel_Click" />
                        <Button Content="Show" Style="{DynamicResource RefreshButton}" Padding="12,4"
                                Click="CustomApply_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
