<UserControl x:Class="SqlVitals.Desktop.Controls.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,6" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DarkComboItem}" />
        </Style>
        <Style x:Key="SingleLineText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <WrapPanel>
            <TextBlock Text="Connection:" Style="{StaticResource FilterLabel}" />
            <ComboBox x:Name="CmbConnection" Width="170" Style="{StaticResource FilterCombo}"
                      AutomationProperties.Name="Connection"
                      SelectionChanged="Filter_SelectionChanged" />
            <TextBlock Text="Event:" Style="{StaticResource FilterLabel}" />
            <ComboBox x:Name="CmbEvent" Width="150" Style="{StaticResource FilterCombo}"
                      AutomationProperties.Name="Event"
                      SelectionChanged="Filter_SelectionChanged" />
            <TextBlock Text="Period:" Style="{StaticResource FilterLabel}" />
            <ComboBox x:Name="CmbPeriod" Width="120" Style="{StaticResource FilterCombo}"
                      AutomationProperties.Name="Period"
                      SelectionChanged="Filter_SelectionChanged" />
        </WrapPanel>

        <Grid Height="320" Margin="0,4,0,0">
            <DataGrid x:Name="ActivityGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      AutomationProperties.Name="Activity log">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat='{}{0:d MMM yyyy HH:mm:ss}'}" Width="135"
                                        ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="130" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionName}" Width="120" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="150" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="Old value" Binding="{Binding OldValue}" Width="110" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="New value" Binding="{Binding NewValue}" Width="110" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="220" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="Windows user" Binding="{Binding WindowsUser}" Width="130" ElementStyle="{StaticResource SingleLineText}" />
                    <DataGridTextColumn Header="PC" Binding="{Binding Machine}" Width="110" ElementStyle="{StaticResource SingleLineText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TxtNoData" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                       Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,70,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>

        <DockPanel Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnRefresh" Style="{DynamicResource SecondaryButton}" Padding="12,5" Margin="0,0,8,0"
                        Content="↻  Refresh" Click="BtnRefresh_Click" />
                <Button x:Name="BtnExport" Style="{DynamicResource SecondaryButton}" Padding="12,5"
                        Content="📤  Export CSV" Click="BtnExport_Click"
                        ToolTip="Save the rows shown, in this order, as a CSV file" />
            </StackPanel>
            <TextBlock x:Name="TxtCount" Foreground="{DynamicResource TextMuted}" FontSize="11"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</UserControl>
