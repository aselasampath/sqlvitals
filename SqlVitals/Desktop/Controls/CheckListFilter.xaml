<UserControl x:Class="SqlVitals.Desktop.Controls.CheckListFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26" VerticalAlignment="Center">
    <!-- A multi-select filter box (#237) on a MultiFilterChoices, its DataContext: closed, what's
         ticked; open, "(All)" and a check box per value. -->
    <Grid>
        <ToggleButton x:Name="BtnOpen" Cursor="Hand"
                      IsChecked="{Binding IsOpen, ElementName=DropList, Mode=TwoWay}"
                      ToolTip="{Binding ToolTipText}"
                      AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=UserControl}}"
                      AutomationProperties.HelpText="{Binding Summary}">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" Padding="6,0,4,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="TxtSummary" Text="{Binding Summary}" Foreground="{TemplateBinding Foreground}"
                                                   FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Filtering: the box stands out. -->
                        <DataTrigger Binding="{Binding IsAll}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource AccentLight}" />
                        </DataTrigger>
                        <!-- Open: a click on the box is a click outside, which closes the list; it
                             mustn't open it again. -->
                        <DataTrigger Binding="{Binding IsOpen, ElementName=DropList}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>

        <Popup x:Name="DropList" PlacementTarget="{Binding ElementName=BtnOpen}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
               Opened="DropList_Opened" Closed="DropList_Closed" PreviewKeyDown="DropList_PreviewKeyDown">
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    MinWidth="{Binding ActualWidth, ElementName=BtnOpen}" MaxWidth="360" Padding="6,4">
                <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontFamily" Value="Segoe UI" />
                                <Setter Property="FontSize"   Value="11" />
                                <Setter Property="Margin"     Value="0,3" />
                                <Setter Property="Cursor"     Value="Hand" />
                            </Style>
                        </StackPanel.Resources>
                        <CheckBox x:Name="ChkAll" Content="(All)" IsChecked="{Binding IsAll}"
                                  ToolTip="No filter: every value. Ticking it clears the ticks." />
                        <Border Height="1" Margin="0,3" Background="{DynamicResource Border}" />
                        <!-- Virtualized: a box may hold hundreds of hosts or logins; only those in view get a check box. -->
                        <ItemsControl x:Name="ChoiceList" ItemsSource="{Binding Items}" Focusable="False" MaxHeight="300"
                                      VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer Focusable="False" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}">
                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoValues" Text="No values captured yet." Margin="0,3"
                                   Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ChoiceList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
