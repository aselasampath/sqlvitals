<UserControl x:Class="SqlVitals.Desktop.Controls.HealthThresholdsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <!-- The Checks table of a server's detail page (#130), with Warning and Critical as boxes (#131):
         a row per HealthIndicator, built in code from HealthThresholds.Indicators. -->
    <Grid x:Name="GridRows">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="170" />
            <ColumnDefinition x:Name="ColNow" Width="110" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition x:Name="ColPoints" Width="64" />
        </Grid.ColumnDefinitions>
    </Grid>
</UserControl>
