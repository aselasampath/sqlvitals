<UserControl x:Class="SqlVitals.Desktop.Controls.ProcessMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
      <!-- Panel close [x] button -->
      <Style x:Key="CloseButton" TargetType="{x:Type Button}">
        <Setter Property="Width"           Value="18"/>
        <Setter Property="Height"          Value="18"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="#88AABB"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                  CornerRadius="3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#44FF4444"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Grid view (#116): a state filter chip, on while its sessions are shown -->
      <Style x:Key="StateChip" TargetType="ToggleButton">
        <Setter Property="Height"      Value="24"/>
        <Setter Property="Padding"     Value="8,0"/>
        <Setter Property="Margin"      Value="0,0,6,0"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="IsChecked"   Value="True"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextMuted}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                           Fill="{TemplateBinding Background}" Opacity="0.35"/>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
                  <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="NumberCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
      </Style>

      <!-- Grid cells are one TextBlock each: a refresh rebuilds every visible row, so a template
           with a Hyperlink or ToolTip element per cell made it several times slower. -->

      <!-- A SPID to go to: underlined, so it reads as a link without relying on colour. The click
           is handled once, on the grid (ProcessGrid_PreviewMouseLeftButtonUp). -->
      <Style x:Key="BlockedByCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
        <Setter Property="ToolTip" Value="{Binding BlockedByTooltip}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding BlockedByIsLink}" Value="True">
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Cursor" Value="Hand"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding HeadIsLink}" Value="True">
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Go to the head of this session's chain"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- The theme's cell, with a bar in the state's colour down its left edge -->
      <Style x:Key="StateCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                      BorderBrush="{Binding StateBrush}" BorderThickness="4,0,0,0">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="QueryCell" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="Consolas"/>
        <Setter Property="TextTrimming"  Value="CharacterEllipsis"/>
        <!-- A string: the ToolTip itself is only made when the pointer rests on the cell -->
        <Setter Property="ToolTip"       Value="{Binding QueryTooltip}"/>
      </Style>

      <!-- Group header: the login and its summary; the stripe says where the blocking is -->
      <Style x:Key="LoginGroup" TargetType="GroupItem">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GroupItem">
              <StackPanel>
                <ToggleButton x:Name="PART_Header" IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}"
                              Cursor="Hand" Focusable="False"
                              ToolTip="Show or hide this login's sessions">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="Bd" Background="{DynamicResource BgSidebar}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                          <Border x:Name="Stripe" DockPanel.Dock="Left" Width="4" Background="Transparent"/>
                          <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="▾" Width="16" Margin="6,0,0,0"
                                     VerticalAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource TextMuted}"/>
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Name.Name}" Margin="0,6,12,6"
                                     VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimary}"/>
                          <TextBlock Text="{Binding Name.Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                          <Setter TargetName="Arrow" Property="Text" Value="▸"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Name.HasBlocked}" Value="True">
                          <Setter TargetName="Stripe" Property="Background" Value="#6060FF"/>
                        </DataTrigger>
                        <!-- After HasBlocked, so a group with both shows the head blocker's colour -->
                        <DataTrigger Binding="{Binding Name.HasHeadBlocker}" Value="True">
                          <Setter TargetName="Stripe" Property="Background" Value="#FF8000"/>
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ItemsPresenter x:Name="Items"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding Name.IsExpanded}" Value="False">
                  <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- process map header -->
            <RowDefinition Height="Auto"/>
            <!-- head blockers -->
            <RowDefinition Height="Auto"/>
            <!-- legend -->
            <RowDefinition Height="Auto"/>
            <!-- grid filters (grid view only) -->
            <RowDefinition Height="*"/>
            <!-- canvas or grid -->
        </Grid.RowDefinitions>

        <!-- Process Map Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <!-- Grid view: grouping (#116) -->
            <StackPanel x:Name="GridControls" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left"
                        Margin="0,0,12,0" Visibility="Collapsed">
                <CheckBox x:Name="ChkGroupByLogin" Content="Group by login" IsChecked="True"
                          Foreground="{DynamicResource TextPrimary}" Cursor="Hand" VerticalAlignment="Center"
                          FontFamily="Segoe UI" FontSize="12" Margin="0,0,12,0"
                          ToolTip="One group per login, problems first; untick for one flat list"
                          Checked="ChkGroupByLogin_Changed" Unchecked="ChkGroupByLogin_Changed"/>
                <Button x:Name="BtnExpandAll" Content="Expand all" Click="BtnExpandAll_Click" Height="26" Padding="8,0"
                        Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="11" Cursor="Hand"/>
                <Button x:Name="BtnCollapseAll" Content="Collapse all" Click="BtnCollapseAll_Click" Height="26" Padding="8,0"
                        Margin="4,0,0,0"
                        Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="11" Cursor="Hand"/>
            </StackPanel>
            <!-- Zoom controls -->
            <StackPanel x:Name="ZoomControls" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,12,0">
                <Button Content="−" Click="BtnZoomOut_Click" Width="26" Height="26"
                        Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="14"
                        Cursor="Hand" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock x:Name="TxtZoomLevel" Text="100%" Width="42" TextAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="11" Margin="4,0"/>
                <Button Content="+" Click="BtnZoomIn_Click" Width="26" Height="26"
                        Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="14"
                        Cursor="Hand" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <Button Content="Reset" Click="BtnZoomReset_Click" Height="26"
                        Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="11"
                        Cursor="Hand" Padding="6,0" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                <CheckBox x:Name="ChkChainsOnly" Content="Blocking chains only" Foreground="{DynamicResource TextPrimary}" Cursor="Hand"
                          VerticalAlignment="Center" Margin="0,0,14,0" FontFamily="Segoe UI" FontSize="12"
                          ToolTip="Hide sessions that aren't blocking or blocked"
                          Checked="ChkChainsOnly_Changed" Unchecked="ChkChainsOnly_Changed"/>
                <TextBlock Text="Search SPID:" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="12"/>
                <TextBox x:Name="TxtProcSearch" Width="100" Height="26"
                         Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource Border}" BorderThickness="1"
                         Padding="4,2" FontFamily="Segoe UI" FontSize="12"
                         TextChanged="TxtProcSearch_TextChanged" VerticalContentAlignment="Center"/>
                <Button Content="Show Legend" Margin="12,0,0,0" Height="26" Padding="8,0"
                        Background="Transparent" BorderBrush="{DynamicResource Accent}"
                        BorderThickness="1" Foreground="{DynamicResource Accent}"
                        FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                        Click="BtnProcLegend_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Head blockers: one chip per chain; clicking it goes to the head -->
        <WrapPanel Grid.Row="1" x:Name="ChainSummary" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TxtChainSummary" Text="No blocking" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Margin="0,0,8,0"/>
            <WrapPanel x:Name="HeadBlockerChips" Orientation="Horizontal"/>
        </WrapPanel>

        <!-- Legend (collapsed by default) -->
        <Border Grid.Row="2" x:Name="ProcLegendPanel" Visibility="Collapsed"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#FF6060" Offset="0"/>
                                <GradientStop Color="#AA0000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Active / Running" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#FF9030" Offset="0"/>
                                <GradientStop Color="#C04000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Head Blocker" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#9090FF" Offset="0"/>
                                <GradientStop Color="#0000CC" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Blocked" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                <GradientStop Color="#60AAFF" Offset="0"/>
                                <GradientStop Color="#2244AA" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Sleeping" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grid view filters (#116): by state, and by any text in a row -->
        <DockPanel Grid.Row="3" x:Name="GridFilters" Margin="0,0,0,8" Visibility="Collapsed">
            <controls:GridFilterBox x:Name="GridFilter" DockPanel.Dock="Right" Target="{Binding ElementName=ProcessGrid}"
                                    FilterChanged="GridFilter_FilterChanged"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Show:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="12" Margin="0,0,8,0"/>
                <ToggleButton x:Name="ChipHeadBlocker" Style="{StaticResource StateChip}" Background="#FF8000"
                              Tag="HeadBlocker" Click="StateChip_Click" ToolTip="Show or hide head blockers"/>
                <ToggleButton x:Name="ChipBlocked" Style="{StaticResource StateChip}" Background="#6060FF"
                              Tag="Blocked" Click="StateChip_Click" ToolTip="Show or hide blocked sessions"/>
                <ToggleButton x:Name="ChipActive" Style="{StaticResource StateChip}" Background="#FF4040"
                              Tag="Active" Click="StateChip_Click" ToolTip="Show or hide sessions running a request"/>
                <ToggleButton x:Name="ChipSleeping" Style="{StaticResource StateChip}" Background="#4488FF"
                              Tag="Sleeping" Click="StateChip_Click" ToolTip="Show or hide sleeping sessions"/>
            </StackPanel>
        </DockPanel>

        <!-- Canvas or grid -->
        <Border Grid.Row="4" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <!-- Grid view (#116): one row per session, grouped by login -->
                <!-- Rows are virtualised, grouped or not; columns aren't: with twenty of them, column
                     virtualization made each refresh several times slower to lay out. -->
                <DataGrid x:Name="ProcessGrid" Visibility="Collapsed"
                          SelectionMode="Extended" CanUserSortColumns="True"
                          EnableColumnVirtualization="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SelectionChanged="ProcessGrid_SelectionChanged">
                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource LoginGroup}">
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <DataGridRowsPresenter/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SPID" Binding="{Binding SessionId}" Width="55"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <!-- A bar in the state's colour, as on the map; the word says it without colour -->
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" SortMemberPath="StateRank"
                                            CellStyle="{StaticResource StateCell}"/>
                        <DataGridTextColumn x:Name="BlockedByColumn" Header="Blocked by" Binding="{Binding BlockedBy}" Width="75"
                                            ElementStyle="{StaticResource BlockedByCell}"/>
                        <DataGridTextColumn Header="Blocking" Binding="{Binding Blocking}" Width="65"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn x:Name="HeadColumn" Header="Head of chain" Binding="{Binding HeadOfChain}" Width="90"
                                            ElementStyle="{StaticResource HeadCell}"/>
                        <!-- Only in the flat list: grouped, the login is in the group header -->
                        <DataGridTextColumn x:Name="LoginColumn" Header="Login" Binding="{Binding Login}" Width="140"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Status"   Binding="{Binding Status}"   Width="85"/>
                        <DataGridTextColumn Header="Host"     Binding="{Binding Host}"     Width="110"/>
                        <DataGridTextColumn Header="Program"  Binding="{Binding Program}"  Width="160"/>
                        <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="110"/>
                        <DataGridTextColumn Header="Command"  Binding="{Binding Command}"  Width="135"/>
                        <DataGridTextColumn Header="Wait type" Binding="{Binding WaitType}" Width="130"/>
                        <DataGridTextColumn Header="Wait (s)" Binding="{Binding WaitSec, StringFormat=N2}" Width="65"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn Header="Wait resource" Binding="{Binding WaitResource}" Width="130"/>
                        <DataGridTextColumn Header="CPU (ms)" Binding="{Binding CpuMs, StringFormat=N0}" Width="80"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn Header="Physical I/O" Binding="{Binding PhysicalIo, StringFormat=N0}" Width="85"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn Header="Memory (pages)" Binding="{Binding Memory, StringFormat=N0}" Width="100"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn Header="Open tran" Binding="{Binding OpenTran}" Width="70"
                                            ElementStyle="{StaticResource NumberCell}"/>
                        <DataGridTextColumn Header="Login time" Binding="{Binding LoginTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="130"/>
                        <DataGridTextColumn Header="Last batch" Binding="{Binding LastBatch, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="130"/>
                        <DataGridTextColumn Header="Query text" Binding="{Binding QueryFirstLine}" Width="420"
                                            ElementStyle="{StaticResource QueryCell}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer x:Name="ProcessScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ProcessScrollViewer_PreviewMouseWheel">
                    <Canvas x:Name="ProcessCanvas" MinWidth="800" MinHeight="460"
                            Background="Transparent"
                            MouseMove="ProcCanvas_MouseMove">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                        </Canvas.LayoutTransform>
                    </Canvas>
                </ScrollViewer>

                <!-- Floating overlay — transparent to clicks where the panel isn't shown -->
                <Canvas x:Name="OverlayCanvas" ClipToBounds="True">

                    <!-- Draggable Session Details Panel -->
                    <Border x:Name="ProcDetailsPopup" Visibility="Collapsed"
                            Width="380" Padding="0"
                            Background="#F5F5F5" BorderBrush="#9090BB" BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Color="Black" Opacity="0.45" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Drag handle title bar -->
                            <Border x:Name="ProcDetailsDragBar" Grid.Row="0"
                                    Background="#2A2A4A" Padding="10,8" CornerRadius="6,6,0,0"
                                    Cursor="SizeAll"
                                    MouseLeftButtonDown="ProcDetailsDrag_MouseLeftButtonDown"
                                    MouseMove="ProcDetailsDrag_MouseMove"
                                    MouseLeftButtonUp="ProcDetailsDrag_MouseLeftButtonUp">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="&#x2715;" Foreground="#FF6666"
                                            Background="Transparent" BorderThickness="0"
                                            FontWeight="Bold" FontSize="14" Cursor="Hand"
                                            Padding="6,0" Click="BtnCloseProcDetails_Click"/>
                                    <TextBlock Text="&#x2630;  Session Details" FontWeight="Bold" FontSize="13"
                                               Foreground="#DDDDEE" VerticalAlignment="Center"
                                               FontFamily="Segoe UI"/>
                                </DockPanel>
                            </Border>

                            <!-- Scrollable content -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          MaxHeight="520" Padding="12,8,12,12">
                                <StackPanel>
                                    <TextBlock x:Name="TxtProcDetailsContent" FontFamily="Consolas" FontSize="11"
                                               Foreground="#222222" TextWrapping="Wrap"/>
                                    <Separator Margin="0,10" Background="#CCCCCC"/>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="Copy SQL"
                                                Click="BtnCopySql_Click" Height="22" Padding="8,0"
                                                Background="#2A2A4A" Foreground="White"
                                                BorderThickness="0" FontFamily="Segoe UI" FontSize="11"
                                                Cursor="Hand"/>
                                        <TextBlock Text="Input Buffer / Query Text:" FontWeight="Bold"
                                                   Foreground="#444444" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBox x:Name="TxtProcInfoBuffer" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" FontSize="11" Background="#FFFFFF"
                                             BorderBrush="#CCCCCC" BorderThickness="1" Padding="6"
                                             MinHeight="80" MaxHeight="240"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="TxtProcInfoBuffer_PreviewKeyDown"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
