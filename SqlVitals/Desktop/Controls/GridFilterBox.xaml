<UserControl x:Class="SqlVitals.Desktop.Controls.GridFilterBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="11" />
        <Grid Width="240" Height="28">
            <TextBox x:Name="TxtFilter" Padding="6,0,24,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource Border}" BorderThickness="1"
                     FontFamily="Segoe UI" FontSize="12"
                     TextChanged="TxtFilter_TextChanged" PreviewKeyDown="TxtFilter_PreviewKeyDown"
                     ToolTip="Show only rows containing every word typed here, in any column. Use &quot;double quotes&quot; for a phrase. Esc clears." />
            <TextBlock x:Name="TxtPlaceholder" Text="Filter rows…" IsHitTestVisible="False"
                       Margin="9,0,24,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="12" />
            <Button x:Name="BtnClear" Content="✕" Width="22" HorizontalAlignment="Right" Margin="0,1,1,1"
                    Visibility="Collapsed" Click="BtnClear_Click" Cursor="Hand" ToolTip="Clear filter (Esc)"
                    Background="Transparent" BorderThickness="0" Focusable="False"
                    Foreground="{DynamicResource TextMuted}" FontSize="11" />
        </Grid>
    </StackPanel>
</UserControl>
