<UserControl x:Class="SqlVitals.Desktop.Controls.QuickSwitcherOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False"
             FontFamily="Segoe UI" FontSize="13">
    <!-- Over the whole window, the page dimmed behind it (#144). Everything here follows a theme
         change, so every colour is a DynamicResource. -->
    <UserControl.Resources>
        <!-- A key, as in "↑ ↓ move" -->
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}" />
            <Setter Property="Background"      Value="{DynamicResource BgSidebar}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="4" />
            <Setter Property="Padding"         Value="5,0,5,1" />
            <Setter Property="Margin"          Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11.5" />
            <Setter Property="Foreground"        Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Backdrop" Background="#A805050C">
        <Border x:Name="Card" Width="620" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,88,16,24"
                CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                AutomationProperties.Name="Jump to a server, page or setting">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <!-- What to look for -->
                <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource Key}" Margin="10,0,0,0">
                            <TextBlock Text="Esc" Style="{StaticResource KeyText}" />
                        </Border>
                        <Grid>
                            <TextBlock x:Name="TxtPrompt" Text="Jump to a server, page or setting" FontSize="16" Margin="3,0,0,0"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="Query" FontSize="16" Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                     SelectionBrush="{DynamicResource Accent}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Search servers, pages and settings"
                                     TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- The keys, and how to keep the page on another server -->
                <Border DockPanel.Dock="Bottom" Padding="16,9" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Key}"><TextBlock Text="↑" Style="{StaticResource KeyText}" /></Border>
                            <Border Style="{StaticResource Key}"><TextBlock Text="↓" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Text="move" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Key}"><TextBlock Text="Enter" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Text="open" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtTip" Style="{StaticResource Hint}" Margin="0"
                                   Text="Type a server's name to switch servers and keep this page" />
                    </WrapPanel>
                </Border>

                <Grid>
                    <ScrollViewer x:Name="Scroll" MaxHeight="440" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Results" Margin="8" />
                    </ScrollViewer>
                    <TextBlock x:Name="TxtEmpty" Margin="18,16" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}" />
                    <!-- Read out as the selection moves: the results are drawn, not focused. -->
                    <TextBlock x:Name="TxtAnnounce" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
