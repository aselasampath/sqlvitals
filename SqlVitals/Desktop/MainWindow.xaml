<Window x:Class="SqlVitals.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SqlVitals" Height="820" Width="1320"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeep}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" MinWidth="190" MaxWidth="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ──────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <TextBlock Text="SqlVitals" Foreground="{DynamicResource Accent}"
                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="AppVersionText" Text="" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                    <Separator Background="{DynamicResource Border}" Margin="0,10,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="🖥  " Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtServerName" Text="—"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗄  " Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDatabaseName" Text="—"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Segoe UI" FontSize="10"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <StackPanel Margin="0,0,0,0">
                        <Button x:Name="BtnLiveMetrics"  Content="💓  Live Metrics"    Style="{DynamicResource NavButtonActive}" Click="Nav_Click" Tag="LiveMetrics" />
                        <Button x:Name="BtnTopWaits"     Content="📊  Top Waits"       Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="TopWaits" />
                        <Button x:Name="BtnActiveWaits"  Content="⚡  Active Waits"    Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="ActiveWaits" />
                        <Button x:Name="BtnWaitTrend"    Content="📈  Wait Trend"      Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="WaitTrend" />
                        <Button x:Name="BtnTempDb"       Content="🗄️  TempDB"          Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="TempDb" />
                        <Button x:Name="BtnMemory"       Content="🧠  Memory Grants"   Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Memory" />
                        <Button x:Name="BtnQueryStore"   Content="📋  Query Store"     Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="QueryStore" />
                        <Button x:Name="BtnIndexHealth"  Content="🔍  Index Health"    Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="IndexHealth" />
                        <Button x:Name="BtnResQueries"   Content="🔥  Resource Queries" Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="ResourceQueries" />
                        <Button x:Name="BtnImpConv"      Content="⚠️  Implicit Conv."   Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="ImplicitConv" />
                        <Button x:Name="BtnPlanHealth"   Content="🔎  Plan Cache Health" Style="{DynamicResource NavButton}"     Click="Nav_Click" Tag="PlanCacheHealth" />
                        <Button x:Name="BtnStaleStats"   Content="📉  Stale Stats"      Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="StaleStats" />
                        <Button x:Name="BtnDbStorage"    Content="🗄️  DB Storage"       Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="DbStorage" />
                        <Button x:Name="BtnAppConn"      Content="🔌  App Connections"  Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="AppConnections" />
                        <Button x:Name="BtnPerfmon"      Content="📈  Perfmon"          Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="Perfmon" />
                        <Separator Background="{DynamicResource NavSeparator}" Margin="12,6" />
                        <Button x:Name="BtnExport"       Content="📤  Export / AI"     Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Export" />
                        <Separator Background="{DynamicResource NavSeparator}" Margin="12,6" />
                        <Button x:Name="BtnSettings"     Content="⚙️  Settings"         Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Settings" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Refresh + status at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Button Content="↻  Refresh" Style="{DynamicResource RefreshButton}"
                            Click="BtnRefresh_Click" x:Name="BtnRefresh" />
                    <TextBlock x:Name="TxtStatus" Text="Ready"
                               Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="10"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <FrameworkElement /> <!-- spacer -->
            </DockPanel>
        </Border>

        <!-- ── Content area ─────────────────────────────────────────── -->
        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource BgDeep}" />
    </Grid>
</Window>
