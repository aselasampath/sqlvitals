<Window x:Class="SqlVitals.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
        Title="SqlVitals" Height="820" Width="1320"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeep}">
    <Window.Resources>
        <!-- A connection's health score in the selector (#36): plain text that opens its breakdown. -->
        <Style x:Key="ScoreButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="3,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" MinWidth="190" MaxWidth="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ──────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <TextBlock Text="SqlVitals" Foreground="{DynamicResource Accent}"
                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="AppVersionText" Text="" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                    <Separator Background="{DynamicResource Border}" Margin="0,10,0,8" />

                    <!-- Active connection selector -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" FontFamily="Segoe UI" FontSize="10">
                            <Hyperlink Click="ManageConnections_Click" Foreground="{DynamicResource AccentLight}"
                                       ToolTip="Add, edit or remove saved connections">Manage</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="ACTIVE CONNECTION" Foreground="{DynamicResource TextMuted}"
                                   FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ComboBox x:Name="CmbConnection"
                              FontFamily="Segoe UI" FontSize="11"
                              Background="{DynamicResource BgCard}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource Accent}"
                              ItemContainerStyle="{DynamicResource DarkComboItem}"
                              AutomationProperties.Name="Active connection"
                              SelectionChanged="CmbConnection_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1" ToolTip="{Binding ToolTipText}">
                                    <!-- Background monitoring health: green / amber / red; outline = not monitored or paused -->
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,4,6,0"
                                             VerticalAlignment="Top" StrokeThickness="1.5"
                                             Fill="{Binding HealthFill}" Stroke="{Binding HealthStroke}" />
                                    <!-- Health score 0–100; clicking it shows which checks lowered it -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ScoreButton}"
                                            VerticalAlignment="Top" Margin="4,0,0,0"
                                            Visibility="{Binding ScoreVisibility}" Opacity="{Binding ScoreOpacity}"
                                            Click="HealthScore_Click"
                                            AutomationProperties.Name="Health score">
                                        <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreBrush}"
                                                   FontWeight="Bold" FontSize="12" />
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10" Opacity="0.75" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Server, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DatabaseLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- A connection's health score breakdown, beside the sidebar -->
                    <Popup x:Name="ScorePopup" PlacementTarget="{Binding ElementName=CmbConnection}"
                           Placement="Right" HorizontalOffset="8" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           Closed="ScorePopup_Closed">
                        <controls:HealthScoreBreakdown x:Name="ScoreBreakdown" />
                    </Popup>
                    <TextBlock x:Name="TxtNoActiveConnection"
                               Foreground="{DynamicResource Warning}"
                               FontFamily="Segoe UI" FontSize="10" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- Nav -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <StackPanel Margin="0,0,0,0">
                        <Button x:Name="BtnLiveMetrics"  Content="💓  Live Metrics"    Style="{DynamicResource NavButtonActive}" Click="Nav_Click" Tag="LiveMetrics" />
                        <Button x:Name="BtnAlerts"       Content="🔔  Alerts"          Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Alerts"
                                ToolTip="Health thresholds breached, now and in the past, for every monitored connection" />
                        <Button x:Name="BtnTopWaits"     Content="📊  Top Waits"       Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="TopWaits" />
                        <Button x:Name="BtnActiveWaits"  Content="⚡  Active Waits"    Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="ActiveWaits" />
                        <Button x:Name="BtnProcesses"    Content="🔗  Processes"       Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Processes" />
                        <Button x:Name="BtnDeadlocks"    Content="💥  Deadlocks"       Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Deadlocks"
                                ToolTip="Recent deadlocks from the system_health session: victim, participants, objects and statements" />
                        <Button x:Name="BtnAgentJobs"    Content="🕒  Agent Jobs"      Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="AgentJobs"
                                ToolTip="SQL Agent jobs from msdb: last run, duration against the average, next run; failed and long-running jobs first" />
                        <Button x:Name="BtnBackups"      Content="💾  Backups"         Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Backups"
                                ToolTip="Each database's last full, differential and log backup from msdb, with a warning when one is older than your RPO" />
                        <Button x:Name="BtnFileIo"       Content="💽  File I/O"        Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="FileIo"
                                ToolTip="Read and write latency per database file, measured over the last few seconds; files slower than your threshold highlighted" />
                        <Button x:Name="BtnConfigChecks" Content="✅  Config Checks"   Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="ConfigChecks"
                                ToolTip="MAXDOP, cost threshold, max server memory, TempDB files, auto-shrink, page verify and compatibility level against best practice" />
                        <Button x:Name="BtnWaitTrend"    Content="📈  Wait Trend"      Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="WaitTrend" />
                        <Button x:Name="BtnTempDb"       Content="🗄️  TempDB"          Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="TempDb" />
                        <Button x:Name="BtnMemory"       Content="🧠  Memory Grants"   Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Memory" />
                        <Button x:Name="BtnQueryStore"   Content="📋  Query Store"     Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="QueryStore" />
                        <Button x:Name="BtnRegressions"  Content="🐢  Query Regressions" Style="{DynamicResource NavButton}"     Click="Nav_Click" Tag="QueryRegressions" />
                        <Button x:Name="BtnIndexHealth"  Content="🔍  Index Health"    Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="IndexHealth" />
                        <Button x:Name="BtnResQueries"   Content="🔥  Resource Queries" Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="ResourceQueries" />
                        <Button x:Name="BtnImpConv"      Content="⚠️  Implicit Conv."   Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="ImplicitConv" />
                        <Button x:Name="BtnPlanHealth"   Content="🔎  Plan Cache Health" Style="{DynamicResource NavButton}"     Click="Nav_Click" Tag="PlanCacheHealth" />
                        <Button x:Name="BtnStaleStats"   Content="📉  Stale Stats"      Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="StaleStats" />
                        <Button x:Name="BtnDbStorage"    Content="🗄️  DB Storage"       Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="DbStorage" />
                        <Button x:Name="BtnAppConn"      Content="🔌  App Connections"  Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="AppConnections" />
                        <Button x:Name="BtnPerfmon"      Content="📈  Perfmon"          Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="Perfmon" />
                        <Button x:Name="BtnSpTrace"      Content="🛰️  SP Trace"         Style="{DynamicResource NavButton}"      Click="Nav_Click" Tag="SpTrace" />
                        <Separator Background="{DynamicResource NavSeparator}" Margin="12,6" />
                        <Button x:Name="BtnExport"       Content="📤  Export / AI"     Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Export" />
                        <Separator Background="{DynamicResource NavSeparator}" Margin="12,6" />
                        <Button x:Name="BtnSettings"     Content="⚙️  Settings"         Style="{DynamicResource NavButton}"       Click="Nav_Click" Tag="Settings" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Refresh + status at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Button Content="↻  Refresh" Style="{DynamicResource RefreshButton}"
                            Click="BtnRefresh_Click" x:Name="BtnRefresh" />
                    <TextBlock x:Name="TxtStatus" Text="Ready"
                               Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="10"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <FrameworkElement /> <!-- spacer -->
            </DockPanel>
        </Border>

        <!-- ── Content area ─────────────────────────────────────────── -->
        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource BgDeep}" />
    </Grid>
</Window>
