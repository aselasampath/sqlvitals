<Window x:Class="SqlVitals.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
        Title="SqlVitals" Height="820" Width="1320"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeep}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <!-- The open server's health score in the sidebar (#36, #141): plain text that opens its breakdown.
             Reachable with Tab, outlined in the accent while focused. -->
        <Style x:Key="ScoreButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="3,0"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33808080" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Start / stop monitoring the open server from the sidebar's server header (#115, #141). -->
        <Style x:Key="MonitorToggleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="4,1"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33808080" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" MinWidth="190" MaxWidth="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ──────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,4">
                    <TextBlock Text="SqlVitals" Foreground="{DynamicResource Accent}"
                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="AppVersionText" Text="" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Settings, at the foot -->
                <StackPanel x:Name="NavFooter" DockPanel.Dock="Bottom" Margin="0,4,0,10" />

                <!-- The global pages, then the open server's (#141): built by NavSidebar from Services/NavMenu.cs -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <StackPanel x:Name="NavPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- An open server's health score breakdown (#36), beside the sidebar's server header -->
        <Popup x:Name="ScorePopup" Placement="Right" HorizontalOffset="8" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="ScorePopup_Closed">
            <controls:HealthScoreBreakdown x:Name="ScoreBreakdown" />
        </Popup>

        <!-- ── Content area ─────────────────────────────────────────── -->
        <DockPanel Grid.Column="1">
            <!-- One bar (#140): Back and Forward (#139), where you are, and the page's server,
                 database, freshness and time window, with Pause or Refresh. -->
            <controls:TopBar x:Name="Bar" DockPanel.Dock="Top" />
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Background="{DynamicResource BgDeep}" />
        </DockPanel>
    </Grid>
</Window>
