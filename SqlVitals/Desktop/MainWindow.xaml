<Window x:Class="SqlVitals.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlVitals.Desktop.Controls"
        Title="SqlVitals" Height="820" Width="1320"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeep}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <!-- The sidebar, pinned, collapsed or hidden (#142), built in WorkspaceShell from Services/NavMenu.cs;
         the page is in its second column. -->
    <controls:WorkspaceShell x:Name="Shell">
        <!-- An open server's health score breakdown (#36), beside the sidebar's server header -->
        <Popup x:Name="ScorePopup" Placement="Right" HorizontalOffset="8" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="ScorePopup_Closed">
            <controls:HealthScoreBreakdown x:Name="ScoreBreakdown" />
        </Popup>

        <!-- ── Content area ─────────────────────────────────────────── -->
        <DockPanel Grid.Column="1">
            <!-- One bar (#140): Back and Forward (#139), where you are, and the page's server,
                 database, freshness and time window, with Pause or Refresh. -->
            <controls:TopBar x:Name="Bar" DockPanel.Dock="Top" />
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Background="{DynamicResource BgDeep}" />
        </DockPanel>
    </controls:WorkspaceShell>
</Window>
