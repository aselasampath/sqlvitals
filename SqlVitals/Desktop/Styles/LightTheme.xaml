<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:SqlVitals.Desktop.Helpers"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ── Colours ─────────────────────────────────────────────────── -->
    <Color x:Key="BgDeepColor">#FFF0F2F5</Color>
    <Color x:Key="BgCardColor">#FFFFFFFF</Color>
    <Color x:Key="BgSidebarColor">#FFE8ECF0</Color>
    <Color x:Key="AccentColor">#FF7C3AED</Color>
    <Color x:Key="AccentLightColor">#FF9F67F5</Color>
    <Color x:Key="TextPrimaryColor">#FF1E293B</Color>
    <Color x:Key="TextMutedColor">#FF64748B</Color>
    <!-- Lighter than TextMuted (the enabled nav text), still 3.1:1 on the sidebar -->
    <Color x:Key="TextDisabledColor">#FF7A8594</Color>
    <Color x:Key="BorderColor">#FFD1D9E0</Color>
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="WarningColor">#FFFBBF24</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>

    <SolidColorBrush x:Key="BgDeep"        Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgCard"        Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgSidebar"     Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="Accent"        Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLight"   Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMuted"     Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabled"  Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="Border"     Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Success"       Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning"       Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Danger"        Color="{StaticResource DangerColor}" />

    <!-- ── Colours by meaning (#164) ──────────────────────────────────
         Code picks these by key (SetResourceReference, ThemeResources, ChartTheme); no hex in .cs files. -->
    <!-- Information: a neutral fact, neither good nor bad. -->
    <Color x:Key="InfoColor">#FF2563EB</Color>
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
    <!-- Health: the dot, the score, a Home tile. The same in both themes, so a colour always means the same level. -->
    <Color x:Key="HealthGoodColor">#FF22C55E</Color>
    <Color x:Key="HealthWarningColor">#FFFBBF24</Color>
    <Color x:Key="HealthCriticalColor">#FFEF4444</Color>
    <Color x:Key="HealthNoneColor">#FF94A3B8</Color>
    <SolidColorBrush x:Key="HealthGood"     Color="{StaticResource HealthGoodColor}" />
    <SolidColorBrush x:Key="HealthWarning"  Color="{StaticResource HealthWarningColor}" />
    <SolidColorBrush x:Key="HealthCritical" Color="{StaticResource HealthCriticalColor}" />
    <SolidColorBrush x:Key="HealthNone"     Color="{StaticResource HealthNoneColor}" />
    <!-- A pale wash of a health colour, behind its label. -->
    <SolidColorBrush x:Key="HealthGoodTint"     Color="#3322C55E" />
    <SolidColorBrush x:Key="HealthWarningTint"  Color="#40FBBF24" />
    <SolidColorBrush x:Key="HealthCriticalTint" Color="#33EF4444" />
    <SolidColorBrush x:Key="HealthNoneTint"     Color="#3394A3B8" />
    <!-- Process states: the blocking map's balls and the Processes grid's dots. -->
    <Color x:Key="ProcessHeadBlockerColor">#FFFF8000</Color>
    <Color x:Key="ProcessBlockedColor">#FF6060FF</Color>
    <Color x:Key="ProcessActiveColor">#FFFF4040</Color>
    <Color x:Key="ProcessSleepingColor">#FF4488FF</Color>
    <SolidColorBrush x:Key="ProcessHeadBlocker" Color="{StaticResource ProcessHeadBlockerColor}" />
    <SolidColorBrush x:Key="ProcessBlocked"     Color="{StaticResource ProcessBlockedColor}" />
    <SolidColorBrush x:Key="ProcessActive"      Color="{StaticResource ProcessActiveColor}" />
    <SolidColorBrush x:Key="ProcessSleeping"    Color="{StaticResource ProcessSleepingColor}" />
    <!-- Wait categories and server metrics: the same colour on every chart (Overview, Live charts). -->
    <Color x:Key="WaitCpuColor">#FFEF4444</Color>
    <Color x:Key="WaitIoColor">#FFF59E0B</Color>
    <Color x:Key="WaitLockColor">#FFEC4899</Color>
    <Color x:Key="WaitMemoryColor">#FF8B5CF6</Color>
    <Color x:Key="WaitNetworkColor">#FF06B6D4</Color>
    <Color x:Key="WaitOtherColor">#FF26E7A6</Color>
    <Color x:Key="MetricBatchesColor">#FF10B981</Color>
    <Color x:Key="MetricTransactionsColor">#FFF59E0B</Color>
    <Color x:Key="MetricCompilationsColor">#FFFF6B6B</Color>
    <Color x:Key="MetricRecompilationsColor">#FF7B68EE</Color>
    <Color x:Key="MetricReadsColor">#FF10B981</Color>
    <Color x:Key="MetricWritesColor">#FFEF4444</Color>
    <Color x:Key="MetricPleColor">#FF8B5CF6</Color>
    <SolidColorBrush x:Key="WaitCpu"              Color="{StaticResource WaitCpuColor}" />
    <SolidColorBrush x:Key="WaitIo"               Color="{StaticResource WaitIoColor}" />
    <SolidColorBrush x:Key="WaitLock"             Color="{StaticResource WaitLockColor}" />
    <SolidColorBrush x:Key="WaitMemory"           Color="{StaticResource WaitMemoryColor}" />
    <SolidColorBrush x:Key="WaitNetwork"          Color="{StaticResource WaitNetworkColor}" />
    <SolidColorBrush x:Key="WaitOther"            Color="{StaticResource WaitOtherColor}" />
    <SolidColorBrush x:Key="MetricBatches"        Color="{StaticResource MetricBatchesColor}" />
    <SolidColorBrush x:Key="MetricTransactions"   Color="{StaticResource MetricTransactionsColor}" />
    <SolidColorBrush x:Key="MetricCompilations"   Color="{StaticResource MetricCompilationsColor}" />
    <SolidColorBrush x:Key="MetricRecompilations" Color="{StaticResource MetricRecompilationsColor}" />
    <SolidColorBrush x:Key="MetricReads"          Color="{StaticResource MetricReadsColor}" />
    <SolidColorBrush x:Key="MetricWrites"         Color="{StaticResource MetricWritesColor}" />
    <SolidColorBrush x:Key="MetricPle"            Color="{StaticResource MetricPleColor}" />
    <!-- A connection's role in Settings → Connections: the one open now, or monitored in the background. -->
    <SolidColorBrush x:Key="ConnectionActiveTint"     Color="#337C3AED" />
    <SolidColorBrush x:Key="ConnectionBackgroundTint" Color="#333B82F6" />
    <!-- Chart lines with no meaning of their own (counters, wait types, plans): ChartTheme.Series(i) takes them in order.
         The dark theme's hues, darker, so they read on a white card. -->
    <Color x:Key="ChartSeries0Color">#FF059669</Color>
    <Color x:Key="ChartSeries1Color">#FFE11D48</Color>
    <Color x:Key="ChartSeries2Color">#FF7C3AED</Color>
    <Color x:Key="ChartSeries3Color">#FFEA580C</Color>
    <Color x:Key="ChartSeries4Color">#FF0891B2</Color>
    <Color x:Key="ChartSeries5Color">#FFDB2777</Color>
    <Color x:Key="ChartSeries6Color">#FFD97706</Color>
    <Color x:Key="ChartSeries7Color">#FF9333EA</Color>
    <Color x:Key="ChartSeries8Color">#FF0D9488</Color>
    <Color x:Key="ChartSeries9Color">#FF2563EB</Color>
    <Color x:Key="ChartSeries10Color">#FF65A30D</Color>
    <Color x:Key="ChartSeries11Color">#FFDC2626</Color>

    <!-- The top bar's Live / Snapshot / History badge, and a snapshot's age once it is old (#140). -->
    <SolidColorBrush x:Key="LiveBadgeText" Color="#FF15803D" />
    <SolidColorBrush x:Key="LiveBadgeFill" Color="#1A22C55E" />
    <SolidColorBrush x:Key="LiveBadgeBorder" Color="#8022C55E" />
    <SolidColorBrush x:Key="SnapshotBadgeText" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="SnapshotBadgeFill" Color="#1A3B82F6" />
    <SolidColorBrush x:Key="SnapshotBadgeBorder" Color="#803B82F6" />
    <SolidColorBrush x:Key="HistoryBadgeText" Color="#FFB45309" />
    <SolidColorBrush x:Key="HistoryBadgeFill" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="HistoryBadgeBorder" Color="#80F59E0B" />
    <SolidColorBrush x:Key="StaleText" Color="#FFB45309" />
    <SolidColorBrush x:Key="Transparent"   Color="Transparent" />
    <SolidColorBrush x:Key="NavSeparator"  Color="#33000000" />

    <!-- ── Nav button ──────────────────────────────────────────────── -->
    <!-- A page in the sidebar (#141): its icon and name (see NavSidebar), and a count where it has one.
         A group's pages are indented by their own Padding, so it survives the switch to NavButtonActive. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="Foreground"   Value="{StaticResource TextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily"   Value="Segoe UI" />
        <Setter Property="FontSize"     Value="13" />
        <Setter Property="Height"       Value="36" />
        <Setter Property="Cursor"       Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding"      Value="12,0,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="Transparent" CornerRadius="6" Margin="6,1">
                        <DockPanel>
                            <!-- Shown only while disabled, so that state doesn't rely on colour alone -->
                            <Border x:Name="NotAvailable" DockPanel.Dock="Right" Visibility="Collapsed"
                                    VerticalAlignment="Center" Margin="0,0,10,0" Padding="4,0,4,1"
                                    CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{StaticResource TextDisabled}">
                                <TextBlock Text="N/A" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDisabled}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#18000000" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <!-- A page this server doesn't have (see PagesAzureSqlLacks). After IsMouseOver so it wins. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="NotAvailable" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Background"  Value="#337C3AED" />
        <Setter Property="Foreground"  Value="{StaticResource Accent}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <!-- ── Collapsed sidebar (#142) ─────────────────────────────────── -->
    <!-- An icon in the 56 px rail: a global page, a group (its pages in a fly-out), Settings, or the
         pin. Its name is its tooltip and its spoken name (see NavRail). -->
    <Style x:Key="NavRailButton" TargetType="Button">
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="Foreground"   Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"   Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize"     Value="16" />
        <Setter Property="Width"        Value="40" />
        <Setter Property="Height"       Value="40" />
        <Setter Property="Margin"       Value="0,1" />
        <Setter Property="Cursor"       Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#18000000" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page on screen, or the group holding it -->
    <Style x:Key="NavRailButtonActive" TargetType="Button" BasedOn="{StaticResource NavRailButton}">
        <Setter Property="Background"  Value="#337C3AED" />
        <Setter Property="Foreground"  Value="{StaticResource Accent}" />
    </Style>

    <!-- ── Sidebar group (#124, #141) ──────────────────────────────── -->
    <!-- A group of the open server's pages: its icon, name and a chevron, like a page's row. One is
         open at a time. The expander takes the keyboard focus (NavSidebar toggles it on Enter or
         Space), so a screen reader announces it as expandable, with its state. -->
    <Style x:Key="NavGroupExpander" TargetType="Expander">
        <Setter Property="Foreground"  Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"  Value="Segoe UI" />
        <Setter Property="Focusable"   Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <!-- The tooltip is on the header only: on the expander it would show over its pages too -->
                        <ToggleButton x:Name="HeaderToggle" Focusable="False" Cursor="Hand" BorderBrush="Transparent"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ToolTip="{TemplateBinding AutomationProperties.HelpText}"
                                      AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Margin="6,1" Padding="12,0,10,0" Height="36">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#18000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel>
                                <!-- Chevron down open, right closed: the state doesn't rely on colour alone -->
                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontSize="9" FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center" />
                                <!-- A closed group holding the page on screen -->
                                <TextBlock x:Name="CurrentMark" DockPanel.Dock="Right" Text="●" FontSize="8"
                                           Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="HeaderIcon" Text="{TemplateBinding helpers:NavGroupState.Icon}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="20" Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False" />
                                <Condition Property="helpers:NavGroupState.HoldsCurrentPage" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            <Setter TargetName="CurrentMark" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="HeaderToggle" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── KPI card ────────────────────────────────────────────────── -->
    <Style x:Key="KpiCard" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BgCard}" />
        <Setter Property="BorderBrush"      Value="{StaticResource Border}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="CornerRadius"     Value="10" />
        <Setter Property="Padding"          Value="18,14" />
    </Style>

    <!-- ── Section heading ─────────────────────────────────────────── -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"  Value="Segoe UI" />
        <Setter Property="FontSize"    Value="15" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Margin"      Value="0,0,0,10" />
    </Style>

    <!-- ── Value label ─────────────────────────────────────────────── -->
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"  Value="Segoe UI" />
        <Setter Property="FontSize"    Value="26" />
        <Setter Property="FontWeight"  Value="Bold" />
    </Style>

    <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"  Value="Segoe UI" />
        <Setter Property="FontSize"    Value="11" />
        <Setter Property="Margin"      Value="0,2,0,0" />
    </Style>

    <!-- ── Refresh button ─────────────────────────────────────────── -->
    <Style x:Key="RefreshButton" TargetType="Button">
        <Setter Property="Background"       Value="#FFEDE9FE" />
        <Setter Property="Foreground"       Value="#FF6D28D9" />
        <Setter Property="BorderBrush"      Value="#FFDDD6FE" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="FontFamily"       Value="Segoe UI" />
        <Setter Property="FontSize"         Value="12" />
        <Setter Property="FontWeight"       Value="SemiBold" />
        <Setter Property="Padding"          Value="16,7" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFDDD6FE" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC4B5FD" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Secondary button ───────────────────────────────────────── -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background"       Value="{StaticResource BgCard}" />
        <Setter Property="Foreground"       Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush"      Value="{StaticResource Border}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="FontFamily"       Value="Segoe UI" />
        <Setter Property="FontSize"         Value="12" />
        <Setter Property="Padding"          Value="16,7" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgDeep}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC4B5FD" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Back / Forward (#139) ──────────────────────────────────── -->
    <Style x:Key="NavArrowButton" TargetType="Button">
        <Setter Property="Width"            Value="30" />
        <Setter Property="Height"           Value="30" />
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="Foreground"       Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush"      Value="{StaticResource Border}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="FontFamily"       Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize"         Value="12" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCard}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── DataGrid ────────────────────────────────────────────────── -->
    <!-- Grid density (#148): the comfortable spacing; the application's own resources override these
         for Compact (Services/GridDensity.cs), so every grid changes at once, in either theme. -->
    <Thickness x:Key="GridCellPadding">8,5</Thickness>
    <Thickness x:Key="GridHeaderPadding">8,6</Thickness>
    <sys:Double x:Key="GridFontSize">12</sys:Double>

    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource BgCard}" />
        <Setter Property="Foreground"               Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="GridLinesVisibility"      Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}" />
        <Setter Property="RowBackground"            Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#07000000" />
        <Setter Property="FontFamily"               Value="Segoe UI" />
        <Setter Property="FontSize"                 Value="{DynamicResource GridFontSize}" />
        <Setter Property="AutoGenerateColumns"      Value="False" />
        <Setter Property="IsReadOnly"               Value="True" />
        <Setter Property="SelectionMode"            Value="Single" />
        <Setter Property="CanUserResizeRows"        Value="False" />
        <Setter Property="HeadersVisibility"        Value="Column" />
        <!-- Right-click Copy / Copy with headers / Export to CSV on every grid -->
        <Setter Property="helpers:DataGridExport.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="#15000000" />
        <Setter Property="Foreground"      Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"      Value="Segoe UI" />
        <Setter Property="FontSize"        Value="11" />
        <Setter Property="FontWeight"      Value="SemiBold" />
        <Setter Property="Padding"         Value="{DynamicResource GridHeaderPadding}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0D000000" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#337C3AED" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="{DynamicResource GridCellPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ScrollBar ───────────────────────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width"      Value="6" />
    </Style>

    <!-- ── ComboBox item ─────────────────────────────────────────── -->
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background"  Value="#FFFFFFFF"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Padding"     Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#337C3AED"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#447C3AED"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
