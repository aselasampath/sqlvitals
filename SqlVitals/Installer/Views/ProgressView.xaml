<UserControl x:Class="SqlVitals.Installer.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" Text="Installing SqlVitals" />
        <TextBlock x:Name="Status" Style="{StaticResource Muted}" Margin="0,8,0,14" />

        <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="1" BorderThickness="0"
                     Foreground="{StaticResource Accent}" Background="{StaticResource Border}"
                     AutomationProperties.Name="Installation progress" />
        <TextBlock x:Name="Percent" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,18" />

        <Border Style="{StaticResource Card}">
            <StackPanel x:Name="StepList" />
        </Border>

        <!-- Shown when a step fails: what happened, how to fix it, Retry or Cancel -->
        <Border x:Name="ErrorPanel" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                <TextBlock x:Name="ErrorMessage" Margin="0,6,0,0" />
                <TextBlock Margin="0,10,0,0">
                    <Run Text="How to fix it: " FontWeight="SemiBold" /><Run x:Name="ErrorResolution" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnRetry" Content="Retry" Style="{StaticResource PrimaryButton}" Click="Retry_Click" />
                    <Button x:Name="BtnGiveUp" Content="Cancel and undo changes" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="GiveUp_Click" />
                    <Button Content="Open setup log" Style="{StaticResource LinkButton}" Margin="16,0,0,0"
                            VerticalAlignment="Center" Click="OpenLog_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
