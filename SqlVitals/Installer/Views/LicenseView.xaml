<UserControl x:Class="SqlVitals.Installer.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="License" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,22"
                   Text="SqlVitals is free, open-source software released under the MIT License." />

        <Border Background="{StaticResource SuccessSoft}" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
            <TextBlock Text="In short: you can use SqlVitals for free, at home or at work, and copy, change or share it. The software comes without any warranty." />
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="LicenseText" Height="260" IsReadOnly="True" BorderThickness="0" Padding="14,12"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Background="Transparent"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
        </Border>

        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"
                   Text="Choose I agree to continue. A copy of the license is also available in the project's source repository." />
    </StackPanel>
</UserControl>
