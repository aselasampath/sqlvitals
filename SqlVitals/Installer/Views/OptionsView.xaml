<UserControl x:Class="SqlVitals.Installer.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Choose install options" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,22"
                   Text="The defaults suit most people — change them only if you need to." />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Install location" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirBox" Grid.Column="0" TextChanged="DirBox_TextChanged"
                             AutomationProperties.Name="Install location" />
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
                </Grid>
                <TextBlock x:Name="DirHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                <TextBlock x:Name="SpaceText" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                <Button x:Name="BtnDefault" Content="Use the default location" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="Default_Click" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Shortcuts" />
                <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                           Text="A Start menu shortcut is always created." />
            </StackPanel>
        </Border>

        <Border x:Name="ErrorPanel" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontWeight="SemiBold" />
                <Button x:Name="BtnElevate" Content="Restart as administrator" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" Click="Elevate_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
