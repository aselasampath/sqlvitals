<UserControl x:Class="SqlVitals.Installer.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" Text="Ready to install" />
        <TextBlock x:Name="Intro" Style="{StaticResource Muted}" Margin="0,8,0,22" />

        <Border Style="{StaticResource Card}">
            <Grid x:Name="Summary">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <Border Background="{StaticResource SuccessSoft}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Your data is safe" FontWeight="SemiBold" />
                <TextBlock x:Name="DataNote" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
