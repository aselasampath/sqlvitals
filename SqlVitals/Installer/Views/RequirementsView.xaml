<UserControl x:Class="SqlVitals.Installer.Views.RequirementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Checking your system" />
        <TextBlock x:Name="Summary" Style="{StaticResource Muted}" Margin="0,8,0,18"
                   Text="Making sure this PC is ready for SqlVitals…" />

        <ItemsControl x:Name="Results" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" Margin="0,1,0,0"
                                    Background="{Binding IconBrush}">
                                <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                <Border Visibility="{Binding ResolutionVisibility}" Background="{Binding ResolutionBackground}"
                                        CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="How to fix: " FontWeight="SemiBold" /><Run Text="{Binding Resolution, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnCheckAgain" Content="Check again" Style="{StaticResource SecondaryButton}" Click="CheckAgain_Click" />
            <Button x:Name="BtnElevate" Content="Restart as administrator" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Visibility="Collapsed" Click="Elevate_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
