<Window x:Class="SqlVitals.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SqlVitals Setup"
        Width="860" Height="640" MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: product name and where the user is in the process -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}">
            <DockPanel Margin="22,26,18,20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SqlVitals" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="SidebarSubtitle" Text="Setup" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock x:Name="SidebarFooter" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" />
                <StackPanel x:Name="StepList" Margin="0,36,0,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl x:Name="PageHost" Margin="36,30,36,20" Focusable="False" />
            </ScrollViewer>

            <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0" Padding="24,12">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnCancel" DockPanel.Dock="Left" Content="Cancel"
                            Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True" />
                    <Button x:Name="BtnNext" DockPanel.Dock="Right" Content="Next" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="Next_Click" IsDefault="True" />
                    <Button x:Name="BtnBack" DockPanel.Dock="Right" Content="Back"
                            Style="{StaticResource SecondaryButton}" Click="Back_Click" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
