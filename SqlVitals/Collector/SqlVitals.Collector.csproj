<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headless collector (#172): the Engine's monitoring as a Windows service or a console app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SqlVitals.Collector</AssemblyName>
    <RootNamespace>SqlVitals.Collector</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The app's release number: SqlVitals.Desktop.csproj stays its single source. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Desktop\SqlVitals.Desktop.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <AssemblyTitle>SqlVitals Collector</AssemblyTitle>
    <Product>SqlVitals</Product>
    <ApplicationIcon>..\Branding\SqlVitals.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlVitals.Collector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\SqlVitals.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs as a Windows service when Windows starts it, as a console app otherwise; logs to the Event Log as a service. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

</Project>
