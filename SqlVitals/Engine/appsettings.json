{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "QuerySettings": {
    "CommandTimeoutSeconds": 30,
    "UseNoLock": true
  },
  "TraceSettings": {
    "SessionName": "SqlVitals_SpTrace",
    "MinDurationMs": 0,
    "MaxRingBufferKb": 4096,
    "MaxEventsLimit": 1000,
    "PollIntervalSeconds": 2,
    "MaxRowsRetained": 5000
  }
}
